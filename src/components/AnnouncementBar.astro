---
/* Top announcement bar.
 *
 * v2: ink, in flow. v1 pinned it with `position: fixed` and measured its
 * height into a custom property so the fixed header could offset from it —
 * a loop that once ratcheted itself 99px tall. In flow, above a sticky
 * header, it simply takes the space it needs and scrolls away; there is
 * nothing left to measure.
 *
 * Ink because the hero under it is mint: two mint bands would read as one.
 * One line, and the line is the link: "Nowa wersja już dostępna" →
 * /pobieranie/ (October 2026; it replaced v4's badge, button and changelog
 * link). The X closes it.
 *
 * The dismissal is scoped to the announcement, not to the bar: `campaign`
 * becomes the cookie key `gi_bar_hidden_<campaign>`, so a new announcement is
 * a new cookie and always shows — including to everyone who closed the v4
 * one — and closing this one means closed for a year. */
const campaign = 'new-version-2610';

import Icon from './ui/Icon.astro';
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';
const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const downloadHref = await linkUrl('pobieranie', lang);
---

{/* A named <aside>: content outside header/main/footer still belongs to a
    landmark, so a screen reader's landmark list reaches it. */}
<aside id="gi-announce-bar" class="announce surface-ink" data-campaign={campaign} aria-label={s('bar.aria')}>
  <div class="container announce-in">
    <a class="announce-link" href={downloadHref}>
      <span>{s('bar.msg')}</span>
      <Icon name="arrow-right" size={16} class="announce-arrow" />
    </a>
    <button id="gi-bar-close" type="button" class="announce-close" aria-label={s('bar.close')}>
      <Icon name="x" size={16} />
    </button>
  </div>
</aside>

<script is:inline>
  /* Before paint, so a dismissed bar never flashes in and out. */
  (function () {
    var bar = document.getElementById('gi-announce-bar');
    if (bar && document.cookie.indexOf('gi_bar_hidden_' + bar.dataset.campaign + '=1') !== -1) {
      bar.hidden = true;
    }
  })();
</script>

<style>
  .announce {
    position: relative;
    z-index: calc(var(--z-header) + 1);
  }
  .announce-in {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    min-height: 48px;
    padding-block: 6px;
    padding-right: calc(var(--gutter) + 40px);
    padding-left: calc(var(--gutter) + 40px);
  }
  /* The whole line is the link: mint on ink, the system's accent, with the
     arrow nudging on hover. 44px tall so it is a full-size target. */
  .announce-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font: 600 14px / 1.3 var(--font-sans);
    color: var(--mint-500);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--dur-fast) ease;
  }
  .announce-link:hover {
    text-decoration-color: currentColor;
  }
  .announce-link :global(.announce-arrow) {
    flex: none;
    transition: transform var(--dur-fast) ease;
  }
  .announce-link:hover :global(.announce-arrow) {
    transform: translateX(3px);
  }
  .announce-close {
    position: absolute;
    right: calc(var(--gutter) - 10px);
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--on-ink);
    transition: background-color var(--dur-fast) ease;
  }
  .announce-close:hover {
    background: var(--ink-700);
  }

  @media (max-width: 599.98px) {
    .announce-in {
      justify-content: flex-start;
      padding-left: var(--gutter);
      padding-block: 10px;
    }
    .announce-link {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announce-close,
    .announce-link,
    .announce-link :global(.announce-arrow) {
      transition: none;
    }
  }
</style>
