---
/* Top announcement bar (was snippet 16). Close button + cookie handled in main.js. */
---
<!-- ANNOUNCEMENT BAR -->
<div id="gi-announce-bar" style="background:rgb(1,236,144);padding:0.6rem 1rem;text-align:center;position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;align-items:center;justify-content:center;gap:0.75rem;flex-wrap:wrap;height:44px;box-sizing:border-box;">
  <span style="color:#fff;font-size:0.95rem;font-weight:600;letter-spacing:0.01em;">gravity.integration v4 już dostępna</span>
  <a href="/pobieranie" style="background:#fff;color:rgb(1,236,144);font-size:0.8rem;font-weight:700;padding:0 1.1rem;border-radius:2rem;text-decoration:none;letter-spacing:0.02em;transition:opacity 0.2s;display:inline-flex;align-items:center;height:28px;line-height:1;box-sizing:border-box;border:2px solid #fff;">Pobierz teraz</a>
  <a href="https://docs.gravity-integration.com/informacje-podstawowe/changelog" target="_blank" rel="noopener" style="background:transparent;color:#fff;font-size:0.8rem;font-weight:700;padding:0 1.1rem;border-radius:2rem;text-decoration:none;letter-spacing:0.02em;border:2px solid #fff;transition:opacity 0.2s;display:inline-flex;align-items:center;height:28px;line-height:1;box-sizing:border-box;">Sprawdź zmiany</a>
  <button id="gi-bar-close" style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);background:none;border:none;color:#fff;font-size:1.3rem;cursor:pointer;line-height:1;padding:0.2rem 0.4rem;opacity:0.8;" aria-label="Zamknij">&times;</button>
</div>


<!-- END ANNOUNCEMENT BAR -->
