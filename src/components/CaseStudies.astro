---
/* Dedicated layout for /case-studies/.
   Copy is VERBATIM from the case-studies page JSON — parsed, never rewritten
   (src/lib/case-studies.ts says exactly what the parser does and what it
   drops: the "•" glyphs and <br /> separators that stood in for markup).

   v2: each study is a dossier on white — the client's logo on a plate, the
   client in mono, the title as an H2 — then a fact sheet in a recessed mist
   card that stays beside the story while it scrolls, the story at a reading
   measure, and the payoff ("Rezultaty") as an ink panel with the wins
   marked in mint ticks. No mass in it: four studies would put four
   identical masses on one page, and the system allows one per frame. */
import type { CsStudy } from '../lib/case-studies';
import { localeOf, t } from '../i18n/ui';
import CaseFigure from './CaseFigure.astro';

interface Props {
  studies: CsStudy[];
}
const { studies } = Astro.props;

/* The outcome stage is the one a prospect scrolls for; it gets the ink
   panel. Matched by heading, localised: 'Rezultaty' / 'Results'. */
const PAYOFF = t(localeOf(Astro.currentLocale))('cs.payoff');

/* Keep short hyphenated compounds ("e-commerce") on one line: markup, not
   words. Long ones are left alone — a nowrap run wider than the column would
   trade a bad break for an overflow. */
const keepCompounds = (html: string) =>
  html.replace(/(^|>)([^<]+)/g, (_m, lead: string, text: string) =>
    lead +
      text.replace(/\p{L}+-\p{L}+/gu, (w) => (w.length <= 16 ? `<span class="cs-nb">${w}</span>` : w)),
  );
---

<div class="cs">
  {
    studies.map((study, n) => {
      const narrative = study.stages.filter((s) => s.heading !== PAYOFF);
      const payoff = study.stages.find((s) => s.heading === PAYOFF) ?? null;
      return (
        <article id={study.anchor} class="cs-study">
          <div class="container cs-head" data-reveal>
            {study.logo && (
              <div class="cs-plate">
                <img
                  src={study.logo.src}
                  alt={study.logo.alt}
                  width={study.logo.width}
                  height={study.logo.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <h2 class="cs-h">
              <span class="cs-client">
                <span class="label-num">{String(n + 1).padStart(2, '0')}</span>
                {study.client}
              </span>
              <span class="cs-title" set:html={keepCompounds(study.title)} />
            </h2>
          </div>

          <div class="container cs-grid">
            {study.facts.length > 0 && (
              <aside class="cs-rail">
                <dl class="cs-facts">
                  {study.facts.map((f) => (
                    <div class="cs-fact">
                      <dt set:html={f.label} />
                      <dd set:html={f.value} />
                    </div>
                  ))}
                </dl>
              </aside>
            )}

            <div class="cs-narrative">
              {narrative.map((stage) => (
                <section class="cs-stage">
                  {stage.heading && <h3 set:html={stage.heading} />}
                  {stage.blocks.map((b) =>
                    b.kind === 'p' ? (
                      <p set:html={b.html} />
                    ) : b.kind === 'ul' ? (
                      <ul class="cs-list">
                        {b.items.map((it) => (
                          <li set:html={it} />
                        ))}
                      </ul>
                    ) : (
                      <CaseFigure img={b.img} />
                    ),
                  )}
                </section>
              ))}
            </div>
          </div>

          {payoff && (
            <div class="container">
              <section class="cs-payoff surface-ink" data-reveal>
                <h3 class="cs-payoff-h" set:html={payoff.heading} />
                <div class="cs-payoff-body">
                  {payoff.blocks.map((b) =>
                    b.kind === 'p' ? (
                      <p set:html={b.html} />
                    ) : b.kind === 'ul' ? (
                      <ul class="cs-wins">
                        {b.items.map((it) => (
                          <li>
                            <svg viewBox="0 0 20 20" aria-hidden="true" class="cs-check">
                              <path d="M5 10.5l3.2 3.2L15 6.5" />
                            </svg>
                            <span set:html={it} />
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <CaseFigure img={b.img} />
                    ),
                  )}
                </div>
              </section>
            </div>
          )}
        </article>
      );
    })
  }
</div>

<style>
  .cs-study {
    padding-block: clamp(64px, 9vw, 112px);
    scroll-margin-top: var(--header-h);
  }
  .cs-study + .cs-study {
    border-top: 1px solid var(--mist-200);
  }

  /* ---- head ---- */
  .cs-head {
    display: grid;
    gap: 28px;
    justify-items: start;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .cs-plate {
    display: grid;
    place-items: center;
    width: 176px;
    height: 88px;
    padding: 14px 20px;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .cs-plate img {
    width: auto;
    max-width: 100%;
    max-height: 56px;
    object-fit: contain;
  }
  .cs-h {
    display: grid;
    gap: 14px;
    max-width: 880px;
  }
  .cs-client {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font: 500 12px / 1.2 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--mint-800);
  }
  .cs-client .label-num {
    color: var(--muted);
  }
  .cs-title {
    font: 800 var(--fs-h2) / 1 var(--font-sans);
    letter-spacing: -0.05em;
    color: var(--ink-900);
    text-wrap: balance;
  }
  .cs-title :global(.cs-nb),
  .cs-narrative :global(.cs-nb) {
    white-space: nowrap;
  }

  /* ---- body ---- */
  .cs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  @media (min-width: 960px) {
    .cs-grid {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }
    .cs-rail {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .cs-facts {
    display: grid;
    gap: 16px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--mist-100);
  }
  .cs-fact {
    display: grid;
    gap: 4px;
  }
  .cs-fact + .cs-fact {
    padding-top: 16px;
    border-top: 1px solid var(--mist-200);
  }
  .cs-fact dt {
    font: 500 11px / 1.3 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--slate-600);
  }
  .cs-fact dd {
    font: 600 15px / 1.45 var(--font-sans);
    color: var(--ink-900);
  }

  .cs-narrative {
    display: grid;
    gap: 48px;
    max-width: 760px;
  }
  .cs-stage {
    display: grid;
    gap: 16px;
  }
  .cs-stage h3 {
    font: 600 var(--fs-h3) / 1.1 var(--font-sans);
    letter-spacing: -0.035em;
    color: var(--ink-900);
  }
  .cs-stage p {
    font: 400 16px / 1.7 var(--font-sans);
    color: var(--slate-600);
  }
  .cs-stage :global(strong) {
    font-weight: 600;
    color: var(--ink-900);
  }
  .cs-list {
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .cs-list li {
    position: relative;
    padding-left: 22px;
    font: 400 16px / 1.65 var(--font-sans);
    color: var(--slate-600);
  }
  .cs-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint-500);
  }

  /* ---- payoff ---- */
  .cs-payoff {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    margin-top: clamp(48px, 6vw, 72px);
    padding: clamp(28px, 5vw, 56px);
    border-radius: var(--radius-xl);
  }
  @media (min-width: 960px) {
    .cs-payoff {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: clamp(48px, 6vw, 96px);
    }
  }
  .cs-payoff-h {
    font: 800 var(--fs-h2) / 1 var(--font-sans);
    letter-spacing: -0.055em;
    color: var(--mint-500);
  }
  .cs-payoff-body {
    display: grid;
    gap: 20px;
    max-width: 760px;
  }
  .cs-payoff-body p {
    font: 400 16px / 1.65 var(--font-sans);
    color: var(--on-ink-soft);
  }
  .cs-wins {
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .cs-wins li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    font: 400 16px / 1.55 var(--font-sans);
    color: var(--on-ink);
  }
  .cs-wins :global(strong) {
    font-weight: 600;
  }
  .cs-check {
    width: 24px;
    height: 24px;
    padding: 4px;
    border-radius: 50%;
    background: var(--ink-700);
    fill: none;
    stroke: var(--mint-500);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
