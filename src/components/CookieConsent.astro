---
/* Cookie consent bar.

   The site sets two non-essential cookie families, both Google and both loaded
   by the same tag: Analytics 4 (`_ga*`, property G-EWVWPJGYVM) and Ads
   (`_gcl*`, AW-11029031415). Everything else it writes is first-party and
   functional — `gi_bar_hidden_*` remembers a dismissed announcement, `gi_consent`
   remembers this very choice.

   The control stays binary even so, because the two arrive together: one
   gtag.js request configures both ids, so there is no state in which analytics
   runs and advertising doesn't. Offering separate switches would be describing
   an architecture we don't have. What the second tag does change is the copy —
   the paragraph has to say "advertising", not just "statistics", or the answer
   isn't informed. A three-tier "manage preferences" drawer over a single real
   decision would be theatre, and theatre is what makes people click Accept
   without reading.

   Two rules drive the implementation:

   1. Nothing loads before the answer. The GA4 script tag is not in the document
      — Site.astro publishes `window.giEnableAnalytics()` and this component (or
      a stored `gi_consent=granted`) calls it. Before consent there is no request
      to googletagmanager.com at all, which is a stronger position than Consent
      Mode's cookieless pings. Consent Mode v2 defaults are still declared, so
      the tag behaves correctly the moment it does load.
   2. Refusing is exactly as easy as accepting. Same size, same shape, same row,
      one click each — the only difference is fill colour. There is no × that
      quietly means "ask me again on every page", and no pre-ticked anything.

   Placement is the bottom edge on purpose: the top belongs to the
   announcement bar and the sticky header, and a panel pinned there would sit
   on the page's own navigation.

   A <div role="dialog">, not an <aside>: ARIA in HTML does not allow the
   dialog role on <aside>, and the role is what a screen reader announces. */
import site from '../data/site.json';
import { localeOf, t } from '../i18n/ui';
const s = t(localeOf(Astro.currentLocale));
---

<!-- COOKIE CONSENT -->
<div
  id="gi-consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="gi-consent-title"
  aria-describedby="gi-consent-body"
  hidden
>
  <div class="gi-consent-inner">
    <div class="gi-consent-copy">
      <h2 id="gi-consent-title">{s('cc.title')}</h2>
      <p id="gi-consent-body" set:html={s('cc.bodyHtml')} />
    </div>
    <div class="gi-consent-actions">
      <button type="button" class="gi-consent-btn gi-consent-accept" data-consent="granted">
        {s('cc.accept')}
      </button>
      <button type="button" class="gi-consent-btn gi-consent-reject" data-consent="denied">
        {s('cc.reject')}
      </button>
    </div>
  </div>
</div>
<!-- END COOKIE CONSENT -->

<style>
  /* v2: an ink card floating over the bottom edge — the system's toasts are
     always ink. It is ink-700, the system's "card on ink", so it still has
     an edge where it floats over an ink section or the hero's mass. Both
     answers are filled pills of identical geometry, side by side: refusing
     costs exactly what accepting costs. Accept is the view's one mint
     accent; reject is ink-900 with an on-ink label. */
  #gi-consent {
    position: fixed;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 16px;
    z-index: var(--z-consent);
    max-width: 880px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    background: var(--ink-700);
    color: var(--on-ink);
    font-family: var(--font-sans);
    /* The reveal is a state class, not the default: with JS off nothing shows
       (and nothing loads either), and for anyone who already answered the bar
       never paints at all. */
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity var(--dur-base) var(--ease-fall),
      transform var(--dur-slow) var(--ease-fall);
  }
  #gi-consent.is-in {
    opacity: 1;
    transform: none;
  }
  .gi-consent-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 20px 24px;
  }
  .gi-consent-copy {
    flex: 1 1 auto;
    min-width: 0;
  }
  /* Capped on the children, so each counts `ch` in its own type size. */
  .gi-consent-copy > * {
    max-width: var(--measure);
  }
  #gi-consent h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 6px;
    font: 600 15px / 1.3 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--on-ink);
  }
  #gi-consent h2::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint-500);
  }
  #gi-consent p {
    margin: 0;
    font: 400 13px / 1.55 var(--font-sans);
    color: var(--on-ink-soft);
    text-wrap: pretty;
  }
  /* :global() because the paragraph is set:html. */
  #gi-consent :global(a) {
    color: var(--on-ink);
    text-decoration-color: var(--mint-500);
  }
  #gi-consent :global(a:hover) {
    color: var(--mint-500);
  }
  /* Two equal columns: refusing is exactly as big as accepting, whichever
     label happens to be longer. */
  .gi-consent-actions {
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .gi-consent-btn {
    min-height: 44px;
    min-width: 9.5rem;
    padding: 0 20px;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font: 600 14px / 1.15 var(--font-sans);
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }
  .gi-consent-btn:active {
    transform: scale(0.97);
  }
  .gi-consent-accept {
    background: var(--mint-500);
    color: var(--ink-900);
  }
  .gi-consent-accept:hover {
    background: var(--mint-600);
  }
  .gi-consent-reject {
    background: var(--ink-900);
    color: var(--on-ink);
    border-color: var(--slate-400);
  }
  .gi-consent-reject:hover {
    background: var(--slate-600);
  }
  #gi-consent :focus-visible {
    outline: 3px solid var(--mint-500);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--white);
  }

  @media (max-width: 760px) {
    #gi-consent {
      left: 12px;
      right: 12px;
      bottom: 12px;
    }
    .gi-consent-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 16px 16px calc(16px + env(safe-area-inset-bottom, 0px));
    }
    .gi-consent-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .gi-consent-btn {
      min-width: 0;
      padding: 0 10px;
    }
  }
  /* A phone-height budget: the paragraph is the legal substance, so it
     tightens rather than being truncated. */
  @media (max-width: 575.98px) {
    #gi-consent h2 {
      font-size: 14px;
      margin-bottom: 4px;
    }
    #gi-consent p {
      font-size: 12.5px;
      line-height: 1.5;
    }
  }
  @media (max-width: 340px) {
    .gi-consent-actions {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #gi-consent {
      transition: none;
      transform: none;
      opacity: 1;
    }
    .gi-consent-btn {
      transition: none;
    }
  }
</style>

<script is:inline define:vars={{ ga4: site.ga4 }}>
  (function () {
    var bar = document.getElementById('gi-consent');
    if (!bar) return;

    var KEY = 'gi_consent';
    /* Six months, not a year: consent is supposed to be revisited, and half a
       year is the span most EU regulators treat as still-current. */
    var MAX_AGE = 60 * 60 * 24 * 182;

    function read() {
      var m = document.cookie.match(/(?:^|;\s*)gi_consent=(granted|denied)/);
      return m ? m[1] : null;
    }

    function show() {
      bar.hidden = false;
      /* two frames so the initial translated state actually paints before the
         class flips — otherwise the browser collapses it into no transition */
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          bar.classList.add('is-in');
        });
      });
    }

    function hide() {
      bar.classList.remove('is-in');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        bar.hidden = true;
        return;
      }
      window.setTimeout(function () {
        bar.hidden = true;
      }, 500);
    }

    function decide(value) {
      document.cookie = KEY + '=' + value + ';path=/;max-age=' + MAX_AGE + ';samesite=lax';
      if (value === 'granted') {
        if (window.giEnableAnalytics) window.giEnableAnalytics();
        /* MailerLite's pop-up tag rides the same single answer. It is only
           published on Polish pages, so on /en/ this call is a no-op — the
           guard is in the loader rather than here, so this stays one branch. */
        if (window.giEnableMailerLite) window.giEnableMailerLite();
      } else {
        if (window.giDisableAnalytics) window.giDisableAnalytics();
        if (window.giDisableMailerLite) window.giDisableMailerLite();
      }
      hide();
    }

    bar.querySelectorAll('[data-consent]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        decide(btn.getAttribute('data-consent'));
      });
    });

    /* Withdrawing has to be as easy as granting, so anything on the page can
       reopen this — the footer link is the one that ships. Reopening clears the
       stored answer *and* turns analytics back off, so an unanswered bar never
       means "still tracking". */
    window.giOpenConsent = function () {
      document.cookie = KEY + '=;path=/;max-age=0;samesite=lax';
      if (window.giDisableAnalytics) window.giDisableAnalytics();
      if (window.giDisableMailerLite) window.giDisableMailerLite();
      show();
      var first = bar.querySelector('.gi-consent-btn');
      if (first) first.focus();
    };
    document.querySelectorAll('[data-consent-open]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        window.giOpenConsent();
      });
    });

    if (!read()) {
      /* Let the page settle first — arriving on a hero and being handed a legal
         question in the same frame is how banners get dismissed unread. */
      window.setTimeout(show, 700);
    }

    /* `ga4` is read by Site.astro's loader; referenced here so the define:vars
       binding stays honest if that ever moves. */
    void ga4;
  })();
</script>
