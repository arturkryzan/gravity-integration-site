---
/* "Umów 15-minutowe demo" section (was snippet 13 + CF7 form 414).
   variant="integracje" swaps the heading (was snippet 31's replacement).

   Rebuilt in the overdrive pass. The CF7 class scaffolding is gone — it only
   existed to satisfy WordPress, and every `!important` in the old file was
   fighting theme rules scoped to `form .form-row …`, which this form never
   matched.

   Submission goes straight to MailerLite — form "gravity.integration — Demo
   (www)", feeding the GRAVITY group. There is no server in this build, so the
   `action` is the MailerLite endpoint and the inputs are named after
   MailerLite's own field keys: with JS off the browser posts natively and the
   lead still lands. The script below upgrades that to fetch + inline result.

   `name` (the wire format) and `key` (what the script calls the field) are now
   two different things, so every input carries `data-key`. The script looks
   fields up by that, which is why renaming the wire format didn't ripple
   through forty references below. */
import { mlAction } from '../lib/mailerlite';
import { localeOf, t } from '../i18n/ui';

interface Props { variant?: 'home' | 'integracje' }
const { variant = 'home' } = Astro.props;

const action = mlAction('demo');

const lang = localeOf(Astro.currentLocale);
const s = t(lang);

const fields = [
  {
    name: 'your-name', ml: 'name', label: s('demo.field.name'), type: 'text',
    placeholder: s('demo.field.name.ph'), autocomplete: 'name', required: true,
  },
  {
    name: 'your-email', ml: 'email', label: s('demo.field.email'), type: 'email',
    placeholder: s('demo.field.email.ph'), autocomplete: 'email',
    inputmode: 'email', required: true,
  },
  {
    name: 'your-company', ml: 'company', label: s('demo.field.company'), type: 'text',
    placeholder: s('demo.field.company.ph'), autocomplete: 'organization', required: true,
  },
  {
    name: 'your-phone', ml: 'phone', label: s('demo.field.phone'), type: 'tel',
    placeholder: s('demo.field.phone.ph'), autocomplete: 'tel',
    inputmode: 'tel', required: false,
  },
] as const;
---

<section id="section-demo" class="demo-section section surface-mist">
  <div class="container">
    <div class="demo-panel surface-ink">
    <div class="demo-intro" data-reveal>
      {variant === 'integracje' ? (
        <>
          <h2 class="demo-h2">{s('demo.h2.integrations')}</h2>
          <p class="demo-lede">
            {s('demo.lede.integrations')}
          </p>
        </>
      ) : (
        <>
          <h2 class="demo-h2">
            {s('demo.h2.line1')}
            <span class="demo-h2-accent">{s('demo.h2.accent')}</span>
          </h2>
          <p class="demo-lede">
            {s('demo.lede')}
          </p>
        </>
      )}
    </div>

    <div id="demo-form-wrapper" class="demo-card">
      <form
        action={action}
        method="post"
        target="_blank"
        data-form="demo"
        class="demo-form"
        aria-label={s('demo.form.aria')}
      >
        {fields.map((f) => (
          <div class="demo-field" data-field={f.name}>
            <label class="demo-label" for={`demo-${f.name}`}>
              {f.label}
              {!f.required && <> <span class="demo-optional">{s('demo.optional')}</span></>}
            </label>
            <div class="demo-control">
              <input
                type={f.type}
                id={`demo-${f.name}`}
                name={`fields[${f.ml}]`}
                data-key={f.name}
                class="demo-input"
                placeholder={f.placeholder}
                autocomplete={f.autocomplete}
                inputmode={'inputmode' in f ? (f as any).inputmode : undefined}
                required={f.required || undefined}
                aria-required={f.required ? 'true' : undefined}
                aria-invalid="false"
                aria-describedby={`demo-${f.name}-err demo-${f.name}-note`}
              />
              <svg class="demo-tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4.5 10.5 8.4 14.3 15.6 6.4" pathLength="1" />
              </svg>
            </div>
            <p class="demo-err" id={`demo-${f.name}-err`} aria-live="polite" hidden></p>
            {/* Hints live in the markup rather than being injected, so Astro's
                scoped styles actually reach them. */}
            <div class="demo-note" id={`demo-${f.name}-note`} aria-live="polite">
              <p class="demo-hint" hidden></p>
              {f.name === 'your-company' && (
                <button type="button" class="demo-fill" hidden>
                  <span class="demo-fill-text"></span>
                </button>
              )}
            </div>
          </div>
        ))}

        {/* Honeypot + fill-time trap. There is no server to verify these any
            more, so they're checked in the browser before the request goes out:
            a bot that fills the hidden field or submits within two seconds is
            shown the success state and never reaches MailerLite. That stops the
            junk that scripts a real form; it isn't a claim of security. */}
        <div class="demo-hp" aria-hidden="true">
          <label for="demo-website-url">Leave this field empty</label>
          <input type="text" id="demo-website-url" name="website_url" value="" autocomplete="off" tabindex="-1" />
        </div>
        <input type="hidden" data-key="_demo_ts" value="" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />

        <div class="demo-field demo-field-full" data-field="demo-consent">
          <label class="demo-consent" for="demo-consent">
            <input
              type="checkbox"
              id="demo-consent"
              name="demo-consent"
              data-key="demo-consent"
              value="1"
              required
              aria-required="true"
              aria-invalid="false"
              aria-describedby="demo-consent-err"
            />
            <span class="demo-check" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false">
                <path d="M4.5 10.4 8.3 14.1 15.5 6.5" pathLength="1" />
              </svg>
            </span>
            <span class="demo-consent-text">
              {s('demo.consent')}
            </span>
          </label>
          <p class="demo-err" id="demo-consent-err" aria-live="polite" hidden></p>
        </div>

        <div class="demo-field demo-field-full">
          <button type="submit" class="demo-submit">
            <span class="demo-submit-label">{s('demo.submit')}</span>
            <span class="demo-submit-pending" aria-hidden="true">
              <svg class="demo-spinner" viewBox="0 0 20 20" focusable="false">
                <circle cx="10" cy="10" r="7.5" />
                <path d="M10 2.5a7.5 7.5 0 0 1 7.5 7.5" />
              </svg>
              {s('form.sending')}
            </span>
          </button>
          <p class="demo-formerr" role="alert" hidden></p>
        </div>
      </form>

      <div class="demo-done" hidden>
        <svg class="demo-done-tick" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
          <circle cx="22" cy="22" r="20" pathLength="1" />
          <path d="M13 22.5 19.4 28.8 31 16.5" pathLength="1" />
        </svg>
        <h3 class="demo-done-h">{s('demo.done.h')}<span data-done="name"></span>.</h3>
        <p class="demo-done-p">
          {s('demo.done.p1')}<strong data-done="email"></strong>{s('demo.done.p2')}
        </p>
        <p class="demo-done-note">
          {s('demo.done.note')}
        </p>
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------
     v2. The section is mist; on it sits one ink panel — ink over mist is
     how the system makes depth. No mass: the panel sits directly above the
     footer, whose mass is the frame's one. The form is a white card on the
     ink: the system's
     inputs are drawn for light surfaces, and a white card is the one place
     on this panel where they read exactly as specified.

     Everything the script addresses (.demo-field[data-field], .demo-err,
     .demo-hint, .demo-fill, .demo-submit, .demo-done, the ids) is unchanged
     from v1, so the smart-form behaviour and its harness carry over.
     --------------------------------------------------------------- */
  .demo-panel {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding: clamp(32px, 6vw, 72px);
    border-radius: var(--radius-xl);
  }
  @media (min-width: 960px) {
    .demo-panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
      gap: clamp(40px, 5vw, 80px);
    }
  }

  .demo-intro {
    display: grid;
    gap: 20px;
    align-content: start;
    max-width: 30rem;
  }
  .demo-h2 {
    display: grid;
    gap: 6px;
    color: var(--on-ink);
    font: 800 var(--fs-h2) / 1 var(--font-sans);
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .demo-h2-accent {
    color: var(--mint-500);
  }
  /* "gravity.integration" is one 263px word at 30px; a 320px phone gives the
     panel 216px. Below 600px the size follows the viewport and the panel's
     padding tightens, so the word always fits its line. */
  @media (max-width: 599.98px) {
    .demo-panel {
      padding: 24px;
    }
    .demo-h2 {
      font-size: clamp(24px, 7.6vw, 30px);
    }
  }
  .demo-lede {
    font: 400 var(--fs-body-lg) / 1.6 var(--font-sans);
    color: var(--on-ink-soft);
    text-wrap: pretty;
  }

  .demo-card {
    position: relative;
    padding: clamp(24px, 3vw, 32px);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink-900);
    --focus-gap: var(--ink-900);
    --focus-ring: var(--mint-500);
    --underline: var(--mint-500);
  }

  /* ---- grid ---- */
  .demo-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
    align-items: start;
  }
  .demo-field {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .demo-field-full {
    grid-column: 1 / -1;
  }
  @media (max-width: 640px) {
    .demo-form {
      grid-template-columns: 1fr;
    }
  }

  .demo-label {
    font: 600 13px / 1.3 var(--font-sans);
    color: var(--ink-900);
  }
  .demo-optional {
    margin-left: 0.25em;
    font-weight: 400;
    color: var(--muted);
  }

  /* ---- inputs: the system's, 44px, radius 10 ---- */
  .demo-control {
    position: relative;
  }
  .demo-input {
    width: 100%;
    min-height: 44px;
    padding: 0 40px 0 14px;
    border: 1.5px solid var(--mist-200);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--ink-900);
    font: 400 16px / 1.3 var(--font-sans);
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }
  .demo-input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .demo-input:hover {
    border-color: var(--slate-400);
  }
  .demo-input:focus,
  .demo-input:focus-visible {
    outline: none;
    border-color: var(--ink-900);
    box-shadow:
      0 0 0 2px var(--focus-gap),
      0 0 0 5px var(--focus-ring);
  }
  .demo-field[data-state='invalid'] .demo-input {
    border-color: var(--red-500);
  }
  .demo-field[data-state='valid'] .demo-input {
    border-color: var(--ink-900);
  }

  /* ---- the tick: draws itself, never bounces ---- */
  .demo-tick {
    position: absolute;
    right: 13px;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    fill: none;
    stroke: var(--mint-800);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0;
  }
  .demo-tick path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .demo-field[data-state='valid'] .demo-tick {
    opacity: 1;
  }
  .demo-field[data-state='valid'] .demo-tick path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-fall);
  }

  /* ---- messages: tone is a dot, never a fill ---- */
  .demo-err {
    font: 500 12px / 1.45 var(--font-sans);
    color: var(--red-700);
  }
  .demo-hint {
    display: flex;
    gap: 8px;
    font: 400 12px / 1.45 var(--font-sans);
    color: var(--slate-600);
  }
  .demo-hint::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--amber-500);
  }
  .demo-fill {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    margin-top: 2px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--mint-100);
    color: var(--ink-900);
    font: 600 12px / 1.2 var(--font-sans);
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }
  .demo-fill:hover {
    background: var(--mist-200);
  }

  /* ---- consent: the system's checkbox ---- */
  .demo-consent {
    position: relative;
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: start;
    gap: 10px;
    padding: 4px 0;
    cursor: pointer;
  }
  .demo-consent input {
    position: absolute;
    top: 4px;
    left: 0;
    width: 20px;
    height: 20px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .demo-check {
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border: 1.5px solid var(--ink-900);
    border-radius: var(--radius-sm);
    background: var(--white);
    display: grid;
    place-items: center;
    transition: background-color var(--dur-fast) ease;
  }
  .demo-check svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--mint-500);
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .demo-check svg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .demo-consent input:checked + .demo-check {
    background: var(--ink-900);
  }
  .demo-consent input:checked + .demo-check svg path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-base) var(--ease-fall);
  }
  .demo-consent input:focus-visible + .demo-check {
    box-shadow:
      0 0 0 2px var(--focus-gap),
      0 0 0 5px var(--focus-ring);
  }
  .demo-field[data-state='invalid'] .demo-check {
    border-color: var(--red-500);
  }
  .demo-consent-text {
    font: 400 13px / 1.5 var(--font-sans);
    color: var(--slate-600);
  }

  /* ---- submit: the view's one mint accent ---- */
  .demo-submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 0 28px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--mint-500);
    color: var(--ink-900);
    font: 600 15px / 1.15 var(--font-sans);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur-fast) ease;
  }
  .demo-submit:hover {
    background: var(--mint-600);
  }
  .demo-submit:active {
    transform: scale(0.97);
  }
  .demo-submit-label,
  .demo-submit-pending {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    transition: opacity var(--dur-fast) ease;
  }
  .demo-submit-pending {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .demo-submit[data-busy] {
    cursor: progress;
  }
  .demo-submit[data-busy] .demo-submit-label {
    opacity: 0;
  }
  .demo-submit[data-busy] .demo-submit-pending {
    opacity: 1;
  }
  .demo-spinner {
    width: 18px;
    height: 18px;
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    animation: demo-spin 0.75s linear infinite;
  }
  .demo-spinner circle {
    stroke: rgb(30 31 51 / 0.2);
  }
  .demo-spinner path {
    stroke: var(--ink-900);
  }
  @keyframes demo-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .demo-formerr {
    margin-top: 12px;
    font: 500 13px / 1.5 var(--font-sans);
    color: var(--red-700);
  }
  .demo-formerr a {
    color: var(--red-700);
  }

  /* ---- success ---- */
  .demo-done {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 8px 0;
  }
  .demo-done:focus {
    outline: none;
  }
  .demo-done:focus-visible {
    outline: 3px solid var(--mint-500);
    outline-offset: 8px;
    border-radius: var(--radius-md);
  }
  .demo-done-tick {
    width: 56px;
    height: 56px;
    margin-bottom: 8px;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .demo-done-tick circle {
    fill: var(--ink-900);
    stroke: var(--ink-900);
    stroke-width: 2;
  }
  .demo-done-tick path {
    stroke: var(--mint-500);
    stroke-width: 2.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .demo-done[data-in] .demo-done-tick path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-fall) 0.2s;
  }
  .demo-done-h {
    font: 800 var(--fs-h3) / 1.05 var(--font-sans);
    letter-spacing: -0.05em;
    color: var(--ink-900);
  }
  .demo-done-p {
    max-width: 30rem;
    font: 400 16px / 1.6 var(--font-sans);
    color: var(--slate-600);
  }
  .demo-done-p strong {
    color: var(--ink-900);
    font-weight: 600;
    word-break: break-word;
  }
  .demo-done-note {
    max-width: 30rem;
    font: 500 12px / 1.6 var(--font-mono);
    color: var(--muted);
  }
  .demo-done[data-in] .demo-done-h,
  .demo-done[data-in] .demo-done-p,
  .demo-done[data-in] .demo-done-note {
    animation: demo-rise var(--dur-slow) var(--ease-fall) both;
  }
  .demo-done[data-in] .demo-done-p {
    animation-delay: 60ms;
  }
  .demo-done[data-in] .demo-done-note {
    animation-delay: 120ms;
  }
  @keyframes demo-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* ---- honeypot ---- */
  .demo-hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-section *,
    .demo-section *::before,
    .demo-section *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
    /* the spinner keeps turning — it says "still working" — just slowly */
    .demo-spinner {
      animation: demo-spin 2.4s linear infinite !important;
    }
    .demo-tick path,
    .demo-check svg path,
    .demo-done-tick path {
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script>
  /* ================================================================
     "Smart & instant" — the form should feel like it already knows what
     you mean. Validation resolves inline instead of scolding on submit,
     the work address is nudged rather than blocked, the company name is
     offered from the email domain, the phone formats itself, and the
     button morphs in place through pending into a result.

     Everything here is an upgrade on top of markup that already works:
     with JS off the form does a plain POST to MailerLite and the lead lands
     regardless. This layer keeps the user on the page and answers them.
     ================================================================ */
  import { mlAction } from '../lib/mailerlite';
  import { mlSubmit, trackLead } from '../scripts/ml-forms';
  import { pick } from '../i18n/client';

  type FieldName = 'your-name' | 'your-email' | 'your-company' | 'your-phone';

  const FREE_MAIL = new Set([
    'gmail.com', 'googlemail.com', 'wp.pl', 'o2.pl', 'onet.pl', 'onet.eu',
    'poczta.onet.pl', 'interia.pl', 'interia.eu', 'op.pl', 'vp.pl', 'tlen.pl',
    'go2.pl', 'autograf.pl', 'buziaczek.pl', 'poczta.fm', 'gazeta.pl',
    'yahoo.com', 'yahoo.pl', 'outlook.com', 'outlook.pl', 'hotmail.com',
    'hotmail.pl', 'live.com', 'msn.com', 'icloud.com', 'me.com', 'mac.com',
    'aol.com', 'gmx.com', 'gmx.net', 'gmx.de', 'proton.me', 'protonmail.com',
    'pm.me', 'zoho.com', 'yandex.ru', 'mail.ru',
  ]);

  /* Public suffixes we must not mistake for a company name. */
  const MULTI_TLD = new Set([
    'com.pl', 'net.pl', 'org.pl', 'edu.pl', 'gov.pl', 'info.pl', 'biz.pl',
    'waw.pl', 'co.uk', 'org.uk', 'com.de', 'co.jp', 'com.au',
  ]);

  const EMAIL_RE = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/;

  /* This bundle is shared by every page in both languages, so the copy picks
     its language at runtime off <html lang> (src/i18n/client.ts). */
  const messages = pick({
    pl: {
      'your-name': 'Podaj imię i nazwisko — będziemy wiedzieć, do kogo napisać.',
      'your-email': 'Ten adres wygląda na niepełny. Sprawdź go jeszcze raz.',
      'your-email-empty': 'Bez adresu e-mail nie mamy jak odesłać terminu.',
      'your-company': 'Podaj nazwę firmy — dobierzemy demo do Waszych systemów.',
      'your-phone': 'Numer wygląda na za krótki. Zostaw go pusty, jeśli wolisz.',
      'demo-consent': 'Potrzebujemy tej zgody, żeby móc się odezwać.',
    },
    en: {
      'your-name': "Tell us your name — so we know who to write to.",
      'your-email': 'That address looks incomplete. Give it another check.',
      'your-email-empty': "Without an e-mail address we can't send a time back to you.",
      'your-company': "Tell us the company name — we'll match the demo to your systems.",
      'your-phone': 'That number looks too short. Leave it empty if you prefer.',
      'demo-consent': 'We need this consent to be able to get back to you.',
    },
  });
  const freeMailHint = pick({
    pl: 'To adres prywatny. Na służbowy dorzucimy materiały dla zespołu — ale zadziała każdy.',
    en: "That's a personal address. A work one gets extra team materials — but any address works.",
  });
  const insertLabel = pick<(g: string) => string>({
    pl: (g) => `Wstaw „${g}”`,
    en: (g) => `Insert "${g}"`,
  });
  const failedHtml = pick({
    pl:
      'Nie udało się wysłać formularza. Napisz prosto do nas na ' +
      '<a href="mailto:contact@caffeine-minds.com?subject=Demo%20gravity.integration">' +
      'contact@caffeine-minds.com</a> — odpowiemy tak samo szybko.',
    en:
      "The form didn't go through. Write to us directly at " +
      '<a href="mailto:contact@caffeine-minds.com?subject=Demo%20gravity.integration">' +
      "contact@caffeine-minds.com</a> — we'll reply just as fast.",
  });

  function digits(s: string) { return s.replace(/\D/g, ''); }

  /** Polish numbers become +48 123 456 789. A number the user explicitly
   *  marked as foreign (a leading + with any prefix other than 48) is left
   *  exactly as typed.
   *
   *  The subtlety: this runs on every keystroke over its own output, so it has
   *  to strip the "+48 " it just wrote before re-reading the digits. Matching
   *  on the raw prefix rather than on the digit string is what makes that
   *  idempotent — digits alone can't tell the country code from the number. */
  function formatPhone(raw: string): string {
    const t = raw.trim();
    if (!t) return '';
    if (t.startsWith('+') && !/^\+\s*48/.test(t)) return raw;
    let d = digits(t.replace(/^\+?\s*48[\s-]*/, ''));
    if (d.startsWith('0048')) d = d.slice(4);
    d = d.replace(/^0+/, '');
    d = d.slice(0, 9);
    if (!d) return raw;
    const groups = [d.slice(0, 3), d.slice(3, 6), d.slice(6, 9)].filter(Boolean);
    return '+48 ' + groups.join(' ');
  }

  function domainOf(email: string): string {
    const at = email.lastIndexOf('@');
    return at === -1 ? '' : email.slice(at + 1).trim().toLowerCase();
  }

  /** "zamowienia@acme-polska.com.pl" → "Acme Polska" */
  function companyFromDomain(domain: string): string {
    if (!domain || FREE_MAIL.has(domain)) return '';
    const parts = domain.replace(/^www\./, '').split('.');
    if (parts.length < 2) return '';
    const last2 = parts.slice(-2).join('.');
    const core = MULTI_TLD.has(last2) ? parts.slice(0, -2) : parts.slice(0, -1);
    let label = core[core.length - 1] || '';
    if (['mail', 'poczta', 'smtp', 'email', 'grupa'].includes(label) && core.length > 1) {
      label = core[core.length - 2];
    }
    if (!label || label.length < 2 || /^\d+$/.test(label)) return '';
    return label
      .split(/[-_]+/)
      .filter(Boolean)
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
  }

  function initDemoForm(form: HTMLFormElement) {
    const section = form.closest('.demo-section') as HTMLElement | null;
    const card = form.closest('.demo-card') as HTMLElement | null;
    const done = card?.querySelector('.demo-done') as HTMLElement | null;
    const formErr = form.querySelector('.demo-formerr') as HTMLElement | null;
    const submit = form.querySelector('.demo-submit') as HTMLButtonElement | null;
    if (!section || !card || !submit) return;

    /* The markup keeps `required` and no `novalidate` so the browser enforces
       the form on its own with JS off. Once we're here, we own validation —
       our messages are inline and in the page's language, the UA's are
       neither. */
    form.noValidate = true;

    /* anti-spam bootstrap (port of snippet 15's client side) */
    const ts = form.querySelector<HTMLInputElement>('[data-key="_demo_ts"]');
    if (ts) ts.value = String(Date.now());

    const wrap = (name: string) =>
      form.querySelector<HTMLElement>(`.demo-field[data-field="${name}"]`);
    /* Fields are addressed by `data-key`, not `name`: `name` is the MailerLite
       wire format (`fields[company]`) and shouldn't leak into forty lookups. */
    const input = (name: string) =>
      form.querySelector<HTMLInputElement>(`[data-key="${name}"]`);

    const touched = new Set<string>();

    function setError(name: string, msg: string | null) {
      const w = wrap(name);
      const el = w?.querySelector<HTMLElement>('.demo-err');
      const ctl = input(name);
      if (!w || !el || !ctl) return;
      if (msg) {
        el.textContent = msg;
        el.hidden = false;
        w.dataset.state = 'invalid';
        ctl.setAttribute('aria-invalid', 'true');
      } else {
        el.textContent = '';
        el.hidden = true;
        ctl.setAttribute('aria-invalid', 'false');
        delete w.dataset.state;
      }
    }

    function setValid(name: string, ok: boolean) {
      const w = wrap(name);
      if (!w) return;
      if (ok) w.dataset.state = 'valid';
      else if (w.dataset.state === 'valid') delete w.dataset.state;
    }

    function hint(name: string, text: string | null) {
      const el = wrap(name)?.querySelector<HTMLElement>('.demo-hint');
      if (!el) return;
      el.textContent = text || '';
      el.hidden = !text;
    }

    function offer(name: string, text: string | null, value = '') {
      const btn = wrap(name)?.querySelector<HTMLButtonElement>('.demo-fill');
      if (!btn) return;
      const label = btn.querySelector<HTMLElement>('.demo-fill-text');
      if (label) label.textContent = text || '';
      btn.dataset.fill = value;
      btn.hidden = !text;
    }

    /* ---- per-field rules ---- */
    function check(name: string, opts: { silent?: boolean } = {}): boolean {
      const ctl = input(name);
      if (!ctl) return true;

      if (name === 'demo-consent') {
        const ok = (ctl as HTMLInputElement).checked;
        if (!ok && !opts.silent) setError(name, messages['demo-consent']);
        else setError(name, null);
        return ok;
      }

      const v = ctl.value.trim();

      if (name === 'your-phone') {
        if (!v) { setError(name, null); setValid(name, false); return true; }
        const ok = digits(v).length >= 9;
        setError(name, ok || opts.silent ? null : messages['your-phone']);
        setValid(name, ok);
        return ok;
      }

      if (!v) {
        setValid(name, false);
        if (!opts.silent) {
          setError(
            name,
            name === 'your-email'
              ? messages['your-email-empty']
              : messages[name as keyof typeof messages],
          );
        }
        return false;
      }

      let ok = v.length >= 2;
      if (name === 'your-email') ok = EMAIL_RE.test(v);
      setError(name, ok || opts.silent ? null : messages[name as keyof typeof messages]);
      setValid(name, ok);
      return ok;
    }

    /* ---- the two "it already knows" moves ---- */
    let dismissed = '';

    function reactToEmail() {
      const email = input('your-email');
      const company = input('your-company');
      if (!email || !company) return;
      const v = email.value.trim();
      if (!EMAIL_RE.test(v)) { hint('your-email', null); offer('your-company', null); return; }
      const domain = domainOf(v);

      /* Free-mail nudge. Never blocking — plenty of real leads use wp.pl. */
      hint('your-email', FREE_MAIL.has(domain) ? freeMailHint : null);

      /* Company inferred from the domain, offered rather than imposed. */
      const guess = companyFromDomain(domain);
      if (guess && !company.value.trim() && guess !== dismissed) {
        offer('your-company', insertLabel(guess), guess);
      } else {
        offer('your-company', null);
      }
    }

    form.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.demo-fill');
      if (!btn) return;
      const company = input('your-company');
      if (!company) return;
      dismissed = btn.dataset.fill || '';
      company.value = dismissed;
      offer('your-company', null);
      touched.add('your-company');
      check('your-company');
      company.focus();
    });

    /* ---- wiring ---- */
    (['your-name', 'your-email', 'your-company', 'your-phone'] as FieldName[]).forEach((name) => {
      const ctl = input(name);
      if (!ctl) return;

      ctl.addEventListener('blur', () => {
        touched.add(name);
        if (name === 'your-phone' && ctl.value.trim()) ctl.value = formatPhone(ctl.value);
        check(name);
        if (name === 'your-email') reactToEmail();
      });

      ctl.addEventListener('input', () => {
        if (name === 'your-phone') {
          /* only reformat while typing at the end, so the caret never jumps */
          const atEnd = ctl.selectionStart === ctl.value.length;
          if (atEnd) {
            const next = formatPhone(ctl.value);
            if (next !== ctl.value) {
              ctl.value = next;
              ctl.setSelectionRange(next.length, next.length);
            }
          }
        }
        /* Resolve as you type once the field has been visited — but never
           start scolding a field the user is still filling in for the first
           time. That asymmetry is the whole trick. */
        if (touched.has(name)) check(name, { silent: !wrapInvalid(name) });
        else check(name, { silent: true });
        if (name === 'your-email') reactToEmail();
      });
    });

    function wrapInvalid(name: string) {
      return wrap(name)?.dataset.state === 'invalid';
    }

    const consent = input('demo-consent');
    consent?.addEventListener('change', () => {
      touched.add('demo-consent');
      check('demo-consent');
    });

    /* ---- submit ---- */
    const ORDER = ['your-name', 'your-email', 'your-company', 'your-phone', 'demo-consent'];

    function showDone(name: string, email: string) {
      if (!done) return;
      const first = (name.trim().split(/\s+/)[0] || '').replace(/[^\p{L}\p{M}'-]/gu, '');
      const nameEl = done.querySelector<HTMLElement>('[data-done="name"]');
      const mailEl = done.querySelector<HTMLElement>('[data-done="email"]');
      if (nameEl) nameEl.textContent = first ? `, ${first}` : '';
      if (mailEl) mailEl.textContent = email;
      const h = card.offsetHeight;
      form.hidden = true;
      done.hidden = false;
      /* hold the card's height for a beat so the page doesn't jump under
         the user's cursor at the exact moment they get good news */
      card.style.minHeight = `${h}px`;
      requestAnimationFrame(() => {
        done.dataset.in = '';
        window.setTimeout(() => { card.style.minHeight = ''; }, 500);
      });
      done.setAttribute('tabindex', '-1');
      done.focus({ preventScroll: true });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.dataset.busy !== undefined) return;

      ORDER.forEach((n) => touched.add(n));
      const bad = ORDER.filter((n) => !check(n));
      if (formErr) { formErr.hidden = true; formErr.textContent = ''; }
      if (bad.length) {
        const first = input(bad[0]);
        first?.focus();
        first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }

      const name = input('your-name')?.value.trim() || '';
      const email = input('your-email')?.value.trim() || '';

      /* Bot checks, client-side now that there's no endpoint to run them.
         Both fail *silently into success*: telling a script exactly which
         tripwire it hit is how it learns to avoid the tripwire. */
      const hp = form.querySelector<HTMLInputElement>('input[name="website_url"]');
      const startedAt = Number(ts?.value || 0);
      const tooFast = startedAt > 0 && Date.now() - startedAt < 2000;
      if (hp?.value.trim() || tooFast) {
        showDone(name, email);
        return;
      }

      submit.dataset.busy = '';
      submit.setAttribute('aria-busy', 'true');

      const result = await mlSubmit(mlAction('demo'), {
        name,
        email,
        company: input('your-company')?.value.trim(),
        phone: input('your-phone')?.value.trim(),
      });

      delete submit.dataset.busy;
      submit.removeAttribute('aria-busy');

      if (result.ok) {
        showDone(name, email);
        trackLead('demo_request_submitted');
        return;
      }

      if (result.kind === 'email') {
        /* MailerLite rejected the address itself — that belongs on the field,
           not in a form-level "something went wrong". */
        touched.add('your-email');
        setError('your-email', result.message);
        input('your-email')?.focus();
        return;
      }

      if (formErr) {
        formErr.innerHTML = failedHtml;
        formErr.hidden = false;
      }
    });

    /* Dev affordance: /?demo-preview=success renders the post-submit state so
       it can be reviewed without sending a real lead to MailerLite. */
    if (new URLSearchParams(location.search).get('demo-preview') === 'success') {
      showDone('Jan Kowalski', 'jan@firma.pl');
    }
  }

  document
    .querySelectorAll<HTMLFormElement>('form[data-form="demo"]')
    .forEach(initDemoForm);
</script>
