<script>
  /* Same "smart & instant" runtime as the demo form, reduced to two fields.
     With JS off the form POSTs natively to MailerLite and the link still goes
     out — this layer keeps the visitor on the page and answers them. */
  import { mlAction } from '../lib/mailerlite';
  import { mlSubmit, trackLead } from '../scripts/ml-forms';
  import { pick } from '../i18n/client';

  const FREE_MAIL = new Set([
    'gmail.com', 'googlemail.com', 'wp.pl', 'o2.pl', 'onet.pl', 'onet.eu',
    'poczta.onet.pl', 'interia.pl', 'interia.eu', 'op.pl', 'vp.pl', 'tlen.pl',
    'go2.pl', 'autograf.pl', 'buziaczek.pl', 'poczta.fm', 'gazeta.pl',
    'yahoo.com', 'yahoo.pl', 'outlook.com', 'outlook.pl', 'hotmail.com',
    'hotmail.pl', 'live.com', 'msn.com', 'icloud.com', 'me.com', 'mac.com',
    'aol.com', 'gmx.com', 'gmx.net', 'gmx.de', 'proton.me', 'protonmail.com',
    'pm.me', 'zoho.com', 'yandex.ru', 'mail.ru',
  ]);
  const MULTI_TLD = new Set([
    'com.pl', 'net.pl', 'org.pl', 'edu.pl', 'gov.pl', 'info.pl', 'biz.pl',
    'waw.pl', 'co.uk', 'org.uk', 'com.de', 'co.jp', 'com.au',
  ]);
  const EMAIL_RE = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/;

  /* This bundle is shared by both language trees, so the copy picks its
     language at runtime off <html lang> (src/i18n/client.ts). */
  const messages = pick({
    pl: {
      'dl-email': 'Ten adres wygląda na niepełny. Sprawdź go jeszcze raz.',
      'dl-email-empty': 'Bez adresu e-mail nie mamy jak wysłać linku.',
      'dl-company': 'Podaj nazwę firmy — przygotujemy się do ewentualnych pytań o Wasze systemy.',
      'dl-consent': 'Potrzebujemy tej zgody, żeby móc wysłać link.',
    },
    en: {
      'dl-email': 'That address looks incomplete. Give it another check.',
      'dl-email-empty': 'Without an e-mail address we have nowhere to send the link.',
      'dl-company': "Tell us the company name — we'll be ready for any questions about your systems.",
      'dl-consent': 'We need this consent to be able to send the link.',
    },
  });
  const freeMailHint = pick({
    pl: 'To adres prywatny. Link zadziała, ale na służbowy dorzucimy materiały dla zespołu.',
    en: "That's a personal address. The link will work, but a work one gets extra team materials.",
  });
  const insertLabel = pick<(g: string) => string>({
    pl: (g) => `Wstaw „${g}”`,
    en: (g) => `Insert "${g}"`,
  });
  const failedHtml = pick({
    pl:
      'Nie udało się wysłać formularza. Napisz prosto do nas na ' +
      '<a href="mailto:contact@caffeine-minds.com?subject=Pobieranie%20gravity.integration">' +
      'contact@caffeine-minds.com</a> — wyślemy link ręcznie.',
    en:
      "The form didn't go through. Write to us directly at " +
      '<a href="mailto:contact@caffeine-minds.com?subject=Pobieranie%20gravity.integration">' +
      "contact@caffeine-minds.com</a> — we'll send the link by hand.",
  });

  function domainOf(email: string): string {
    const at = email.lastIndexOf('@');
    return at === -1 ? '' : email.slice(at + 1).trim().toLowerCase();
  }

  function companyFromDomain(domain: string): string {
    if (!domain || FREE_MAIL.has(domain)) return '';
    const parts = domain.replace(/^www\./, '').split('.');
    if (parts.length < 2) return '';
    const last2 = parts.slice(-2).join('.');
    const core = MULTI_TLD.has(last2) ? parts.slice(0, -2) : parts.slice(0, -1);
    let label = core[core.length - 1] || '';
    if (['mail', 'poczta', 'smtp', 'email', 'grupa'].includes(label) && core.length > 1) {
      label = core[core.length - 2];
    }
    if (!label || label.length < 2 || /^\d+$/.test(label)) return '';
    return label
      .split(/[-_]+/)
      .filter(Boolean)
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
  }

  function initDownloadForm(form: HTMLFormElement) {
    const card = form.closest('.dl-card') as HTMLElement | null;
    const done = card?.querySelector('.dl-done') as HTMLElement | null;
    const formErr = form.querySelector('.dl-formerr') as HTMLElement | null;
    const submit = form.querySelector('.dl-submit') as HTMLButtonElement | null;
    if (!card || !submit) return;

    form.noValidate = true;

    const ts = form.querySelector<HTMLInputElement>('[data-key="_dl_ts"]');
    if (ts) ts.value = String(Date.now());

    const wrap = (name: string) =>
      form.querySelector<HTMLElement>(`.dl-field[data-field="${name}"]`);
    const input = (name: string) =>
      form.querySelector<HTMLInputElement>(`[data-key="${name}"]`);

    const touched = new Set<string>();

    function setError(name: string, msg: string | null) {
      const w = wrap(name);
      const el = w?.querySelector<HTMLElement>('.dl-err');
      const ctl = input(name);
      if (!w || !el || !ctl) return;
      if (msg) {
        el.textContent = msg;
        el.hidden = false;
        w.dataset.state = 'invalid';
        ctl.setAttribute('aria-invalid', 'true');
      } else {
        el.textContent = '';
        el.hidden = true;
        ctl.setAttribute('aria-invalid', 'false');
        delete w.dataset.state;
      }
    }

    function setValid(name: string, ok: boolean) {
      const w = wrap(name);
      if (!w) return;
      if (ok) w.dataset.state = 'valid';
      else if (w.dataset.state === 'valid') delete w.dataset.state;
    }

    function hint(name: string, text: string | null) {
      const el = wrap(name)?.querySelector<HTMLElement>('.dl-hint');
      if (!el) return;
      el.textContent = text || '';
      el.hidden = !text;
    }

    function offer(name: string, text: string | null, value = '') {
      const btn = wrap(name)?.querySelector<HTMLButtonElement>('.dl-fill');
      if (!btn) return;
      const label = btn.querySelector<HTMLElement>('.dl-fill-text');
      if (label) label.textContent = text || '';
      btn.dataset.fill = value;
      btn.hidden = !text;
    }

    function check(name: string, opts: { silent?: boolean } = {}): boolean {
      const ctl = input(name);
      if (!ctl) return true;

      if (name === 'dl-consent') {
        const ok = (ctl as HTMLInputElement).checked;
        if (!ok && !opts.silent) setError(name, messages['dl-consent']);
        else setError(name, null);
        return ok;
      }

      const v = ctl.value.trim();
      if (!v) {
        setValid(name, false);
        if (!opts.silent) {
          setError(
            name,
            name === 'dl-email' ? messages['dl-email-empty'] : messages['dl-company'],
          );
        }
        return false;
      }

      let ok = v.length >= 2;
      if (name === 'dl-email') ok = EMAIL_RE.test(v);
      setError(name, ok || opts.silent ? null : messages[name as 'dl-email' | 'dl-company']);
      setValid(name, ok);
      return ok;
    }

    let dismissed = '';

    function reactToEmail() {
      const email = input('dl-email');
      const company = input('dl-company');
      if (!email || !company) return;
      const v = email.value.trim();
      if (!EMAIL_RE.test(v)) {
        hint('dl-email', null);
        offer('dl-company', null);
        return;
      }
      const domain = domainOf(v);
      hint('dl-email', FREE_MAIL.has(domain) ? freeMailHint : null);
      const guess = companyFromDomain(domain);
      if (guess && !company.value.trim() && guess !== dismissed) {
        offer('dl-company', insertLabel(guess), guess);
      } else {
        offer('dl-company', null);
      }
    }

    form.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.dl-fill');
      if (!btn) return;
      const company = input('dl-company');
      if (!company) return;
      dismissed = btn.dataset.fill || '';
      company.value = dismissed;
      offer('dl-company', null);
      touched.add('dl-company');
      check('dl-company');
      company.focus();
    });

    (['dl-email', 'dl-company'] as const).forEach((name) => {
      const ctl = input(name);
      if (!ctl) return;
      ctl.addEventListener('blur', () => {
        touched.add(name);
        check(name);
        if (name === 'dl-email') reactToEmail();
      });
      ctl.addEventListener('input', () => {
        if (touched.has(name)) {
          check(name, { silent: wrap(name)?.dataset.state !== 'invalid' });
        } else {
          check(name, { silent: true });
        }
        if (name === 'dl-email') reactToEmail();
      });
    });

    const consent = input('dl-consent');
    consent?.addEventListener('change', () => {
      touched.add('dl-consent');
      check('dl-consent');
    });

    const ORDER = ['dl-email', 'dl-company', 'dl-consent'];

    function showDone(email: string) {
      if (!done) return;
      const mailEl = done.querySelector<HTMLElement>('[data-done="email"]');
      if (mailEl) mailEl.textContent = email;
      const h = card!.offsetHeight;
      form.hidden = true;
      done.hidden = false;
      card!.style.minHeight = `${h}px`;
      requestAnimationFrame(() => {
        done.dataset.in = '';
        window.setTimeout(() => {
          card!.style.minHeight = '';
        }, 500);
      });
      done.setAttribute('tabindex', '-1');
      done.focus({ preventScroll: true });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.dataset.busy !== undefined) return;

      ORDER.forEach((n) => touched.add(n));
      const bad = ORDER.filter((n) => !check(n));
      if (formErr) {
        formErr.hidden = true;
        formErr.textContent = '';
      }
      if (bad.length) {
        const first = input(bad[0]);
        first?.focus();
        first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }

      const email = input('dl-email')?.value.trim() || '';

      const hp = form.querySelector<HTMLInputElement>('input[name="website_url"]');
      const startedAt = Number(ts?.value || 0);
      const tooFast = startedAt > 0 && Date.now() - startedAt < 2000;
      if (hp?.value.trim() || tooFast) {
        showDone(email);
        return;
      }

      submit.dataset.busy = '';
      submit.setAttribute('aria-busy', 'true');

      const result = await mlSubmit(mlAction('download'), {
        email,
        company: input('dl-company')?.value.trim(),
      });

      delete submit.dataset.busy;
      submit.removeAttribute('aria-busy');

      if (result.ok) {
        showDone(email);
        trackLead('download_link_requested');
        return;
      }

      if (result.kind === 'email') {
        touched.add('dl-email');
        setError('dl-email', result.message);
        input('dl-email')?.focus();
        return;
      }

      if (formErr) {
        formErr.innerHTML = failedHtml;
        formErr.hidden = false;
      }
    });

    /* Dev affordance: /pobieranie/?dl-preview=success renders the post-submit
       state without sending a real subscription to MailerLite. */
    if (new URLSearchParams(location.search).get('dl-preview') === 'success') {
      showDone('jan@firma.pl');
    }
  }

  document
    .querySelectorAll<HTMLFormElement>('form[data-form="download"]')
    .forEach(initDownloadForm);
</script>
