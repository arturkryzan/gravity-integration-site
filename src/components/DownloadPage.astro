---
/* /pobieranie/ — the conversion page.
 *
 * The WordPress layout buried the only action three screens down: two
 * decorative "downloads" rows whose Pobierz buttons merely anchor-jumped to a
 * MailerLite embed at the bottom of the page, styled by fighting the embed's
 * own markup with !important. Baseline conversion of that funnel: 3.69%
 * (29/785, MailerLite form gAV0lr).
 *
 * This page puts the form in the hero and tells the visitor exactly what
 * happens after submit. Delivery mechanics (verified in MailerLite, not
 * assumed): the form feeds group GRAVITY with double opt-in OFF, and the
 * "Prosta wiadomość powitalna" automation sends the download-link e-mail
 * immediately — subject "Witaj w gravity.integration", sender
 * contact@gravity-integration.com. The success panel repeats those two
 * facts because they are what gets a visitor from "submitted" to "installed".
 *
 * Submission uses the site's native MailerLite pattern (src/scripts/ml-forms.ts)
 * instead of the universal.js embed: same endpoint, same group, same
 * automation trigger, but no third-party script on the page's critical path.
 * With JS off the form POSTs natively to the same endpoint.
 *
 * Every claim in the copy exists elsewhere on the site or in verified account
 * data: 15-minute install (home, kalkulator FAQ), full version with no
 * functional limits and unlimited testing (kalkulator FAQ), free remote
 * support for the first project (kalkulator FAQ), 139+ connectors and the
 * protocol list (home), Windows (this page's own SEO description), premium
 * technical support included (this page's previous copy), commercial plans
 * from 2 999 PLN/yr (home, cennik). */
import Breadcrumbs from './Breadcrumbs.astro';
import { asset } from '../lib/media';
import { mlAction } from '../lib/mailerlite';
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';

interface Props {
  crumbs?: Array<{ label: string; anchor: string }>;
}
const { crumbs = [] } = Astro.props;

const action = mlAction('download');

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const caseStudiesHref = await linkUrl('case-studies', lang);
const homeHref = await linkUrl('home', lang);

const steps = [
  { n: '1', h: s('dl.step1.h'), p: s('dl.step1.p') },
  { n: '2', h: s('dl.step2.h'), p: s('dl.step2.p') },
  { n: '3', h: s('dl.step3.h'), p: s('dl.step3.p') },
] as const;

const capabilities = [s('dl.cap1Html'), s('dl.cap2Html'), s('dl.cap3Html')] as const;

const clients = [
  { src: '/media/tiptopol-case-logo.png', alt: 'TIP-TOPOL', anchor: 'section0' },
  { src: '/media/kapitan-navi-logo-hires.png', alt: 'Kapitan Navi', anchor: 'section2' },
  { src: '/media/elmet-poznan-logo.png', alt: 'ELMET Poznań S.A.', anchor: 'section4' },
  { src: '/media/nac-logo.png', alt: 'NAC — New American Concept', anchor: 'section6' },
] as const;
---

<div class="dl">
  {/* ============================== hero + form ============================== */}
  <section id="section0" class="dl-hero">
    <div class="dl-wrap dl-hero-grid">
      <div class="dl-hero-copy" data-scroll data-scroll-opacity>
        <h1 class="dl-h1">{s('dl.h1')}</h1>
        <p class="dl-lede">
          {s('dl.lede')}
        </p>
        <ul class="dl-trust" role="list">
          <li>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.2 3.2L15.5 6.4" /></svg>
            {s('dl.trust1')}
          </li>
          <li>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.2 3.2L15.5 6.4" /></svg>
            {s('dl.trust2')}
          </li>
          <li>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.2 3.2L15.5 6.4" /></svg>
            {s('dl.trust3')}
          </li>
        </ul>
      </div>

      <div class="dl-card" data-scroll data-scroll-opacity>
        <form
          action={action}
          method="post"
          target="_blank"
          data-form="download"
          class="dl-form"
          aria-label={s('dl.form.aria')}
        >
          <h2 class="dl-card-h">{s('dl.card.h')}</h2>

          <div class="dl-field" data-field="dl-email">
            <label class="dl-label" for="dl-email">{s('dl.field.email')}</label>
            <div class="dl-control">
              <input
                type="email"
                id="dl-email"
                name="fields[email]"
                data-key="dl-email"
                class="dl-input"
                placeholder={s('dl.field.email.ph')}
                autocomplete="email"
                inputmode="email"
                required
                aria-required="true"
                aria-invalid="false"
                aria-describedby="dl-email-err dl-email-note"
              />
              <svg class="dl-tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4.5 10.5 8.4 14.3 15.6 6.4" pathLength="1" />
              </svg>
            </div>
            <p class="dl-err" id="dl-email-err" aria-live="polite" hidden></p>
            <div class="dl-note" id="dl-email-note" aria-live="polite">
              <p class="dl-hint" hidden></p>
            </div>
          </div>

          <div class="dl-field" data-field="dl-company">
            <label class="dl-label" for="dl-company">{s('dl.field.company')}</label>
            <div class="dl-control">
              <input
                type="text"
                id="dl-company"
                name="fields[company]"
                data-key="dl-company"
                class="dl-input"
                placeholder={s('dl.field.company.ph')}
                autocomplete="organization"
                required
                aria-required="true"
                aria-invalid="false"
                aria-describedby="dl-company-err dl-company-note"
              />
              <svg class="dl-tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4.5 10.5 8.4 14.3 15.6 6.4" pathLength="1" />
              </svg>
            </div>
            <p class="dl-err" id="dl-company-err" aria-live="polite" hidden></p>
            <div class="dl-note" id="dl-company-note" aria-live="polite">
              <p class="dl-hint" hidden></p>
              <button type="button" class="dl-fill" hidden>
                <span class="dl-fill-text"></span>
              </button>
            </div>
          </div>

          {/* Honeypot + fill-time trap: a bot that fills the hidden field or
              submits within two seconds is shown success and never reaches
              MailerLite. Same tripwires as the demo form. */}
          <div class="dl-hp" aria-hidden="true">
            <label for="dl-website-url">Leave this field empty</label>
            <input type="text" id="dl-website-url" name="website_url" value="" autocomplete="off" tabindex="-1" />
          </div>
          <input type="hidden" data-key="_dl_ts" value="" />
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />

          <div class="dl-field" data-field="dl-consent">
            <label class="dl-consent" for="dl-consent">
              <input
                type="checkbox"
                id="dl-consent"
                name="dl-consent"
                data-key="dl-consent"
                value="1"
                required
                aria-required="true"
                aria-invalid="false"
                aria-describedby="dl-consent-err"
              />
              <span class="dl-check" aria-hidden="true">
                <svg viewBox="0 0 20 20" focusable="false">
                  <path d="M4.5 10.4 8.3 14.1 15.5 6.5" pathLength="1" />
                </svg>
              </span>
              <span class="dl-consent-text">
                {s('dl.consent')}
              </span>
            </label>
            <p class="dl-err" id="dl-consent-err" aria-live="polite" hidden></p>
          </div>

          <button type="submit" class="dl-submit">
            <span class="dl-submit-label">{s('dl.submit')}</span>
            <span class="dl-submit-pending" aria-hidden="true">
              <svg class="dl-spinner" viewBox="0 0 20 20" focusable="false">
                <circle cx="10" cy="10" r="7.5" />
                <path d="M10 2.5a7.5 7.5 0 0 1 7.5 7.5" />
              </svg>
              {s('form.sending')}
            </span>
          </button>
          <p class="dl-formerr" role="alert" hidden></p>

          <p class="dl-micro">
            {s('dl.micro')}
          </p>
        </form>

        <div class="dl-done" hidden>
          <svg class="dl-done-tick" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
            <circle cx="22" cy="22" r="20" pathLength="1" />
            <path d="M13 22.5 19.4 28.8 31 16.5" pathLength="1" />
          </svg>
          <h2 class="dl-done-h">{s('dl.done.h')}</h2>
          <p class="dl-done-p">
            {s('dl.done.p1')}<strong data-done="email"></strong>{s('dl.done.p2')}<strong>{s('dl.done.msg')}</strong>{s('dl.done.p3')}
          </p>
          <p class="dl-done-note">
            {s('dl.done.note1')}<a href="https://docs.gravity-integration.com" target="_blank" rel="noopener">
              {s('dl.done.docsLink')}<span class="visually-hidden">{s('a11y.newTab')}</span></a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Breadcrumbs sit between the dark hero and the light content, exactly
      where every other subpage puts them. */}
  {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}

  {/* ============================== 3 steps ============================== */}
  <section id="section1" class="dl-steps" data-scroll data-scroll-opacity>
    <div class="dl-wrap">
      <h2 class="dl-h2">{s('dl.steps.h2')}</h2>
      <ol class="dl-steps-list" role="list">
        {steps.map((s) => (
          <li class="dl-step">
            <span class="dl-step-n" aria-hidden="true">{s.n}</span>
            <h3 class="dl-step-h">{s.h}</h3>
            <p class="dl-step-p">{s.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ========================= what you download ========================= */}
  <section id="section2" class="dl-proof">
    <div class="dl-wrap dl-proof-grid">
      <div class="dl-proof-copy" data-scroll data-scroll-opacity>
        <h2 class="dl-h2">{s('dl.proof.h2')}</h2>
        <ul class="dl-caps" role="list">
          {capabilities.map((c) => (
            <li>
              <span class="dl-dot" aria-hidden="true"></span>
              <span set:html={c} />
            </li>
          ))}
        </ul>
        <p class="dl-spec">
          {s('dl.spec')}
        </p>
      </div>
      <figure class="dl-shot" data-scroll data-scroll-opacity>
        <img
          {...asset('/media/kapitan-navi-gravity-integration-etl.png')}
          alt={s('dl.shot.alt')}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
    <div class="dl-wrap dl-clients" data-scroll data-scroll-opacity>
      <p class="dl-clients-h">{s('dl.clients.h')}</p>
      <ul class="dl-logos" role="list">
        {clients.map((c) => (
          <li>
            <a href={`${caseStudiesHref}#${c.anchor}`} aria-label={`${s('dl.caseAria')}${c.alt}`}>
              {/* asset() carries the src swap and the resampled dimensions
                  together — these four masters were 800x400 and now ship at
                  520x260, so a hard-coded pair here would reserve a box half
                  again too tall. */}
              <img {...asset(c.src)} alt={c.alt} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
      <a class="dl-cases-link" href={caseStudiesHref}>{s('dl.casesLink')}</a>
    </div>
  </section>

  {/* ============================ documentation ============================ */}
  <section id="section3" class="dl-docs">
    <div class="dl-wrap dl-docs-grid">
      <div class="dl-docs-copy" data-scroll data-scroll-opacity>
        <h2 class="dl-h2">{s('dl.docs.h2')}</h2>
        <p class="dl-docs-p" set:html={s('dl.docs.pHtml')} />
        <div class="dl-docs-actions">
          <a
            class="dl-btn dl-btn-solid"
            href="https://docs.gravity-integration.com"
            target="_blank"
            rel="noopener"
          >
            {s('dl.docs.open')}<span class="visually-hidden">{s('a11y.newTab')}</span>
          </a>
          <a
            class="dl-btn dl-btn-ghost"
            href="https://gravityintegration.com/manual/gravity_podrecznik_pl.pdf"
          >
            {s('dl.docs.pdf')}
          </a>
        </div>
      </div>
      <img
        class="dl-docs-img"
        {...asset('/media/manual_mockup.jpg')}
        alt={s('dl.manual.alt')}
        loading="lazy"
        decoding="async"
        data-scroll
        data-scroll-opacity
      />
    </div>
  </section>

  {/* ============================= demo band ============================= */}
  <section class="dl-demo" data-scroll data-scroll-opacity>
    <div class="dl-wrap dl-demo-grid">
      <p class="dl-demo-p">
        {s('dl.band.p1')}<strong>{s('dl.band.strong')}</strong>{s('dl.band.p2')}
      </p>
      <a class="dl-btn dl-btn-solid" href={`${homeHref}#section-demo`}>{s('dl.band.cta')}</a>
    </div>
  </section>
</div>

<style>
  /* Palette: the site's own tokens on two surfaces.
     Measured contrast (WCAG):
       hero lede  rgba(#fff,.84) on #0a0a12  → 13.5:1
       trust      rgba(#fff,.92) on #0a0a12  → 16.2:1
       card label rgba(#fff,.80) on #242538  → 8.6:1
       input ink  #fff           on #16171f  → 18.9:1
       placeholder rgba(#fff,.60) on #16171f → 11.3:1
       micro      rgba(#fff,.72) on #242538  → 7.0:1
       err        #ffc2c2        on #242538  → 8.0:1
       button ink #0a0a12        on #27ea93  → 12.5:1
       body       #464861        on #fff     → 8.9:1
       spec       #5f6178        on #fff     → 6.0:1
       green line #27ea93        on #242538  → 7.4:1 (non-text ok, text no) */
  .dl {
    --ink: #14152a;
    --body: #464861;
    --muted: #5f6178;
    --green: var(--gi-green, #27ea93);
    --green-deep: var(--gi-green-deep, #097a53);
    --dark: var(--gi-bg-dark, #0a0a12);
    --card: var(--gi-bg-card-dark, #242538);
    --well: #16171f;
    --well-focus: #1c1d29;
    --line-dark: rgb(255 255 255 / 0.55);
    --tint: #f3f4fb;
    --line: #e4e5ef;
    --err-text: #ffc2c2;
    --err-line: #ff8f8f;
    --hint: #ffd166;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: Epilogue, system-ui, sans-serif;
    color: var(--body);
  }
  .dl-wrap {
    max-width: var(--gi-container, 1140px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .dl-h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
    max-width: 34rem;
  }

  /* `hidden` vs. Astro's compounded scoped specificity — make it explicit. */
  .dl [hidden] {
    display: none !important;
  }

  /* ------------------------------- hero ------------------------------- */
  .dl-hero {
    background: var(--dark);
    color: #fff;
    padding: calc(var(--gi-bar-h, 44px) + clamp(6rem, 11vw, 8.5rem)) 0 clamp(3rem, 6vw, 4.5rem);
  }
  .dl-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(21rem, 27rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .dl-h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #fff;
    text-wrap: balance;
    max-width: 32rem;
  }
  .dl-lede {
    margin: 0 0 1.75rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.65;
    color: rgb(255 255 255 / 0.84);
    max-width: 30rem;
    text-wrap: pretty;
  }
  .dl-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .dl-trust li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
    font-size: 1rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.92);
  }
  .dl-trust svg {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: rgb(39 234 147 / 0.16);
    padding: 3px;
    box-sizing: border-box;
    fill: none;
    stroke: var(--green);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ------------------------------- form ------------------------------- */
  .dl-card {
    background: var(--card);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--gi-radius-lg, 16px);
    padding: clamp(1.5rem, 3vw, 2rem);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }
  .dl-form {
    /* legacy.css ships a blanket `form{max-width:26.5625rem}` */
    max-width: none;
    display: grid;
    gap: 1.1rem;
  }
  .dl-card-h {
    margin: 0 0 0.25rem;
    font-size: 1.3rem;
    line-height: 1.25;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .dl-label {
    display: block;
    color: rgb(255 255 255 / 0.8);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    margin-bottom: 0.4rem;
  }
  .dl-control {
    position: relative;
  }
  .dl-input {
    width: 100%;
    box-sizing: border-box;
    background: var(--well);
    border: 1px solid var(--line-dark);
    border-radius: 0.5rem;
    padding: 0.7rem 2.4rem 0.7rem 1rem;
    min-height: 2.9rem;
    max-height: none;
    color: #fff;
    font-family: inherit;
    font-size: 1rem; /* ≥16px — smaller zooms the viewport on iOS */
    line-height: 1.4;
    transition:
      border-color 0.18s var(--ease),
      background-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }
  .dl-input::placeholder {
    color: rgb(255 255 255 / 0.6);
    opacity: 1;
  }
  .dl-input:hover {
    background: var(--well-focus);
  }
  .dl-input:focus {
    outline: none;
  }
  .dl-input:focus-visible {
    background: var(--well-focus);
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgb(39 234 147 / 0.28);
  }
  .dl-input:-webkit-autofill,
  .dl-input:-webkit-autofill:hover,
  .dl-input:-webkit-autofill:focus {
    -webkit-box-shadow: inset 0 0 0 40px var(--well-focus) !important;
    -webkit-text-fill-color: #fff !important;
    caret-color: #fff;
  }
  .dl-field[data-state='invalid'] .dl-input {
    border-color: var(--err-line);
  }
  .dl-field[data-state='invalid'] .dl-input:focus-visible {
    box-shadow: 0 0 0 3px rgb(255 143 143 / 0.3);
  }
  .dl-field[data-state='valid'] .dl-input {
    border-color: rgb(39 234 147 / 0.6);
  }
  .dl-tick {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: -0.55rem;
    fill: none;
    stroke: var(--green);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0;
  }
  .dl-tick path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .dl-field[data-state='valid'] .dl-tick {
    opacity: 1;
  }
  .dl-field[data-state='valid'] .dl-tick path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.32s var(--ease);
  }
  .dl-err {
    color: var(--err-text);
    font-size: 0.78rem;
    line-height: 1.4;
    font-weight: 500;
    margin: 0.35rem 0 0;
  }
  .dl-hint {
    color: var(--hint);
    font-size: 0.78rem;
    line-height: 1.45;
    margin: 0.35rem 0 0;
  }
  .dl-fill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.35rem;
    background: rgb(10 10 18 / 0.5);
    color: var(--green);
    border: 1px solid rgb(39 234 147 / 0.45);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition:
      background-color 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }
  .dl-fill:hover {
    background: rgb(10 10 18 / 0.72);
    border-color: var(--green);
  }
  .dl-fill:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  .dl-consent {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.65rem;
    cursor: pointer;
    padding: 0.35rem 0;
    text-transform: none;
    letter-spacing: 0;
    font-size: inherit;
  }
  .dl-consent input {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    opacity: 0;
  }
  .dl-check {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    border: 1px solid var(--line-dark);
    border-radius: 0.3rem;
    background: var(--well);
    display: grid;
    place-items: center;
    margin-top: 0.05rem;
    transition:
      background-color 0.18s var(--ease),
      border-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }
  .dl-check svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: #0a0a12;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dl-check svg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .dl-consent input:checked + .dl-check {
    background: var(--green);
    border-color: var(--green);
  }
  .dl-consent input:checked + .dl-check svg path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.3s var(--ease) 0.04s;
  }
