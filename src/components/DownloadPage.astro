---
/* /pobieranie/ — the conversion page.
 *
 * The WordPress layout buried the only action three screens down: two
 * decorative "downloads" rows whose Pobierz buttons merely anchor-jumped to a
 * MailerLite embed at the bottom of the page, styled by fighting the embed's
 * own markup with !important. Baseline conversion of that funnel: 3.69%
 * (29/785, MailerLite form gAV0lr).
 *
 * This page puts the form in the hero and tells the visitor exactly what
 * happens after submit. Delivery mechanics (verified in MailerLite, not
 * assumed): the form feeds group GRAVITY with double opt-in OFF, and the
 * "Prosta wiadomość powitalna" automation sends the download-link e-mail
 * immediately — subject "Witaj w gravity.integration", sender
 * contact@gravity-integration.com. The success panel repeats those two
 * facts because they are what gets a visitor from "submitted" to "installed".
 *
 * Submission uses the site's native MailerLite pattern (src/scripts/ml-forms.ts)
 * instead of the universal.js embed: same endpoint, same group, same
 * automation trigger, but no third-party script on the page's critical path.
 * With JS off the form POSTs natively to the same endpoint.
 *
 * Every claim in the copy exists elsewhere on the site or in verified account
 * data: 15-minute install (home, kalkulator FAQ), full version with no
 * functional limits and unlimited testing (kalkulator FAQ), free remote
 * support for the first project (kalkulator FAQ), 139+ connectors and the
 * protocol list (home), Windows (this page's own SEO description), premium
 * technical support included (this page's previous copy), commercial plans
 * from 2 999 PLN/yr (home, cennik). */
import Breadcrumbs from './Breadcrumbs.astro';
import { asset } from '../lib/media';
import { mlAction } from '../lib/mailerlite';
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';

interface Props {
  crumbs?: Array<{ label: string; anchor: string }>;
}
const { crumbs = [] } = Astro.props;

const action = mlAction('download');

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const caseStudiesHref = await linkUrl('case-studies', lang);
const homeHref = await linkUrl('home', lang);

const steps = [
  { n: '1', h: s('dl.step1.h'), p: s('dl.step1.p') },
  { n: '2', h: s('dl.step2.h'), p: s('dl.step2.p') },
  { n: '3', h: s('dl.step3.h'), p: s('dl.step3.p') },
] as const;

const capabilities = [s('dl.cap1Html'), s('dl.cap2Html'), s('dl.cap3Html')] as const;

const clients = [
  { src: '/media/tiptopol-case-logo.png', alt: 'TIP-TOPOL', anchor: 'section0' },
  { src: '/media/kapitan-navi-logo-hires.png', alt: 'Kapitan Navi', anchor: 'section2' },
  { src: '/media/elmet-poznan-logo.png', alt: 'ELMET Poznań S.A.', anchor: 'section4' },
  { src: '/media/nac-logo.png', alt: 'NAC — New American Concept', anchor: 'section6' },
] as const;
---

<div class="dl">
  {/* ============================== hero + form ============================== */}
  <section id="section0" class="dl-hero surface-mint">
    <span class="mass dl-hero-mass" aria-hidden="true"></span>
    <div class="container dl-hero-grid">
      <div class="dl-hero-copy" data-reveal>
        <h1 class="dl-h1">{s('dl.h1')}</h1>
        <p class="dl-lede">
          {s('dl.lede')}
        </p>
        <ul class="dl-trust" role="list">
          <li>
            <svg class="dl-trust-check" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 6.5" /></svg>
            {s('dl.trust1')}
          </li>
          <li>
            <svg class="dl-trust-check" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 6.5" /></svg>
            {s('dl.trust2')}
          </li>
          <li>
            <svg class="dl-trust-check" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 6.5" /></svg>
            {s('dl.trust3')}
          </li>
        </ul>
      </div>

      <div class="dl-card" data-reveal>
        <form
          action={action}
          method="post"
          target="_blank"
          data-form="download"
          class="dl-form"
          aria-label={s('dl.form.aria')}
        >
          <h2 class="dl-card-h">{s('dl.card.h')}</h2>

          <div class="dl-field" data-field="dl-email">
            <label class="dl-label" for="dl-email">{s('dl.field.email')}</label>
            <div class="dl-control">
              <input
                type="email"
                id="dl-email"
                name="fields[email]"
                data-key="dl-email"
                class="dl-input"
                placeholder={s('dl.field.email.ph')}
                autocomplete="email"
                inputmode="email"
                required
                aria-required="true"
                aria-invalid="false"
                aria-describedby="dl-email-err dl-email-note"
              />
              <svg class="dl-tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4.5 10.5 8.4 14.3 15.6 6.4" pathLength="1" />
              </svg>
            </div>
            <p class="dl-err" id="dl-email-err" aria-live="polite" hidden></p>
            <div class="dl-note" id="dl-email-note" aria-live="polite">
              <p class="dl-hint" hidden></p>
            </div>
          </div>

          <div class="dl-field" data-field="dl-company">
            <label class="dl-label" for="dl-company">{s('dl.field.company')}</label>
            <div class="dl-control">
              <input
                type="text"
                id="dl-company"
                name="fields[company]"
                data-key="dl-company"
                class="dl-input"
                placeholder={s('dl.field.company.ph')}
                autocomplete="organization"
                required
                aria-required="true"
                aria-invalid="false"
                aria-describedby="dl-company-err dl-company-note"
              />
              <svg class="dl-tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4.5 10.5 8.4 14.3 15.6 6.4" pathLength="1" />
              </svg>
            </div>
            <p class="dl-err" id="dl-company-err" aria-live="polite" hidden></p>
            <div class="dl-note" id="dl-company-note" aria-live="polite">
              <p class="dl-hint" hidden></p>
              <button type="button" class="dl-fill" hidden>
                <span class="dl-fill-text"></span>
              </button>
            </div>
          </div>

          {/* Honeypot + fill-time trap: a bot that fills the hidden field or
              submits within two seconds is shown success and never reaches
              MailerLite. Same tripwires as the demo form. */}
          <div class="dl-hp" aria-hidden="true">
            <label for="dl-website-url">Leave this field empty</label>
            <input type="text" id="dl-website-url" name="website_url" value="" autocomplete="off" tabindex="-1" />
          </div>
          <input type="hidden" data-key="_dl_ts" value="" />
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />

          <div class="dl-field" data-field="dl-consent">
            <label class="dl-consent" for="dl-consent">
              <input
                type="checkbox"
                id="dl-consent"
                name="dl-consent"
                data-key="dl-consent"
                value="1"
                required
                aria-required="true"
                aria-invalid="false"
                aria-describedby="dl-consent-err"
              />
              <span class="dl-check" aria-hidden="true">
                <svg viewBox="0 0 20 20" focusable="false">
                  <path d="M4.5 10.4 8.3 14.1 15.5 6.5" pathLength="1" />
                </svg>
              </span>
              <span class="dl-consent-text">
                {s('dl.consent')}
              </span>
            </label>
            <p class="dl-err" id="dl-consent-err" aria-live="polite" hidden></p>
          </div>

          <button type="submit" class="dl-submit">
            <span class="dl-submit-label">{s('dl.submit')}</span>
            <span class="dl-submit-pending" aria-hidden="true">
              <svg class="dl-spinner" viewBox="0 0 20 20" focusable="false">
                <circle cx="10" cy="10" r="7.5" />
                <path d="M10 2.5a7.5 7.5 0 0 1 7.5 7.5" />
              </svg>
              {s('form.sending')}
            </span>
          </button>
          <p class="dl-formerr" role="alert" hidden></p>

          <p class="dl-micro">
            {s('dl.micro')}
          </p>
        </form>

        <div class="dl-done" hidden>
          <svg class="dl-done-tick" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
            <circle cx="22" cy="22" r="20" pathLength="1" />
            <path d="M13 22.5 19.4 28.8 31 16.5" pathLength="1" />
          </svg>
          <h2 class="dl-done-h">{s('dl.done.h')}</h2>
          <p class="dl-done-p">
            {s('dl.done.p1')}<strong data-done="email"></strong>{s('dl.done.p2')}<strong>{s('dl.done.msg')}</strong>{s('dl.done.p3')}
          </p>
          {/* Absolute, not root-relative: the installer lives on the production
              host, and a preview build served from anywhere else should still
              hand out the real file rather than a 404 that looks like a broken
              download. `download` is honoured because this is same-origin in
              production; it also names the file the browser saves. */}
          <p class="dl-done-direct">
            {s('dl.done.direct1')}<a
              class="dl-done-exe"
              href="https://gravity-integration.com/downloads/GravityInstaller.exe"
              download
              data-direct-download
            >{s('dl.done.directLink')}</a>{s('dl.done.direct2')}
          </p>
          <p class="dl-done-note">
            {s('dl.done.note1')}<a href="https://docs.gravity-integration.com" target="_blank" rel="noopener">
              {s('dl.done.docsLink')}<span class="visually-hidden">{s('a11y.newTab')}</span></a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Breadcrumbs sit between the dark hero and the light content, exactly
      where every other subpage puts them. */}
  {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}

  {/* ============================== 3 steps ============================== */}
  <section id="section1" class="dl-steps section surface-white" data-reveal>
    <div class="container">
      <h2 class="dl-h2">{s('dl.steps.h2')}</h2>
      <ol class="dl-steps-list" role="list">
        {steps.map((s) => (
          <li class="dl-step">
            <span class="dl-step-n" aria-hidden="true">{s.n}</span>
            <h3 class="dl-step-h">{s.h}</h3>
            <p class="dl-step-p">{s.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ========================= what you download ========================= */}
  <section id="section2" class="dl-proof section surface-mist">
    <div class="container dl-proof-grid">
      <div class="dl-proof-copy" data-reveal>
        <h2 class="dl-h2">{s('dl.proof.h2')}</h2>
        <ul class="dl-caps" role="list">
          {capabilities.map((c) => (
            <li>
              <span class="dl-dot" aria-hidden="true"></span>
              <span set:html={c} />
            </li>
          ))}
        </ul>
        <p class="dl-spec">
          {s('dl.spec')}
        </p>
      </div>
      <figure class="dl-shot" data-reveal>
        <img
          {...asset('/media/kapitan-navi-gravity-integration-etl.png')}
          alt={s('dl.shot.alt')}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
    <div class="container dl-clients" data-reveal>
      <p class="dl-clients-h">{s('dl.clients.h')}</p>
      <ul class="dl-logos" role="list">
        {clients.map((c) => (
          <li>
            <a href={`${caseStudiesHref}#${c.anchor}`} aria-label={`${s('dl.caseAria')}${c.alt}`}>
              {/* asset() carries the src swap and the resampled dimensions
                  together — these four masters were 800x400 and now ship at
                  520x260, so a hard-coded pair here would reserve a box half
                  again too tall. */}
              <img {...asset(c.src)} alt={c.alt} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
      <a class="dl-cases-link" href={caseStudiesHref}>{s('dl.casesLink')}</a>
    </div>
  </section>

  {/* ============================ documentation ============================ */}
  <section id="section3" class="dl-docs section surface-white">
    <div class="container dl-docs-grid">
      <div class="dl-docs-copy" data-reveal>
        <h2 class="dl-h2">{s('dl.docs.h2')}</h2>
        <p class="dl-docs-p" set:html={s('dl.docs.pHtml')} />
        <div class="dl-docs-actions">
          <a
            class="btn btn--primary btn--lg"
            href="https://docs.gravity-integration.com"
            target="_blank"
            rel="noopener"
          >
            {s('dl.docs.open')}<span class="visually-hidden">{s('a11y.newTab')}</span>
          </a>
          <a
            class="btn btn--secondary btn--lg"
            href="https://gravityintegration.com/manual/gravity_podrecznik_pl.pdf"
          >
            {s('dl.docs.pdf')}
          </a>
        </div>
      </div>
      <img
        class="dl-docs-img"
        {...asset('/media/manual_mockup.jpg')}
        alt={s('dl.manual.alt')}
        loading="lazy"
        decoding="async"
        data-reveal
      />
    </div>
  </section>

  {/* ============================= demo band ============================= */}
  <section class="dl-demo section surface-white">
    <div class="container">
      <div class="dl-demo-card surface-ink" data-reveal>
        <p class="dl-demo-p">
          {s('dl.band.p1')}<strong>{s('dl.band.strong')}</strong>{s('dl.band.p2')}
        </p>
        <a class="btn btn--accent btn--lg" href={`${homeHref}#section-demo`}>{s('dl.band.cta')}<span class="btn-dot" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
</div>

<style>
  /* ---------------------------------------------------------------
     v2. The hero is the mint field with the form card on it; the ink mass
     is cropped bottom-right behind the card — mint over ink, white over
     both, depth by colour alone. The H1 is ink on mint (the allowed pair):
     next to a form, the headline has to read first, before the frame.

     Every class the runtime and the harness address (.dl-field[data-field],
     .dl-err, .dl-hint, .dl-fill, .dl-submit, .dl-done, .dl-done-exe, the
     ids) is unchanged from v1.
     --------------------------------------------------------------- */

  /* ================= hero ================= */
  .dl-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 112px);
  }
  .dl-hero-mass {
    z-index: -1;
    width: clamp(520px, 52vw, 820px);
    right: clamp(-320px, -16vw, -140px);
    bottom: clamp(-460px, -26vw, -240px);
  }
  .dl-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  @media (min-width: 960px) {
    .dl-h1 {
      font-size: min(4.6vw, 56px);
    }
    .dl-hero-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: clamp(40px, 6vw, 96px);
    }
  }
  .dl-hero-copy {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  /* "gravity.integration" is one long word, so the size is set by it: the
     line has to hold it whole. */
  .dl-h1 {
    font: 800 clamp(28px, 9.6vw, 56px) / 0.92 var(--font-sans);
    letter-spacing: -0.06em;
    color: var(--ink-900);
    text-wrap: balance;
  }
  .dl-lede {
    max-width: 34rem;
    font: 400 var(--fs-body-lg) / 1.55 var(--font-sans);
    color: var(--ink-900);
    text-wrap: pretty;
  }
  .dl-trust {
    list-style: none;
    display: grid;
    gap: 10px;
    margin-top: 4px;
  }
  .dl-trust li {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 600 15px / 1.3 var(--font-sans);
    color: var(--ink-900);
  }
  .dl-trust-check {
    flex: none;
    width: 24px;
    height: 24px;
    padding: 4px;
    border-radius: 50%;
    background: var(--ink-900);
    fill: none;
    stroke: var(--mint-500);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ================= the card ================= */
  .dl-card {
    position: relative;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-xl);
    background: var(--white);
    color: var(--ink-900);
    --focus-gap: var(--ink-900);
    --focus-ring: var(--mint-500);
    --underline: var(--mint-500);
  }
  .dl-form {
    display: grid;
    gap: 18px;
  }
  .dl-card-h {
    font: 800 var(--fs-h3) / 1.05 var(--font-sans);
    letter-spacing: -0.045em;
    margin-bottom: 4px;
  }
  .dl-field {
    display: grid;
    gap: 6px;
  }
  .dl-label {
    font: 600 13px / 1.3 var(--font-sans);
    color: var(--ink-900);
  }
  .dl-control {
    position: relative;
  }
  .dl-input {
    width: 100%;
    min-height: 48px;
    padding: 0 40px 0 14px;
    border: 1.5px solid var(--mist-200);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--ink-900);
    font: 400 16px / 1.3 var(--font-sans);
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }
  .dl-input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .dl-input:hover {
    border-color: var(--slate-400);
  }
  .dl-input:focus,
  .dl-input:focus-visible {
    outline: none;
    border-color: var(--ink-900);
    box-shadow:
      0 0 0 2px var(--focus-gap),
      0 0 0 5px var(--focus-ring);
  }
  .dl-field[data-state='invalid'] .dl-input {
    border-color: var(--red-500);
  }
  .dl-field[data-state='valid'] .dl-input {
    border-color: var(--ink-900);
  }
  .dl-tick {
    position: absolute;
    right: 13px;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    fill: none;
    stroke: var(--mint-800);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0;
  }
  .dl-tick path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .dl-field[data-state='valid'] .dl-tick {
    opacity: 1;
  }
  .dl-field[data-state='valid'] .dl-tick path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-fall);
  }
  .dl-err {
    font: 500 12px / 1.45 var(--font-sans);
    color: var(--red-700);
  }
  .dl-hint {
    display: flex;
    gap: 8px;
    font: 400 12px / 1.45 var(--font-sans);
    color: var(--slate-600);
  }
  .dl-hint::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--amber-500);
  }
  .dl-fill {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    margin-top: 2px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--mint-100);
    color: var(--ink-900);
    font: 600 12px / 1.2 var(--font-sans);
    cursor: pointer;
  }
  .dl-fill:hover {
    background: var(--mist-200);
  }
  .dl-hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .dl-consent {
    position: relative;
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: start;
    gap: 10px;
    padding: 4px 0;
    cursor: pointer;
  }
  .dl-consent input {
    position: absolute;
    top: 4px;
    left: 0;
    width: 20px;
    height: 20px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .dl-check {
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border: 1.5px solid var(--ink-900);
    border-radius: var(--radius-sm);
    background: var(--white);
    display: grid;
    place-items: center;
    transition: background-color var(--dur-fast) ease;
  }
  .dl-check svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--mint-500);
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dl-check svg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .dl-consent input:checked + .dl-check {
    background: var(--ink-900);
  }
  .dl-consent input:checked + .dl-check svg path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-base) var(--ease-fall);
  }
  .dl-consent input:focus-visible + .dl-check {
    box-shadow:
      0 0 0 2px var(--focus-gap),
      0 0 0 5px var(--focus-ring);
  }
  .dl-field[data-state='invalid'] .dl-check {
    border-color: var(--red-500);
  }
  .dl-consent-text {
    font: 400 13px / 1.5 var(--font-sans);
    color: var(--slate-600);
  }

  /* the view's one mint accent */
  .dl-submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 0 28px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--mint-500);
    color: var(--ink-900);
    font: 600 15px / 1.15 var(--font-sans);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur-fast) ease;
  }
  .dl-submit:hover {
    background: var(--mint-600);
  }
  .dl-submit:active {
    transform: scale(0.97);
  }
  .dl-submit-label,
  .dl-submit-pending {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    transition: opacity var(--dur-fast) ease;
  }
  .dl-submit-pending {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .dl-submit[data-busy] {
    cursor: progress;
  }
  .dl-submit[data-busy] .dl-submit-label {
    opacity: 0;
  }
  .dl-submit[data-busy] .dl-submit-pending {
    opacity: 1;
  }
  .dl-spinner {
    width: 18px;
    height: 18px;
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    animation: dl-spin 0.75s linear infinite;
  }
  .dl-spinner circle {
    stroke: rgb(30 31 51 / 0.2);
  }
  .dl-spinner path {
    stroke: var(--ink-900);
  }
  @keyframes dl-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .dl-formerr {
    font: 500 13px / 1.5 var(--font-sans);
    color: var(--red-700);
  }
  .dl-formerr :global(a) {
    color: var(--red-700);
  }
  .dl-micro {
    font: 400 13px / 1.5 var(--font-sans);
    color: var(--muted);
  }

  /* ---- success ---- */
  .dl-done {
    display: grid;
    justify-items: start;
    gap: 12px;
  }
  .dl-done:focus {
    outline: none;
  }
  .dl-done:focus-visible {
    outline: 3px solid var(--mint-500);
    outline-offset: 8px;
    border-radius: var(--radius-md);
  }
  .dl-done-tick {
    width: 56px;
    height: 56px;
    margin-bottom: 8px;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dl-done-tick circle {
    fill: var(--ink-900);
    stroke: var(--ink-900);
    stroke-width: 2;
  }
  .dl-done-tick path {
    stroke: var(--mint-500);
    stroke-width: 2.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .dl-done[data-in] .dl-done-tick path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-fall) 0.2s;
  }
  .dl-done-h {
    font: 800 var(--fs-h3) / 1.05 var(--font-sans);
    letter-spacing: -0.05em;
  }
  .dl-done-p {
    font: 400 16px / 1.6 var(--font-sans);
    color: var(--slate-600);
  }
  .dl-done-p strong {
    color: var(--ink-900);
    font-weight: 600;
    word-break: break-word;
  }
  .dl-done-direct {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--mint-100);
    font: 400 var(--fs-body) / 1.5 var(--font-sans);
    color: var(--ink-900);
  }
  .dl-done-exe {
    font-weight: 600;
    color: var(--ink-900);
    text-decoration-color: var(--ink-900);
  }
  .dl-done-note {
    font: 400 13px / 1.55 var(--font-sans);
    color: var(--slate-600);
  }
  .dl-done[data-in] .dl-done-h,
  .dl-done[data-in] .dl-done-p,
  .dl-done[data-in] .dl-done-direct,
  .dl-done[data-in] .dl-done-note {
    animation: dl-rise var(--dur-slow) var(--ease-fall) both;
  }
  .dl-done[data-in] .dl-done-p {
    animation-delay: 60ms;
  }
  .dl-done[data-in] .dl-done-direct {
    animation-delay: 120ms;
  }
  .dl-done[data-in] .dl-done-note {
    animation-delay: 180ms;
  }
  @keyframes dl-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* ================= steps ================= */
  .dl-h2 {
    max-width: 18em;
    font: 800 var(--fs-h2) / 1 var(--font-sans);
    letter-spacing: -0.055em;
    color: var(--fg);
    text-wrap: balance;
  }
  .dl-steps-list {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin-top: clamp(32px, 5vw, 56px);
  }
  @media (min-width: 860px) {
    .dl-steps-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }
  }
  .dl-step {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  /* the steps are joined by a hairline from one numbered satellite to the
     next */
  @media (min-width: 860px) {
    .dl-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 22px;
      left: 60px;
      right: -28px;
      height: 1px;
      background: var(--mist-200);
    }
  }
  .dl-step-n {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--ink-900);
    color: var(--mint-500);
    font: 500 14px / 1 var(--font-mono);
  }
  .dl-step-h {
    font: 600 var(--fs-h4) / 1.2 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .dl-step-p {
    font: 400 16px / 1.6 var(--font-sans);
    color: var(--slate-600);
  }

  /* ================= what you download ================= */
  .dl-proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .dl-proof-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(48px, 6vw, 96px);
    }
  }
  .dl-proof-copy {
    display: grid;
    gap: 24px;
  }
  .dl-caps {
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .dl-caps li {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    font: 400 16px / 1.6 var(--font-sans);
    color: var(--slate-600);
  }
  .dl-caps :global(strong) {
    font-weight: 600;
    color: var(--ink-900);
  }
  .dl-dot {
    width: 8px;
    height: 8px;
    margin-top: 0.62em;
    border-radius: 50%;
    background: var(--ink-900);
  }
  .dl-spec {
    font: 400 14px / 1.6 var(--font-sans);
    color: var(--slate-600);
  }
  .dl-shot {
    overflow: hidden;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .dl-shot img {
    width: 100%;
  }
  .dl-clients {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 32px;
    border-top: 1px solid var(--mist-200);
  }
  .dl-clients-h {
    font: 500 12px / 1.3 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--slate-600);
  }
  .dl-logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .dl-logos a {
    display: grid;
    place-items: center;
    width: 112px;
    height: 56px;
    padding: 8px 14px;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-md);
    background: var(--white);
    transition: transform 0.2s var(--ease-fall);
  }
  .dl-logos a:hover {
    transform: translateY(-3px);
  }
  .dl-logos img {
    width: auto;
    max-width: 100%;
    max-height: 36px;
    object-fit: contain;
  }
  .dl-cases-link {
    font: 600 14px / 1.2 var(--font-sans);
    color: var(--ink-900);
    text-underline-offset: 5px;
  }

  /* ================= documentation ================= */
  .dl-docs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .dl-docs-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(48px, 6vw, 96px);
    }
  }
  .dl-docs-copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .dl-docs-p {
    max-width: 36rem;
    font: 400 var(--fs-body-lg) / 1.6 var(--font-sans);
    color: var(--slate-600);
  }
  .dl-docs-p :global(strong) {
    font-weight: 600;
    color: var(--ink-900);
  }
  .dl-docs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }
  .dl-docs-img {
    width: 100%;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-xl);
  }

  /* ================= demo band ================= */
  .dl-demo {
    padding-top: 0;
  }
  .dl-demo-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding: clamp(28px, 4vw, 48px) clamp(28px, 5vw, 56px);
    border-radius: var(--radius-xl);
  }
  .dl-demo-p {
    max-width: 44rem;
    font: 400 var(--fs-body-lg) / 1.55 var(--font-sans);
    color: var(--on-ink-soft);
  }
  .dl-demo-p strong {
    font-weight: 800;
    color: var(--mint-500);
  }

  @media (max-width: 959.98px) {
    .dl-hero {
      padding-bottom: 160px;
    }
    .dl-hero-mass {
      width: 460px;
      right: -160px;
      bottom: -320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dl *,
    .dl *::before,
    .dl *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
    .dl-spinner {
      animation: dl-spin 2.4s linear infinite !important;
    }
    .dl-tick path,
    .dl-check svg path,
    .dl-done-tick path {
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script>
  /* Same "smart & instant" runtime as the demo form, reduced to two fields.
     With JS off the form POSTs natively to MailerLite and the link still goes
     out — this layer keeps the visitor on the page and answers them. */
  import { mlAction } from '../lib/mailerlite';
  import { mlSubmit, trackDownloadConversion, trackLead } from '../scripts/ml-forms';
  import { pick } from '../i18n/client';

  const FREE_MAIL = new Set([
    'gmail.com', 'googlemail.com', 'wp.pl', 'o2.pl', 'onet.pl', 'onet.eu',
    'poczta.onet.pl', 'interia.pl', 'interia.eu', 'op.pl', 'vp.pl', 'tlen.pl',
    'go2.pl', 'autograf.pl', 'buziaczek.pl', 'poczta.fm', 'gazeta.pl',
    'yahoo.com', 'yahoo.pl', 'outlook.com', 'outlook.pl', 'hotmail.com',
    'hotmail.pl', 'live.com', 'msn.com', 'icloud.com', 'me.com', 'mac.com',
    'aol.com', 'gmx.com', 'gmx.net', 'gmx.de', 'proton.me', 'protonmail.com',
    'pm.me', 'zoho.com', 'yandex.ru', 'mail.ru',
  ]);
  const MULTI_TLD = new Set([
    'com.pl', 'net.pl', 'org.pl', 'edu.pl', 'gov.pl', 'info.pl', 'biz.pl',
    'waw.pl', 'co.uk', 'org.uk', 'com.de', 'co.jp', 'com.au',
  ]);
  const EMAIL_RE = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/;

  /* This bundle is shared by both language trees, so the copy picks its
     language at runtime off <html lang> (src/i18n/client.ts). */
  const messages = pick({
    pl: {
      'dl-email': 'Ten adres wygląda na niepełny. Sprawdź go jeszcze raz.',
      'dl-email-empty': 'Bez adresu e-mail nie mamy jak wysłać linku.',
      'dl-company': 'Podaj nazwę firmy — przygotujemy się do ewentualnych pytań o Wasze systemy.',
      'dl-consent': 'Potrzebujemy tej zgody, żeby móc wysłać link.',
    },
    en: {
      'dl-email': 'That address looks incomplete. Give it another check.',
      'dl-email-empty': 'Without an e-mail address we have nowhere to send the link.',
      'dl-company': "Tell us the company name — we'll be ready for any questions about your systems.",
      'dl-consent': 'We need this consent to be able to send the link.',
    },
  });
  const freeMailHint = pick({
    pl: 'To adres prywatny. Link zadziała, ale na służbowy dorzucimy materiały dla zespołu.',
    en: "That's a personal address. The link will work, but a work one gets extra team materials.",
  });
  const insertLabel = pick<(g: string) => string>({
    pl: (g) => `Wstaw „${g}”`,
    en: (g) => `Insert "${g}"`,
  });
  const failedHtml = pick({
    pl:
      'Nie udało się wysłać formularza. Napisz prosto do nas na ' +
      '<a href="mailto:contact@caffeine-minds.com?subject=Pobieranie%20gravity.integration">' +
      'contact@caffeine-minds.com</a> — wyślemy link ręcznie.',
    en:
      "The form didn't go through. Write to us directly at " +
      '<a href="mailto:contact@caffeine-minds.com?subject=Pobieranie%20gravity.integration">' +
      "contact@caffeine-minds.com</a> — we'll send the link by hand.",
  });

  function domainOf(email: string): string {
    const at = email.lastIndexOf('@');
    return at === -1 ? '' : email.slice(at + 1).trim().toLowerCase();
  }

  function companyFromDomain(domain: string): string {
    if (!domain || FREE_MAIL.has(domain)) return '';
    const parts = domain.replace(/^www\./, '').split('.');
    if (parts.length < 2) return '';
    const last2 = parts.slice(-2).join('.');
    const core = MULTI_TLD.has(last2) ? parts.slice(0, -2) : parts.slice(0, -1);
    let label = core[core.length - 1] || '';
    if (['mail', 'poczta', 'smtp', 'email', 'grupa'].includes(label) && core.length > 1) {
      label = core[core.length - 2];
    }
    if (!label || label.length < 2 || /^\d+$/.test(label)) return '';
    return label
      .split(/[-_]+/)
      .filter(Boolean)
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
  }

  function initDownloadForm(form: HTMLFormElement) {
    const card = form.closest('.dl-card') as HTMLElement | null;
    const done = card?.querySelector('.dl-done') as HTMLElement | null;
    const formErr = form.querySelector('.dl-formerr') as HTMLElement | null;
    const submit = form.querySelector('.dl-submit') as HTMLButtonElement | null;
    if (!card || !submit) return;

    form.noValidate = true;

    /* The direct-download link is deliberately NOT a trackLead() call. By the
       time it can be clicked the address is already in MailerLite and
       generate_lead has fired once; firing it again would count one person
       twice. A plain dataLayer push keeps the two paths apart — how many
       people wait for the e-mail, how many take the file straight away — and
       stays silent when consent hasn't been given, because dataLayer only
       exists once the banner is accepted. */
    done
      ?.querySelector<HTMLAnchorElement>('[data-direct-download]')
      ?.addEventListener('click', () => {
        (window as any).dataLayer?.push({ event: 'direct_download' });
      });

    const ts = form.querySelector<HTMLInputElement>('[data-key="_dl_ts"]');
    if (ts) ts.value = String(Date.now());

    const wrap = (name: string) =>
      form.querySelector<HTMLElement>(`.dl-field[data-field="${name}"]`);
    const input = (name: string) =>
      form.querySelector<HTMLInputElement>(`[data-key="${name}"]`);

    const touched = new Set<string>();

    function setError(name: string, msg: string | null) {
      const w = wrap(name);
      const el = w?.querySelector<HTMLElement>('.dl-err');
      const ctl = input(name);
      if (!w || !el || !ctl) return;
      if (msg) {
        el.textContent = msg;
        el.hidden = false;
        w.dataset.state = 'invalid';
        ctl.setAttribute('aria-invalid', 'true');
      } else {
        el.textContent = '';
        el.hidden = true;
        ctl.setAttribute('aria-invalid', 'false');
        delete w.dataset.state;
      }
    }

    function setValid(name: string, ok: boolean) {
      const w = wrap(name);
      if (!w) return;
      if (ok) w.dataset.state = 'valid';
      else if (w.dataset.state === 'valid') delete w.dataset.state;
    }

    function hint(name: string, text: string | null) {
      const el = wrap(name)?.querySelector<HTMLElement>('.dl-hint');
      if (!el) return;
      el.textContent = text || '';
      el.hidden = !text;
    }

    function offer(name: string, text: string | null, value = '') {
      const btn = wrap(name)?.querySelector<HTMLButtonElement>('.dl-fill');
      if (!btn) return;
      const label = btn.querySelector<HTMLElement>('.dl-fill-text');
      if (label) label.textContent = text || '';
      btn.dataset.fill = value;
      btn.hidden = !text;
    }

    function check(name: string, opts: { silent?: boolean } = {}): boolean {
      const ctl = input(name);
      if (!ctl) return true;

      if (name === 'dl-consent') {
        const ok = (ctl as HTMLInputElement).checked;
        if (!ok && !opts.silent) setError(name, messages['dl-consent']);
        else setError(name, null);
        return ok;
      }

      const v = ctl.value.trim();
      if (!v) {
        setValid(name, false);
        if (!opts.silent) {
          setError(
            name,
            name === 'dl-email' ? messages['dl-email-empty'] : messages['dl-company'],
          );
        }
        return false;
      }

      let ok = v.length >= 2;
      if (name === 'dl-email') ok = EMAIL_RE.test(v);
      setError(name, ok || opts.silent ? null : messages[name as 'dl-email' | 'dl-company']);
      setValid(name, ok);
      return ok;
    }

    let dismissed = '';

    function reactToEmail() {
      const email = input('dl-email');
      const company = input('dl-company');
      if (!email || !company) return;
      const v = email.value.trim();
      if (!EMAIL_RE.test(v)) {
        hint('dl-email', null);
        offer('dl-company', null);
        return;
      }
      const domain = domainOf(v);
      hint('dl-email', FREE_MAIL.has(domain) ? freeMailHint : null);
      const guess = companyFromDomain(domain);
      if (guess && !company.value.trim() && guess !== dismissed) {
        offer('dl-company', insertLabel(guess), guess);
      } else {
        offer('dl-company', null);
      }
    }

    form.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.dl-fill');
      if (!btn) return;
      const company = input('dl-company');
      if (!company) return;
      dismissed = btn.dataset.fill || '';
      company.value = dismissed;
      offer('dl-company', null);
      touched.add('dl-company');
      check('dl-company');
      company.focus();
    });

    (['dl-email', 'dl-company'] as const).forEach((name) => {
      const ctl = input(name);
      if (!ctl) return;
      ctl.addEventListener('blur', () => {
        touched.add(name);
        check(name);
        if (name === 'dl-email') reactToEmail();
      });
      ctl.addEventListener('input', () => {
        if (touched.has(name)) {
          check(name, { silent: wrap(name)?.dataset.state !== 'invalid' });
        } else {
          check(name, { silent: true });
        }
        if (name === 'dl-email') reactToEmail();
      });
    });

    const consent = input('dl-consent');
    consent?.addEventListener('change', () => {
      touched.add('dl-consent');
      check('dl-consent');
    });

    const ORDER = ['dl-email', 'dl-company', 'dl-consent'];

    function showDone(email: string) {
      if (!done) return;
      const mailEl = done.querySelector<HTMLElement>('[data-done="email"]');
      if (mailEl) mailEl.textContent = email;
      const h = card!.offsetHeight;
      form.hidden = true;
      done.hidden = false;
      card!.style.minHeight = `${h}px`;
      requestAnimationFrame(() => {
        done.dataset.in = '';
        window.setTimeout(() => {
          card!.style.minHeight = '';
        }, 500);
      });
      done.setAttribute('tabindex', '-1');
      done.focus({ preventScroll: true });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.dataset.busy !== undefined) return;

      ORDER.forEach((n) => touched.add(n));
      const bad = ORDER.filter((n) => !check(n));
      if (formErr) {
        formErr.hidden = true;
        formErr.textContent = '';
      }
      if (bad.length) {
        const first = input(bad[0]);
        first?.focus();
        first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }

      const email = input('dl-email')?.value.trim() || '';

      const hp = form.querySelector<HTMLInputElement>('input[name="website_url"]');
      const startedAt = Number(ts?.value || 0);
      const tooFast = startedAt > 0 && Date.now() - startedAt < 2000;
      if (hp?.value.trim() || tooFast) {
        showDone(email);
        return;
      }

      submit.dataset.busy = '';
      submit.setAttribute('aria-busy', 'true');

      const result = await mlSubmit(mlAction('download'), {
        email,
        company: input('dl-company')?.value.trim(),
      });

      delete submit.dataset.busy;
      submit.removeAttribute('aria-busy');

      if (result.ok) {
        showDone(email);
        trackLead('download_link_requested');
        /* The same moment, told to Google Ads as the campaign's conversion.
           Separate call on purpose: generate_lead stays the one GA4 lead
           metric shared by all four forms, while this addresses the download's
           own conversion action — the number the Ads campaign bids against. */
        trackDownloadConversion();
        return;
      }

      if (result.kind === 'email') {
        touched.add('dl-email');
        setError('dl-email', result.message);
        input('dl-email')?.focus();
        return;
      }

      if (formErr) {
        formErr.innerHTML = failedHtml;
        formErr.hidden = false;
      }
    });

    /* Dev affordance: /pobieranie/?dl-preview=success renders the post-submit
       state without sending a real subscription to MailerLite. */
    if (new URLSearchParams(location.search).get('dl-preview') === 'success') {
      showDone('jan@firma.pl');
    }
  }

  document
    .querySelectorAll<HTMLFormElement>('form[data-form="download"]')
    .forEach(initDownloadForm);
</script>
