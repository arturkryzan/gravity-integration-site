---
/* Dedicated editorial layout for /czym-jest-esb/ — the SEO cornerstone page.
   Copy is pulled VERBATIM from esb-content.json (extracted from the CMS content,
   not rewritten). Only presentation changes: real hierarchy, designed lists,
   a meaningful point-to-point-vs-ESB diagram, a distinct pull-quote, cleaner FAQ. */
/* One content file per language, picked off the URL's locale — same shape,
   same renderer. WhatIsEsb.astro makes the same choice for the breadcrumbs. */
import esbPl from '../data/esb-content.json';
import esbEn from '../data/esb-content.en.json';
import { localeOf, t } from '../i18n/ui';

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const esb = lang === 'en' ? esbEn : esbPl;

/* ---- diagram geometry: 6 systems in a hexagon ---- */
const R = 132;
const cx = 190;
const cy = 175;
const labels = ['ERP', 'WMS', 'CRM', 'e‑Commerce', 'MES', 'API'];
const nodes = labels.map((label, i) => {
  const a = (-90 + i * 60) * (Math.PI / 180);
  return { label, x: cx + R * Math.cos(a), y: cy + R * Math.sin(a) };
});
/* full mesh edges (point-to-point) */
const mesh: Array<[number, number]> = [];
for (let i = 0; i < nodes.length; i++)
  for (let j = i + 1; j < nodes.length; j++) mesh.push([i, j]);
const NW = 64; // node box half-width
const NH = 17; // node box half-height
---

<article class="esb">
  {/* ---------- intro / definition ---------- */}
  <section id="section0" class="esb-band">
    <div class="esb-wrap esb-prose">
      <p class="esb-lede" set:html={esb.intro[0]} />
      <p set:html={esb.intro[1]} />
    </div>
  </section>

  {/* ---------- point-to-point vs ESB diagram ---------- */}
  <section class="esb-band esb-band--tint">
    <div class="esb-wrap">
      <div class="esb-diagram">
        <figure class="esb-panel">
          <figcaption><span class="esb-tag esb-tag--warn">{s('esb.tag.p2p')}</span></figcaption>
          <svg viewBox="0 0 380 350" role="img" aria-label={s('esb.aria.p2p')}>
            {mesh.map(([i, j]) => (
              <line
                x1={nodes[i].x} y1={nodes[i].y}
                x2={nodes[j].x} y2={nodes[j].y}
                stroke="#c3c6da" stroke-width="1.5"
              />
            ))}
            {nodes.map((n) => (
              <g>
                <rect
                  x={n.x - NW} y={n.y - NH} width={NW * 2} height={NH * 2}
                  rx="9" fill="#fff" stroke="#464861" stroke-width="1.5"
                />
                <text x={n.x} y={n.y + 4.5} text-anchor="middle" class="esb-node-t">{n.label}</text>
              </g>
            ))}
          </svg>
        </figure>

        <figure class="esb-panel">
          <figcaption><span class="esb-tag esb-tag--ok">{s('esb.tag.bus')}</span></figcaption>
          <svg viewBox="0 0 380 350" role="img" aria-label={s('esb.aria.bus')}>
            {nodes.map((n) => (
              <line x1={n.x} y1={n.y} x2={cx} y2={cy} stroke="#27ea93" stroke-width="2" />
            ))}
            {/* central bus / hub */}
            <circle cx={cx} cy={cy} r="42" fill="#27ea93" />
            <circle cx={cx} cy={cy} r="42" fill="none" stroke="#0a0a12" stroke-opacity="0.06" stroke-width="1" />
            <text x={cx} y={cy - 2} text-anchor="middle" class="esb-hub-t">ESB</text>
            <text x={cx} y={cy + 14} text-anchor="middle" class="esb-hub-s">{s('esb.hub.sub')}</text>
            {nodes.map((n) => (
              <g>
                <rect
                  x={n.x - NW} y={n.y - NH} width={NW * 2} height={NH * 2}
                  rx="9" fill="#fff" stroke="#464861" stroke-width="1.5"
                />
                <text x={n.x} y={n.y + 4.5} text-anchor="middle" class="esb-node-t">{n.label}</text>
              </g>
            ))}
          </svg>
        </figure>
      </div>
    </div>
  </section>

  {/* ---------- pull quote ---------- */}
  <section id="section1" class="esb-quote">
    <div class="esb-wrap">
      <blockquote set:html={esb.quote} />
    </div>
  </section>

  {/* ---------- how it works ---------- */}
  <section id="section2" class="esb-band">
    <div class="esb-wrap esb-prose">
      <h2 set:html={esb.how.heading} />
      {esb.how.paras.map((p) => (
        <p set:html={p} />
      ))}
    </div>
  </section>

  {/* ---------- why implement ESB ---------- */}
  <section id="section3" class="esb-band esb-band--tint">
    <div class="esb-wrap esb-split">
      <div class="esb-prose">
        <h2 set:html={esb.why.heading} />
        {esb.why.paras.map((p) => (
          <p set:html={p} />
        ))}
      </div>
      <div class="esb-benefits">
        <p class="esb-list-label" set:html={esb.why.listLabel} />
        <ul>
          {esb.why.benefits.map((b) => (
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true" class="esb-check">
                <path d="M5 10.5l3.2 3.2L15 6.5" fill="none" stroke="#097a53" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span set:html={b} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- when do you need ESB ---------- */}
  <section id="section4" class="esb-band">
    <div class="esb-wrap esb-prose">
      <h2 set:html={esb.when.heading} />
      {esb.when.paras.map((p) => (
        <p set:html={p} />
      ))}
      <p class="esb-list-label" set:html={esb.when.listLabel} />
      <ul class="esb-signals">
        {esb.when.signals.map((s) => (
          <li>
            <span class="esb-sig-mark" aria-hidden="true"></span>
            <span set:html={s} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---------- ESB vs alternatives ---------- */}
  <section id="section5" class="esb-band esb-band--tint">
    <div class="esb-wrap esb-prose">
      <h2 set:html={esb.alt.heading} />
      {esb.alt.paras.map((p) => (
        <p set:html={p} />
      ))}
    </div>
  </section>

  {/* ---------- FAQ ---------- */}
  <section id="section6" class="esb-faq">
    <div class="esb-wrap">
      <h2>{s('esb.faq')}</h2>
      <div class="esb-faq-list">
        {esb.faq.map((f, i) => (
          <details class="esb-faq-item" open={i === 0}>
            <summary set:html={f.q} />
            <div class="esb-faq-a" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
</article>

{/* FAQ structured data — SEO win, uses the existing Q&A verbatim */}
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: esb.faq.map((f) => ({
      '@type': 'Question',
      name: f.q.replace(/&nbsp;/g, ' ').replace(/<[^>]+>/g, ''),
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a.replace(/&nbsp;/g, ' ').replace(/<[^>]+>/g, '').trim(),
      },
    })),
  })}
/>

<style>
  /* Local short names for the global tokens — see IntegrationsGrid. */
  .esb {
    --ink: var(--gi-text-on-light);
    --body: var(--gi-bg-slate);
    --muted: var(--gi-text-muted-slate);
    --green: var(--gi-green);
    --green-deep: var(--gi-green-deep);
    --tint: var(--gi-bg-tint);
    --line: var(--gi-line);
    font-family: Epilogue, system-ui, sans-serif;
    color: var(--body);
  }
  .esb-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .esb-prose {
    max-width: 720px;
  }
  .esb-band {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
  }
  .esb-band--tint {
    background: var(--tint);
  }

  /* ---- prose ---- */
  .esb-prose h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    line-height: 1.18;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 1.25rem;
  }
  .esb-prose p {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--body);
    margin: 0 0 1.15rem;
  }
  .esb-prose p:last-child {
    margin-bottom: 0;
  }
  .esb-lede {
    font-size: clamp(1.2rem, 2.4vw, 1.4rem) !important;
    line-height: 1.55 !important;
    color: var(--ink) !important;
    font-weight: 500;
  }
  .esb-prose :global(a) {
    color: var(--green-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .esb-prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  /* ---- diagram ---- */
  .esb-diagram {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }
  .esb-panel {
    margin: 0;
    background: var(--gi-bg-light);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.25rem 1rem 0.5rem;
  }
  .esb-panel figcaption {
    text-align: center;
    margin-bottom: 0.25rem;
  }
  .esb-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.28rem 0.85rem;
    border-radius: 20px;
  }
  /* The "before" pill was two invented values (#8a8ca3 on #eef0f6 = 2.90:1, well
     under AA at 12.8px). It reads as the muted counterpart to the green .esb-tag--ok
     pill, so use the muted ink on the light-panel surface instead — now both
     named: --gi-text-muted-slate on --gi-bg-tint, 5.52:1 at 12.8px, same
     "quieter option" tone, actually readable. */
  .esb-tag--warn {
    color: var(--gi-text-muted-slate);
    background: var(--gi-bg-tint);
  }
  .esb-tag--ok {
    color: var(--green-deep);
    background: rgba(39, 234, 147, 0.12);
  }
  .esb-panel svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .esb-node-t {
    font: 700 12px Epilogue, sans-serif;
    fill: var(--gi-bg-slate);
  }
  .esb-hub-t {
    font: 800 17px Epilogue, sans-serif;
    fill: var(--gi-bg-dark);
  }
  /* The hub's second line is 9.5px in a 380-unit viewBox — it renders *below*
     9.5px on any panel narrower than that, so it is normal text and owes 4.5:1.
     At 0.6 alpha over the green hub it measured 4.53:1: passing on paper with
     no headroom, at the smallest type on the page. 0.75 is the alpha the muted
     text tokens already use (--gi-text-muted-on-dark), lands at 7.18:1, and is
     still a clear tonal step below the solid-ink "ESB" above it. */
  .esb-hub-s {
    font: 600 9.5px Epilogue, sans-serif;
    fill: rgba(10, 10, 18, 0.75);
    letter-spacing: 0.02em;
  }

  /* ---- pull quote ---- */
  .esb-quote {
    background: var(--gi-bg-dark);
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .esb-quote blockquote {
    margin: 0 auto;
    max-width: 900px;
    text-align: center;
    font-size: clamp(1.5rem, 3.6vw, 2.4rem);
    line-height: 1.35;
    font-weight: 600;
    color: var(--gi-text-on-dark);
    letter-spacing: -0.01em;
    text-wrap: balance;
    position: relative;
    padding-top: 2.25rem;
  }
  .esb-quote blockquote::before {
    content: '\201C';
    position: absolute;
    top: -0.55em;
    left: 50%;
    transform: translateX(-50%);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--green);
  }

  /* ---- benefits (why) ---- */
  .esb-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .esb-list-label {
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 1rem;
    font-size: 1.0625rem;
  }
  .esb-benefits ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }
  .esb-benefits li {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 0.65rem;
    align-items: start;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--body);
  }
  .esb-check {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: rgba(39, 234, 147, 0.14);
    padding: 3px;
    box-sizing: border-box;
    margin-top: 1px;
  }

  /* ---- signals (when) ---- */
  .esb-signals {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    max-width: 720px;
  }
  .esb-signals li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--body);
  }
  .esb-sig-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    margin-top: 0.6rem;
    box-shadow: 0 0 0 4px rgba(39, 234, 147, 0.15);
  }

  /* ---- FAQ ---- */
  .esb-faq {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
    background: var(--tint);
  }
  .esb-faq h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    color: var(--ink);
    font-weight: 700;
    margin: 0 0 1.75rem;
  }
  .esb-faq-list {
    max-width: 820px;
  }
  .esb-faq-item {
    border-bottom: 1px solid var(--line);
  }
  .esb-faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 1.25rem 3rem 1.25rem 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink);
    position: relative;
    transition: color 0.2s ease;
  }
  .esb-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .esb-faq-item summary::after {
    content: '';
    position: absolute;
    right: 4px;
    top: 50%;
    width: 14px;
    height: 14px;
    transform: translateY(-50%);
    background:
      linear-gradient(var(--green-deep), var(--green-deep)) center/14px 2.2px no-repeat,
      linear-gradient(var(--green-deep), var(--green-deep)) center/2.2px 14px no-repeat;
    transition: transform 0.25s ease;
  }
  .esb-faq-item[open] summary::after {
    background:
      linear-gradient(var(--green-deep), var(--green-deep)) center/14px 2.2px no-repeat;
  }
  .esb-faq-item summary:hover {
    color: var(--green-deep);
  }
  .esb-faq-a {
    padding: 0 3rem 1.4rem 0;
    font-size: 1.03rem;
    line-height: 1.7;
    color: var(--body);
  }
  /* Answers ran 82ch open. Cap the paragraphs rather than the wrapper, whose
     border-box width already carries 3rem of right padding. */
  .esb-faq-a :global(p) {
    max-width: var(--gi-measure);
  }
  .esb-faq-a :global(a) {
    color: var(--green-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---- responsive ---- */
  @media (max-width: 800px) {
    .esb-split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .esb-diagram {
      grid-template-columns: 1fr;
    }
  }
</style>
