---
/* /czym-jest-esb/ — the SEO cornerstone, as an editorial page.
   Copy is VERBATIM from esb-content(.en).json; only presentation changes.

   v2: a reading measure on white, the recessed mist band for the diagram and
   the benefits, the statement set on the mint field over the mass's horizon.
   The diagram draws the argument in the system's own terms — on the left
   every system tied to every other, on the right every system falling into
   one mass. */
import esbPl from '../data/esb-content.json';
import esbEn from '../data/esb-content.en.json';
import { localeOf, t } from '../i18n/ui';

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const esb = lang === 'en' ? esbEn : esbPl;

/* ---- diagram geometry: six systems in a hexagon ---- */
const R = 136;
const cx = 190;
const cy = 178;
const labels = ['ERP', 'WMS', 'CRM', 'e‑Commerce', 'MES', 'API'];
const nodes = labels.map((label, i) => {
  const a = (-90 + i * 60) * (Math.PI / 180);
  return { label, x: cx + R * Math.cos(a), y: cy + R * Math.sin(a) };
});
const mesh: Array<[number, number]> = [];
for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) mesh.push([i, j]);
const NW = 58;
const NH = 17;
---

<article class="esb">
  {/* ---------- intro / definition ---------- */}
  <section id="section0" class="section esb-intro">
    <div class="container">
      <div class="esb-prose" data-reveal>
        <p class="esb-lede" set:html={esb.intro[0]} />
        <p set:html={esb.intro[1]} />
      </div>
    </div>
  </section>

  {/* ---------- point-to-point vs ESB ---------- */}
  <section class="section surface-mist esb-diagram-band">
    <div class="container esb-diagram">
      <figure class="esb-panel" data-reveal>
        <figcaption><span class="badge badge--dot esb-tag--warn">{s('esb.tag.p2p')}</span></figcaption>
        <svg viewBox="0 0 380 356" role="img" aria-label={s('esb.aria.p2p')}>
          {mesh.map(([i, j]) => (
            <line x1={nodes[i].x} y1={nodes[i].y} x2={nodes[j].x} y2={nodes[j].y} class="esb-edge-p2p" />
          ))}
          {nodes.map((n) => (
            <g>
              <rect x={n.x - NW} y={n.y - NH} width={NW * 2} height={NH * 2} rx={NH} class="esb-node" />
              <text x={n.x} y={n.y + 4.5} text-anchor="middle" class="esb-node-t">{n.label}</text>
            </g>
          ))}
        </svg>
      </figure>

      <figure class="esb-panel" data-reveal>
        <figcaption><span class="badge badge--dot esb-tag--ok">{s('esb.tag.bus')}</span></figcaption>
        <svg viewBox="0 0 380 356" role="img" aria-label={s('esb.aria.bus')}>
          {nodes.map((n) => (
            <line x1={n.x} y1={n.y} x2={cx} y2={cy} class="esb-edge-bus" />
          ))}
          <circle cx={cx} cy={cy} r="54" class="esb-hub" />
          <text x={cx} y={cy + 4} text-anchor="middle" class="esb-hub-t">ESB</text>
          <text x={cx} y={cy + 22} text-anchor="middle" class="esb-hub-s">{s('esb.hub.sub')}</text>
          {nodes.map((n) => (
            <g>
              <rect x={n.x - NW} y={n.y - NH} width={NW * 2} height={NH * 2} rx={NH} class="esb-node" />
              <text x={n.x} y={n.y + 4.5} text-anchor="middle" class="esb-node-t">{n.label}</text>
            </g>
          ))}
        </svg>
      </figure>
    </div>
  </section>

  {/* ---------- the statement ---------- */}
  <section id="section1" class="esb-quote surface-mint">
    <span class="esb-quote-mass" aria-hidden="true"></span>
    <div class="container">
      <blockquote set:html={esb.quote} data-reveal />
    </div>
  </section>

  {/* ---------- how it works ---------- */}
  <section id="section2" class="section">
    <div class="container">
      <div class="esb-prose" data-reveal>
        <h2 set:html={esb.how.heading} />
        {esb.how.paras.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  {/* ---------- why implement ESB ---------- */}
  <section id="section3" class="section surface-mist">
    <div class="container esb-split">
      <div class="esb-prose" data-reveal>
        <h2 set:html={esb.why.heading} />
        {esb.why.paras.map((p) => <p set:html={p} />)}
      </div>
      <div class="esb-benefits card" data-reveal>
        <p class="esb-list-label" set:html={esb.why.listLabel} />
        <ul>
          {esb.why.benefits.map((b) => (
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true" class="esb-check">
                <path d="M5 10.5l3.2 3.2L15 6.5" />
              </svg>
              <span set:html={b} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- when do you need ESB ---------- */}
  <section id="section4" class="section">
    <div class="container">
      <div class="esb-prose" data-reveal>
        <h2 set:html={esb.when.heading} />
        {esb.when.paras.map((p) => <p set:html={p} />)}
        <p class="esb-list-label" set:html={esb.when.listLabel} />
        <ul class="esb-signals">
          {esb.when.signals.map((sig) => (
            <li set:html={sig} />
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- ESB vs alternatives ---------- */}
  <section id="section5" class="section surface-mist">
    <div class="container">
      <div class="esb-prose" data-reveal>
        <h2 set:html={esb.alt.heading} />
        {esb.alt.paras.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  {/* ---------- FAQ ---------- */}
  <section id="section6" class="section">
    <div class="container esb-faq">
      <div>
        <h2 class="esb-faq-h">{s('esb.faq')}</h2>
      </div>
      <div class="esb-faq-list">
        {
          esb.faq.map((f, i) => (
            <details class="esb-faq-item" open={i === 0}>
              <summary>
                <span set:html={f.q} />
                <span class="esb-faq-toggle" aria-hidden="true" />
              </summary>
              <div class="esb-faq-a" set:html={f.a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>
</article>

{/* FAQ structured data — uses the existing Q&A verbatim */}
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: esb.faq.map((f) => ({
      '@type': 'Question',
      name: f.q.replace(/&nbsp;/g, ' ').replace(/<[^>]+>/g, ''),
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a.replace(/&nbsp;/g, ' ').replace(/<[^>]+>/g, '').trim(),
      },
    })),
  })}
/>

<style>
  .esb-prose {
    display: grid;
    gap: 18px;
    max-width: 760px;
  }
  .esb-prose h2 {
    font: 800 var(--fs-h2) / 1 var(--font-sans);
    letter-spacing: -0.05em;
    color: var(--ink-900);
    text-wrap: balance;
    margin-bottom: 6px;
  }
  .esb-prose p {
    font: 400 var(--fs-body-lg) / 1.65 var(--font-sans);
    color: var(--slate-600);
    text-wrap: pretty;
  }
  .esb-prose :global(strong) {
    font-weight: 600;
    color: var(--ink-900);
  }
  .esb-prose :global(a) {
    color: var(--ink-900);
  }
  .esb-intro .esb-lede {
    font: 400 clamp(18px, 1.7vw, 20px) / 1.55 var(--font-sans);
    letter-spacing: -0.015em;
    color: var(--ink-900);
  }

  /* ---- diagram ---- */
  .esb-diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @media (min-width: 800px) {
    .esb-diagram {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .esb-panel {
    display: grid;
    gap: 16px;
    justify-items: center;
    padding: 24px 24px 12px;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .esb-panel figcaption {
    justify-self: start;
  }
  .esb-panel svg {
    width: 100%;
    max-width: 440px;
    height: auto;
  }
  .esb-tag--warn::before {
    background: var(--red-500);
  }
  .esb-tag--ok::before {
    background: var(--mint-600);
  }
  .esb-edge-p2p {
    stroke: var(--slate-400);
    stroke-width: 1.25;
  }
  .esb-edge-bus {
    stroke: var(--ink-900);
    stroke-width: 1.75;
  }
  .esb-node {
    fill: var(--white);
    stroke: var(--ink-900);
    stroke-width: 1.5;
  }
  .esb-node-t {
    font: 500 12px var(--font-mono);
    letter-spacing: 0.04em;
    fill: var(--ink-900);
  }
  .esb-hub {
    fill: var(--ink-900);
  }
  .esb-hub-t {
    font: 800 22px var(--font-sans);
    letter-spacing: -0.04em;
    fill: var(--mint-500);
  }
  .esb-hub-s {
    font: 500 10px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--slate-400);
  }

  /* ---- the statement: mint field over the mass's horizon ---- */
  .esb-quote {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-top: clamp(72px, 10vw, 128px);
    padding-bottom: clamp(140px, 18vw, 240px);
  }
  .esb-quote-mass {
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: 0;
    width: max(160vw, 900px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink-900);
    translate: -50% calc(100% - clamp(64px, 9vw, 150px));
  }
  .esb-quote blockquote {
    max-width: 26ch;
    margin: 0 auto;
    font: 800 var(--fs-h1) / 0.96 var(--font-sans);
    letter-spacing: -0.055em;
    text-align: center;
    text-wrap: balance;
    color: var(--ink-900);
  }

  /* ---- why: prose + the benefits card ---- */
  .esb-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  @media (min-width: 960px) {
    .esb-split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
      gap: clamp(48px, 6vw, 96px);
    }
  }
  .esb-benefits {
    display: grid;
    gap: 18px;
    padding: 28px;
  }
  .esb-list-label,
  .esb-prose .esb-list-label {
    margin-top: 8px;
    font: 500 12px / 1.3 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--mint-800);
  }
  .esb-benefits ul {
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .esb-benefits li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    font: 400 var(--fs-body) / 1.55 var(--font-sans);
    color: var(--ink-900);
  }
  .esb-check {
    width: 24px;
    height: 24px;
    padding: 4px;
    border-radius: 50%;
    background: var(--ink-900);
    fill: none;
    stroke: var(--mint-500);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- when: warning signs, marked amber — the system's "pending" ---- */
  .esb-signals {
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .esb-signals li {
    position: relative;
    padding: 14px 16px 14px 40px;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-md);
    font: 400 16px / 1.5 var(--font-sans);
    color: var(--ink-900);
  }
  .esb-signals li::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 21px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber-500);
  }

  /* ---- FAQ ---- */
  .esb-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px 64px;
  }
  @media (min-width: 900px) {
    .esb-faq {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
  }
  .esb-faq-h {
    font: 800 var(--fs-h1) / 0.92 var(--font-sans);
    letter-spacing: -0.06em;
  }
  .esb-faq-list {
    border-top: 1px solid var(--mist-200);
  }
  .esb-faq-item {
    border-bottom: 1px solid var(--mist-200);
  }
  .esb-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    font: 600 clamp(18px, 1.6vw, 20px) / 1.3 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--ink-900);
    cursor: pointer;
    list-style: none;
    border-radius: 4px;
  }
  .esb-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .esb-faq-toggle {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--ink-900);
    border-radius: 50%;
    transition: background-color var(--dur-fast) ease;
  }
  .esb-faq-toggle::before,
  .esb-faq-toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.75px;
    border-radius: 2px;
    background: var(--ink-900);
    translate: -50% -50%;
    transition: transform var(--dur-base) var(--ease-fall);
  }
  .esb-faq-toggle::after {
    transform: rotate(90deg);
  }
  .esb-faq-item summary:hover .esb-faq-toggle,
  .esb-faq-item[open] .esb-faq-toggle {
    background: var(--ink-900);
  }
  .esb-faq-item summary:hover .esb-faq-toggle::before,
  .esb-faq-item summary:hover .esb-faq-toggle::after,
  .esb-faq-item[open] .esb-faq-toggle::before,
  .esb-faq-item[open] .esb-faq-toggle::after {
    background: var(--mint-500);
  }
  .esb-faq-item[open] .esb-faq-toggle::after {
    transform: rotate(0deg);
  }
  .esb-faq-a {
    padding: 0 60px 28px 0;
    max-width: 760px;
    font: 400 16px / 1.7 var(--font-sans);
    color: var(--slate-600);
  }
  @media (max-width: 599.98px) {
    .esb-faq-a {
      padding-right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .esb-faq-toggle,
    .esb-faq-toggle::before,
    .esb-faq-toggle::after {
      transition: none;
    }
  }
</style>
