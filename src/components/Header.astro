---
/* Site header: logo + hamburger + full-screen nav.
   Markup ported 1:1 from the live theme (nav.php + rendered output).

   Labels come from the ui.ts dictionary and hrefs from linkUrl(), so an
   English page gets an English nav that links to published English pages —
   and falls back to the Polish URL for anything not yet translated (the rule
   is documented on linkUrl). The privacy policy is Polish-only by decision,
   so its label stays Polish in both locales and its link never localises. */
import LangSwitch from './LangSwitch.astro';
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';

interface Props {
  /** Passed through to the language switcher so it can offer *this* page in the
   *  other language rather than dumping the reader on a home page. Site.astro
   *  supplies it; the 404 doesn't have one. */
  slug?: string;
}
const { slug } = Astro.props;

const lang = localeOf(Astro.currentLocale);
const s = t(lang);

/* One lookup per nav target; the keys are the language-neutral slugs. */
const NAV_SLUGS = [
  'home',
  'kalkulator',
  'pobieranie',
  'kontakt',
  'technologia',
  'czym-jest-esb',
  'cennik',
  'case-studies',
  'integracje',
  'polityka-prywatnosci',
] as const;
const href = Object.fromEntries(
  await Promise.all(NAV_SLUGS.map(async (k) => [k, await linkUrl(k, lang)])),
) as Record<(typeof NAV_SLUGS)[number], string>;

const year = new Date().getFullYear();
