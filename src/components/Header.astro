---
/* Site header, v2: a visible top bar.
 *
 * v1 hid the whole site behind a MENU button and a fullscreen overlay. The
 * buyers this site speaks to arrive with one question — does it connect MY
 * system, and what does it cost — so the pages that answer it are on the bar:
 * integrations, technology, pricing, proof, the ESB explainer, contact. The
 * download is the one action every page points at, so it is the bar's only
 * button.
 *
 * Below 1100px the links fold into a fullscreen ink menu. It is a modal
 * <dialog>: showModal() gives focus containment, inert background and Escape
 * for free, which three hand-rolled listeners in v1 only approximated. With
 * JS off the menu button is hidden and the link row scrolls sideways instead,
 * so no visitor is ever left without navigation.
 *
 * Labels come from ui.ts and hrefs from linkUrl(), so an English page links
 * to English pages; a page the locale doesn't offer (the ROI calculator in
 * English) has no href and renders no item. The privacy policy is Polish-only
 * by decision — its link carries hreflang="pl". */
import LangSwitch from './LangSwitch.astro';
import Wordmark from './ui/Wordmark.astro';
import Icon from './ui/Icon.astro';
import site from '../data/site.json';
import { isOffered, linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';

interface Props {
  /** Threaded to the language switcher so it can offer *this* page in the
   *  other language. The 404 has none. */
  slug?: string;
}
const { slug } = Astro.props;

const lang = localeOf(Astro.currentLocale);
const s = t(lang);

const NAV_SLUGS = [
  'home',
  'integracje',
  'technologia',
  'cennik',
  'case-studies',
  'czym-jest-esb',
  'kalkulator',
  'kontakt',
  'pobieranie',
  'polityka-prywatnosci',
] as const;
type NavSlug = (typeof NAV_SLUGS)[number];

const href = Object.fromEntries(
  await Promise.all(
    NAV_SLUGS.filter((k) => isOffered(k, lang)).map(async (k) => [k, await linkUrl(k, lang)]),
  ),
) as Partial<Record<NavSlug, string>>;

/* "Which page am I on" derived once from the URL, so aria-current is true on
   exactly one link rather than hand-placed. */
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const current = (url?: string) =>
  url && (url.replace(/\/+$/, '') || '/') === here ? 'page' : undefined;

/* The bar. Order follows the buyer's questions: does it connect my systems,
   what is it, what does it cost, who runs it, what is an ESB, how do I talk
   to you. */
const bar: Array<[NavSlug, string]> = [
  ['integracje', s('nav.integrations')],
  ['technologia', s('nav.technology')],
  ['cennik', s('nav.pricing')],
  ['case-studies', s('nav.caseStudies')],
  ['czym-jest-esb', s('nav.whatIsEsb')],
  ['kontakt', s('nav.contact')],
];

/* The menu carries everything, including the pages that don't earn a place
   on the bar. */
const menu: Array<[NavSlug, string]> = [
  ['home', s('nav.home')],
  ['integracje', s('nav.integrations')],
  ['technologia', s('nav.technology')],
  ['cennik', s('nav.pricing')],
  ['case-studies', s('nav.caseStudies')],
  ['czym-jest-esb', s('nav.whatIsEsb')],
  ['kalkulator', s('nav.roiCalculator')],
  ['kontakt', s('nav.contact')],
];
const homeHref = href.home ?? '/';
const year = new Date().getFullYear();
---

<header class="site-header" data-header>
  <div class="container site-header-in">
    <a href={homeHref} class="site-logo" aria-label={s('nav.logoHome')}>
      <Wordmark size={20} />
    </a>

    <nav class="site-nav" aria-label={s('nav.aria')}>
      <ul>
        {
          bar.map(
            ([k, label]) =>
              href[k] && (
                <li>
                  <a href={href[k]} aria-current={current(href[k])}>
                    {label}
                  </a>
                </li>
              ),
          )
        }
      </ul>
    </nav>

    <div class="site-actions">
      <LangSwitch slug={slug} class="site-lang" short />
      {
        href.pobieranie && (
          <a class="btn btn--primary btn--sm site-cta" href={href.pobieranie} aria-current={current(href.pobieranie)}>
            {s('hero.download')}
            <span class="btn-dot" aria-hidden="true" />
          </a>
        )
      }
      <button
        type="button"
        class="menu-btn"
        aria-haspopup="dialog"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-open
      >
        <span class="menu-btn-label">{s('nav.menuOpen')}</span>
        <span class="menu-btn-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="site-menu surface-ink" aria-label={s('nav.menuAria')}>
  <span class="mass site-menu-mass" style="--mass-color: var(--mint-500)" aria-hidden="true"></span>
  <div class="container site-menu-top">
    <a href={homeHref} class="site-logo" aria-label={s('nav.logoHome')}>
      <Wordmark size={20} tone="reversed" />
    </a>
    <button type="button" class="menu-btn menu-btn--close" data-menu-close>
      <span class="menu-btn-label">{s('nav.menuClose')}</span>
      <Icon name="x" size={18} />
    </button>
  </div>
  <div class="container site-menu-body">
    <nav aria-label={s('nav.aria')}>
      <ol class="site-menu-list">
        {
          menu.map(
            ([k, label], i) =>
              href[k] && (
                <li>
                  <a href={href[k]} aria-current={current(href[k])}>
                    <span class="label-num" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span>{label}</span>
                  </a>
                </li>
              ),
          )
        }
      </ol>
    </nav>
    <div class="site-menu-aside">
      {
        href.pobieranie && (
          <a class="btn btn--accent btn--lg" href={href.pobieranie}>
            {s('hero.download')}
            <span class="btn-dot" aria-hidden="true" />
          </a>
        )
      }
      <ul class="site-menu-meta">
        <li>
          <a href={site.docs} target="_blank" rel="noopener">
            {s('nav.docs')}
            <Icon name="arrow-up-right" size={16} />
            <span class="visually-hidden">{s('a11y.newTab')}</span>
          </a>
        </li>
        {
          href['polityka-prywatnosci'] && (
            <li>
              <a href={href['polityka-prywatnosci']} hreflang="pl" aria-current={current(href['polityka-prywatnosci'])}>
                {s('nav.privacy')}
              </a>
            </li>
          )
        }
        <li><LangSwitch slug={slug} /></li>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener" aria-label={s('a11y.linkedin')} class="site-menu-social">
            <Icon name="linkedin" size={18} />
            LinkedIn
          </a>
        </li>
      </ul>
      <p class="site-menu-copy">{s('footer.copyright')} {year} gravity.integration</p>
    </div>
  </div>
</dialog>

<style>
  /* ---- the bar ------------------------------------------------------------
     Sticky, not fixed: it sits in flow under the announcement bar, so nothing
     has to measure anything to avoid overlapping. At the top of the page it
     takes the colour of the hero beneath it (body[data-hero]); once the page
     moves it turns white with the system's one allowed line — 1px mist-200. */
  .site-header {
    --header-bg: var(--white);
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--header-bg);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-base) ease,
      border-color var(--dur-base) ease,
      transform var(--dur-slow) var(--ease-fall);
  }
  :global(body[data-hero='mint']) .site-header {
    --header-bg: var(--mint-500);
    --focus-gap: transparent;
    --focus-ring: var(--ink-900);
    --underline: var(--ink-900);
  }
  :global(body[data-hero='mist']) .site-header {
    --header-bg: var(--mist-100);
  }
  :global(body[data-hero='ink']) .site-header {
    --header-bg: var(--ink-900);
  }
  :global(body.header-solid) .site-header {
    --header-bg: var(--white);
    --focus-gap: var(--ink-900);
    --focus-ring: var(--mint-500);
    --underline: var(--mint-500);
    border-bottom-color: var(--mist-200);
  }
  :global(body.header-hidden) .site-header {
    transform: translateY(-100%);
  }

  .site-header-in {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: var(--header-h);
  }

  .site-logo {
    display: inline-flex;
    flex: none;
    padding: 6px 0;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
  }

  /* ---- links ---- */
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    font: 600 14px / 1 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink-900);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast) ease;
  }
  .site-nav a:hover {
    background: var(--nav-hover, var(--mist-100));
    color: var(--ink-900);
  }
  :global(body[data-hero='mint']:not(.header-solid)) .site-nav a:hover {
    --nav-hover: var(--mint-600);
  }
  /* Current page: an ink pill, the same shape as the hover, one level
     heavier — so "where am I" reads before any link is touched. */
  .site-nav a[aria-current='page'] {
    background: var(--ink-900);
    color: var(--on-ink);
  }

  .site-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.site-lang) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 10px;
    border-radius: var(--radius-pill);
    font: 500 12px / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    color: var(--ink-900);
    text-decoration: none;
  }
  :global(.site-lang:hover) {
    background: var(--mist-100);
    color: var(--ink-900);
  }
  :global(body[data-hero='mint']:not(.header-solid) .site-lang:hover) {
    background: var(--mint-600);
  }

  /* ---- menu button ---- */
  .menu-btn {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 14px;
    border: 1.5px solid var(--ink-900);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-900);
    font: 500 12px / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    transition: background-color var(--dur-fast) ease;
  }
  .menu-btn:hover {
    background: var(--mist-100);
  }
  :global(body[data-hero='mint']:not(.header-solid)) .menu-btn:hover {
    background: var(--mint-600);
  }
  .menu-btn-icon {
    display: grid;
    gap: 4px;
    width: 16px;
  }
  .menu-btn-icon span {
    display: block;
    height: 1.75px;
    border-radius: 2px;
    background: currentColor;
  }

  @media (max-width: 1099.98px) {
    .site-nav {
      display: none;
    }
    .site-actions {
      margin-left: auto;
    }
    .menu-btn {
      display: inline-flex;
    }
  }

  /* Phones: the download is one thumb away in the hero and in the menu, and
     the bar is too narrow for the wordmark, a button and the menu. */
  @media (max-width: 479.98px) {
    .site-cta {
      display: none;
    }
    :global(.site-lang) {
      padding: 0 8px;
    }
  }

  /* No script, no dialog: show the links as a scrolling row instead. */
  :global(html.no-js) .menu-btn {
    display: none;
  }
  @media (max-width: 1099.98px) {
    :global(html.no-js) .site-nav {
      display: block;
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      margin: 0 calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 8px;
    }
    :global(html.no-js) .site-header-in {
      flex-wrap: wrap;
    }
  }

  /* ---- the menu ---------------------------------------------------------
     Ink, with the mass inverted to mint — the one inverted frame in the
     sequence. It fills the viewport: a dialog in the top layer, above the
     header, so it brings its own logo and close control. */
  .site-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity var(--dur-base) var(--ease-fall),
      transform var(--dur-slow) var(--ease-fall),
      overlay var(--dur-slow) allow-discrete,
      display var(--dur-slow) allow-discrete;
  }
  .site-menu[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .site-menu[open] {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .site-menu::backdrop {
    background: var(--ink-900);
  }

  .site-menu-mass {
    width: max(560px, 70vmax);
    right: -24vmax;
    bottom: -38vmax;
  }
  /* The mass is pinned to the viewport's corner and the menu's content is
     not, so on a one-column phone menu, or any screen short enough for the
     list to reach the bottom, the two meet: links and the mint button on
     the mint mass. The menu is UI, and the system's rule for UI is to scale
     down — there, it goes. */
  @media (max-width: 759.98px), (max-height: 799.98px) {
    .site-menu-mass {
      display: none;
    }
  }

  .site-menu-top {
    position: relative;
    z-index: var(--z-raised);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }
  .menu-btn--close {
    display: inline-flex;
    border-color: var(--on-ink);
    color: var(--on-ink);
  }
  .menu-btn--close:hover {
    background: var(--ink-700);
  }

  .site-menu-body {
    position: relative;
    z-index: var(--z-raised);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding-top: clamp(24px, 6vh, 64px);
    padding-bottom: 48px;
  }
  @media (min-width: 760px) {
    .site-menu-body {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .site-menu-list {
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .site-menu-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 16px;
    padding: 6px 0;
    color: var(--on-ink);
    text-decoration: none;
    font: 800 clamp(30px, 6.2vw, 46px) / 1.05 var(--font-sans);
    letter-spacing: -0.05em;
  }
  .site-menu-list .label-num {
    min-width: 2ch;
    color: var(--slate-400);
    transform: translateY(-0.9em);
  }
  .site-menu-list a:hover,
  .site-menu-list a[aria-current='page'] {
    color: var(--mint-500);
  }

  .site-menu-aside {
    display: grid;
    gap: 28px;
    align-content: start;
    justify-items: start;
  }
  .site-menu-meta {
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .site-menu-meta a,
  .site-menu-meta :global(.gi-lang) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    color: var(--on-ink);
    font: 600 15px / 1.2 var(--font-sans);
    text-decoration: underline;
    text-decoration-color: var(--mint-500);
    text-underline-offset: 5px;
  }
  .site-menu-meta a:hover,
  .site-menu-meta :global(.gi-lang:hover) {
    color: var(--mint-500);
  }
  .site-menu-copy {
    font: 400 13px / 1.4 var(--font-sans);
    color: var(--slate-400);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-menu {
      transition: none;
    }
    .site-menu,
    .site-menu[open] {
      transform: none;
    }
  }
</style>

<script>
  /* The menu. <dialog>.showModal() does the hard parts — top layer, inert
     page, focus containment, Escape — so this only opens, closes, keeps the
     button's state honest and returns focus where it came from. */
  const dialog = document.getElementById('site-menu') as HTMLDialogElement | null;
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  if (dialog && typeof dialog.showModal === 'function') {
    let opener: HTMLButtonElement | null = null;
    const setExpanded = (v: boolean) =>
      openers.forEach((b) => b.setAttribute('aria-expanded', String(v)));

    openers.forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        dialog.showModal();
        document.documentElement.classList.add('menu-open');
        setExpanded(true);
      }),
    );
    const close = () => dialog.close();
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', close);
    /* A link inside the menu may point at the page it is on (an anchor, or
       the current page) — close either way so the reader sees where they
       went. */
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-open');
      setExpanded(false);
      opener?.focus();
    });
    /* The menu is for narrow screens; if the window grows past the bar's
       breakpoint while it is open, the bar is back and the menu is noise. */
    const wide = window.matchMedia('(min-width: 1100px)');
    wide.addEventListener('change', (e) => {
      if (e.matches && dialog.open) close();
    });
  } else {
    openers.forEach((b) => (b.hidden = true));
  }
</script>
