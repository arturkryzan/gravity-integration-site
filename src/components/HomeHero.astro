---
/* Homepage hero (theme hero.php + snippet 24 overhaul), video re-encoded with poster. */
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';

interface Props {
  h1: string;
}
const { h1 } = Astro.props;

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const downloadHref = await linkUrl('pobieranie', lang);
---

<section class="hero bg-violet d-flex align-items-end" data-scroll-section>
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/homehero-poster.jpg"
    class="img-fit h-100 w-100"
    style="object-fit: cover;"
  >
    <source src="/video/homehero.webm" type="video/webm" />
    <source src="/video/homehero.mp4" type="video/mp4" />
  </video>
  <div class="container-fluid">
    <div class="row align-items-start">
      <div class="col-lg-8 hero-text pb-6" data-scroll data-scroll-opacity>
        <div class="d-inline-block hero-text-circle">
          <h1 set:html={h1} />
        </div>
      </div>
    </div>
    <div class="row pb-10">
      <div class="col-lg-7" data-scroll data-scroll-opacity>
        <p style="color:rgba(255,255,255,0.75);font-size:1.1rem;line-height:1.65;margin-bottom:1.5rem;">
          {s('hero.sub')}
        </p>
        <div
          style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;margin-bottom:1.25rem;"
        >
          <a class="btn btn-arrow btn-arrow-white" href={downloadHref}
            ><span>{s('hero.download')}</span></a
          >
          <a class="btn btn-arrow btn-arrow-white" href="#section-demo" data-scroll-to
            ><span>{s('hero.demo')}</span></a
          >
        </div>
        {/* 0.4 alpha put this at 3.77:1 on the hero's #0a0a12 — a real 1.4.3 AA
            failure at 12.8px, and it is the customer-names line, the one
            piece of copy in the hero a skimmer is most likely to want.
            0.55 reads 6.25:1 and still sits a clear step below the 0.75
            sub-heading above it. */}
        <p style="color:rgba(255,255,255,0.55);font-size:0.8rem;line-height:1.5;margin:0;">
          {s('hero.social')}
        </p>
      </div>
    </div>
  </div>
  <div
    class="hero-decorative ratio"
    data-scroll
    data-scroll-delay=".1"
    data-scroll-speed=".3"
    style=" --bs-aspect-ratio: 93%;"
  >
    <img
      src="/theme/static/lineshome.svg"
      alt=""
      width="110"
      height="110"
      role="presentation"
      aria-hidden="true"
      loading="lazy"
      class="lazyload"
    />
  </div>
</section>
