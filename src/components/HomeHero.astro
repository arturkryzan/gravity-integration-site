---
/* Home hero — the design system's "A · Corner fall" at full size, in motion.
 *
 * Mint is the field; the mass falls into the frame from the bottom-right and
 * is cropped by it; the satellite sits on the side opposite the crop. The H1
 * sits on the mass in mint. The lead, the two CTAs and the customer line sit
 * on the field in ink.
 *
 * The animation ("every tool falls in") is src/scripts/hero-fall.js; what
 * it does is described there. This file holds the composition it starts and
 * ends on, which is also the whole hero for anyone without it: reduced
 * motion, no JavaScript, print. The inline script under the section hands
 * the hero to the animation before first paint (`data-anim`), and takes it
 * back if the animation hasn't arrived within 3s.
 *
 * Geometry. On desktop the mass, the satellite and the H1 are all anchored to
 * the hero's BOTTOM edge and sized in vw, so their relation holds at every
 * width and survives a short window: when the hero is capped by the viewport
 * height, only the top of the mass is cropped further. The mass centre sits
 * at the vertical middle of the headline block, which keeps the text roughly
 * 8% of the diameter in from the edge on its first and last lines — the
 * system's rule for type on the mass.
 *
 * Below 1000px the frame turns over: the mass falls in from the top, fills
 * the width behind the headline (it is positioned against the headline's own
 * box, so it fits a Polish or an English H1 without measuring anything), and
 * the field opens underneath for the lead and the actions. */
import { getCollection } from 'astro:content';
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';
import { clean, typeset } from '../lib/html';
import Icon from './ui/Icon.astro';

interface Props {
  h1: string;
}
const { h1 } = Astro.props;

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const downloadHref = await linkUrl('pobieranie', lang);

/* The connectors that fall into the mass, in order: the headline's three
   (ERP, CRM, WMS) first, then the rest of the stack a buyer brings. Every
   name is looked up in src/data/integrations.json and the build fails on one
   that isn't there, so the animation can only ever name a connector the
   directory lists. The category comes from the same file. */
const FALLING = [
  'Subiekt GT',
  'Salesforce',
  'Comarch WMS',
  'BaseLinker',
  'Shoper',
  'Allegro',
  'InPost',
  'KSeF',
  'Graffiti ERP',
  'HubSpot CRM',
  'Sente WMS',
  'WooCommerce',
  'Comarch ERP XL',
  'Amazon',
  'DPD',
  'enova365',
  'Shopify',
  'Pipedrive',
  'Apilo',
  'SAP Business One',
  'Akeneo PIM',
  'PrestaShop',
  'Symfonia ERP',
  'Qguar WMS',
];
const CATEGORY: Record<string, string> = {
  erp: 'ERP',
  crm: 'CRM',
  wms: 'WMS',
  oms: 'OMS',
  pim: 'PIM',
  ecommerce: 'E-COMMERCE',
  marketplace: 'MARKETPLACE',
  courier: s('hero.cat.courier'),
  invoice: s('hero.cat.invoice'),
};
/* The directory lists it as "Graffiti ERP"; the product's name is Graffiti.ERP. */
const SHOWN_AS: Record<string, string> = { 'Graffiti ERP': 'Graffiti.ERP' };
const directory = await getCollection('integrationCategories');
const tools = FALLING.map((name) => {
  const cat = directory.find((c) => c.data.items.some((it) => it.name === name));
  if (!cat || !CATEGORY[cat.id]) {
    throw new Error(`HomeHero: "${name}" is not a connector in src/data/integrations.json`);
  }
  return `${CATEGORY[cat.id]} · ${SHOWN_AS[name] ?? name}`.toLocaleUpperCase(lang === 'en' ? 'en-US' : 'pl-PL');
});
---

<section class="hero surface-mint" aria-labelledby="hero-h1" data-tools={JSON.stringify(tools)}>
  <span class="hero-satellite" aria-hidden="true"></span>
  <canvas class="hero-fx" aria-hidden="true" hidden></canvas>
  <div class="container hero-grid">
    <div class="hero-stage">
      <div class="hero-mass" aria-hidden="true"></div>
      <h1 id="hero-h1" class="hero-h1" set:html={typeset(clean(h1))} />
    </div>

    <div class="hero-copy">
      <p class="hero-lead">{s('hero.sub')}</p>
      <div class="hero-ctas">
        <a class="btn btn--primary btn--lg" href={downloadHref}>
          {s('hero.download')}
          <span class="btn-dot" aria-hidden="true"></span>
        </a>
        <a class="btn btn--secondary btn--lg" href="#section-demo">{s('hero.demo')}</a>
      </div>
      <p class="hero-social">{s('hero.social')}</p>
    </div>
  </div>
  <button type="button" class="hero-pause btn btn--secondary btn--sm surface-ink" aria-pressed="false" hidden>
    <span class="visually-hidden">{s('hero.pause')}</span>
    <Icon name="pause" class="hero-pause-i hero-pause-i--pause" size={16} />
    <Icon name="play" class="hero-pause-i hero-pause-i--play" size={16} />
  </button>
</section>
<script is:inline>
  /* Before first paint: hand the hero to the animation, which starts from an
     empty field. If src/scripts/hero-fall.js hasn't claimed it within 3s
     (it never loaded), the static composition comes back. */
  (function () {
    var h = document.querySelector('section.hero');
    if (!h || !window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    h.setAttribute('data-anim', 'pre');
    setTimeout(function () {
      if (h.getAttribute('data-anim') === 'pre') h.removeAttribute('data-anim');
    }, 3000);
  })();
</script>
<script src="../scripts/hero-fall.js"></script>

<style>
  .hero {
    /* the desktop geometry, in one place */
    --d: 64vw; /* mass diameter */
    --mass-left: 42vw;
    --c: 17.8vw; /* mass centre, measured up from the hero's bottom */
    --h1-left: 49vw;
    --h1-bottom: 6.8vw;
    /* where the container's content box starts, for aligning to the mass */
    --edge: max(var(--gutter), (100vw - var(--container)) / 2);

    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(560px, min(54vw, calc(100svh - 120px)), 980px);
    display: flex;
    align-items: flex-end;
  }

  .hero-mass {
    position: absolute;
    z-index: 0;
    width: var(--d);
    aspect-ratio: 1;
    left: var(--mass-left);
    bottom: calc(var(--c) - var(--d) / 2);
    border-radius: 50%;
    background: var(--ink-900);
    overflow: hidden;
  }

  .hero-satellite {
    position: absolute;
    z-index: 0;
    width: calc(var(--d) * 0.07);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink-900);
    left: calc(var(--mass-left) - 7vw);
    bottom: 40vw;
  }

  /* The animation's moving parts — the satellite in the loop and the letters
     of the connector's name — are drawn here, over the mass and under the
     type. The script sizes it to the region they move through. */
  .hero-fx {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .hero-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: var(--h1-bottom);
  }

  /* The stage is transparent to layout on desktop: the mass positions
     against the hero, the headline against the grid. */
  .hero-stage {
    grid-area: 1 / 1;
    display: contents;
  }

  /* On the mass, in mint. Long for a display line (the copy stays), so it is
     set at H1 scale rather than the 96px display size. */
  .hero-h1 {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    justify-self: end;
    width: calc(100vw - var(--h1-left) - var(--edge));
    max-width: 700px;
    color: var(--mint-500);
    font: 800 var(--fs-h1) / 0.92 var(--font-sans);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    align-self: end;
    width: min(440px, calc(var(--mass-left) - var(--edge) - 56px));
    display: grid;
    gap: 24px;
  }

  .hero-lead {
    font: 400 18px / 1.55 var(--font-sans);
    color: var(--ink-900);
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* A sentence, so Epilogue: the system keeps mono for caps labels. */
  .hero-social {
    font: 400 14px / 1.5 var(--font-sans);
    color: var(--ink-900);
    text-wrap: pretty;
  }

  /* The stop control for the loop (WCAG 2.2.2: anything that moves for more
     than five seconds next to other content can be stopped). It sits on the
     mass, in the band under the headline, so it is the system's secondary
     button on ink: an on-ink ring, the ink-700 step on hover, the system's
     own focus ring. Shown only while there is a loop to stop. */
  .hero-pause {
    --btn-hover: var(--ink-700);
    position: absolute;
    z-index: 2;
    right: var(--edge);
    bottom: max(12px, calc((var(--h1-bottom) - 36px) / 2));
    width: 36px;
    height: 36px;
    min-height: 36px;
    padding: 0;
  }
  /* the glyphs are Icon.astro's own elements, outside this file's scope */
  .hero-pause[aria-pressed='false'] :global(.hero-pause-i--play),
  .hero-pause[aria-pressed='true'] :global(.hero-pause-i--pause) {
    display: none;
  }

  /* ---- entrance without the script: the mass falls in, the satellite drops */
  @media (prefers-reduced-motion: no-preference) {
    /* The system's entry: 240–400ms on the fall curve. */
    .hero-mass {
      animation: mass-fall var(--dur-slow) var(--ease-fall) both;
    }
    .hero-satellite {
      animation: satellite-drop var(--dur-slow) var(--ease-fall) 80ms both;
    }
    .hero-h1 {
      animation: h1-rise var(--dur-slow) var(--ease-fall) 120ms both;
    }
  }
  @keyframes mass-fall {
    from {
      transform: translate(5%, 9%);
    }
  }
  @keyframes satellite-drop {
    from {
      transform: translate(-120%, -160%);
      opacity: 0;
    }
  }
  @keyframes h1-rise {
    from {
      transform: translateY(18px);
      opacity: 0;
    }
  }

  /* ---- with the script: the states hero-fall.js moves the hero through ----
     pre, ready  the empty field the mass will fall into; the headline is
                 already there, in ink, because it is on the field
     in          the mass is falling; the headline is cut into mint and ink
                 exactly along the mass's edge (a hard-stop gradient clipped
                 to the glyphs, moved with the mass every frame)
     on          at rest: the static composition, the loop drawn over it
     data-sat="fx" means the loop draws the satellite, so this one steps
     aside; a frame where the loop can't run keeps it. */
  .hero[data-anim] .hero-mass,
  .hero[data-anim] .hero-satellite,
  .hero[data-anim] .hero-h1 {
    animation: none;
  }
  .hero[data-anim='pre'] .hero-mass,
  .hero[data-anim='ready'] .hero-mass,
  .hero[data-anim='pre'] .hero-satellite,
  .hero[data-anim='ready'] .hero-satellite,
  .hero[data-anim='in'] .hero-satellite,
  .hero[data-sat='fx'] .hero-satellite {
    visibility: hidden;
  }
  .hero[data-anim='pre'] .hero-h1,
  .hero[data-anim='ready'] .hero-h1 {
    color: var(--ink-900);
  }
  .hero[data-anim='in'] .hero-mass {
    will-change: transform;
  }
  .hero[data-anim='in'] .hero-h1 {
    color: transparent;
    background: radial-gradient(
      circle at var(--hx, -10000px) var(--hy, -10000px),
      var(--mint-500) calc(var(--hr, 0px) - 0.5px),
      var(--ink-900) calc(var(--hr, 0px) + 0.5px)
    );
    -webkit-background-clip: text;
    background-clip: text;
  }
  .hero[data-anim='on']:not([data-sat]) .hero-satellite {
    animation: satellite-drop var(--dur-slow) var(--ease-fall) both;
  }
  @media (forced-colors: active) {
    .hero[data-anim='in'] .hero-h1 {
      background: none;
      color: CanvasText;
    }
  }
  @media print {
    .hero[data-anim] .hero-mass,
    .hero[data-anim] .hero-satellite {
      visibility: visible;
      transform: none !important; /* the script's inline transform */
    }
    .hero[data-anim] .hero-h1 {
      background: none;
      color: var(--mint-500);
    }
    .hero-fx,
    .hero-pause {
      display: none;
    }
  }

  /* ---- below 1000px: the frame turns over ------------------------------- */
  @media (max-width: 999.98px) {
    .hero {
      display: block;
      min-height: 0;
    }
    .hero-grid {
      padding-bottom: 64px;
    }
    .hero-stage {
      grid-area: auto;
      display: block;
      position: relative;
      padding: clamp(36px, 8vw, 64px) 0 clamp(64px, 12vw, 96px);
    }
    /* Anchored to the stage's bottom: the arc's lowest point sits 44px under
       the headline box, and the circle is wide enough that every line of
       text is inside it edge to edge. */
    .hero-mass {
      --d: max(190vw, 720px);
      left: 50%;
      bottom: -44px;
      translate: -50% 0;
    }
    .hero-h1 {
      grid-area: auto;
      width: auto;
      max-width: 640px;
      justify-self: start;
      font-size: clamp(34px, 8vw, 56px);
    }
    .hero-copy {
      grid-area: auto;
      width: auto;
      max-width: 560px;
      padding-top: 72px;
    }
    /* No satellite in the turned frame. Placed under the arc it either
       grazed the mass (the arc's height there varies with the width) or,
       at the system's 5–10% of a mass this size, crowded the copy; the
       system allows one satellite at most, and none is one. The loop needs
       one, so the turned frame has the entrance only. */
    .hero-satellite,
    .hero-fx,
    .hero-pause {
      display: none;
    }
  }
</style>
