---
/* /integracje/ grid — restyled to match the site design language
   (Epilogue type, slate/green palette, the homepage clients-wall grid). */
import { getCollection } from 'astro:content';
import { localeOf, t } from '../i18n/ui';
const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const categories = (await getCollection('integrationCategories'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((c) => ({
    id: c.id,
    items: c.data.items.map((it) => ({
      name: it.name,
      sub: lang === 'en' ? (it.sub_en ?? it.sub) : it.sub,
    })),
    /* The *_en fields fall back to Polish so an untranslated category is
       visibly Polish rather than invisibly missing. */
    title: lang === 'en' ? (c.data.title_en ?? c.data.title) : c.data.title,
    description: lang === 'en' ? (c.data.description_en ?? c.data.description) : c.data.description,
  }));
const total = categories.reduce((n, c) => n + c.items.length, 0);
const badges = ['REST API', 'SOAP', 'GraphQL', 'FTP/SFTP', 'ODBC', 'Webhooks', 'Kafka', 'MQTT', 'EDI'];
---

<section class="gi-int" data-scroll data-scroll-repeat>
  <div class="gi-int-wrap">
    <div class="gi-int-intro" data-scroll data-scroll-opacity>
      <div class="gi-int-num">139+</div>
      <p class="gi-int-sub" set:html={s('int.subHtml')} />
      <div class="gi-int-badges">
        {badges.map((b) => <span class="gi-int-badge">{b}</span>)}
      </div>
    </div>

    {
      categories.map((cat) => (
        <div class="gi-int-cat" data-scroll data-scroll-opacity>
          <div class="gi-int-cat-head" id={cat.id}>
            <h2>{cat.title}</h2>
            <span class="gi-int-count">{cat.items.length}</span>
          </div>
          <p class="gi-int-desc" set:html={cat.description} />
          <div class="gi-int-grid">
            {cat.items.map((item) => (
              <div class="gi-int-tile">
                <span class="gi-int-name">{item.name}</span>
                {item.sub && <span class="gi-int-tag">{item.sub}</span>}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

{total !== 139 && <p style="display:none" data-count-warning>integration count {total} ≠ 139</p>}

<style>
  /* Local short names for the global tokens, the convention DownloadPage
     already used. They were bare literals here — the same eight values
     re-decided in four components, which is how a design system stops being
     one. Renaming stays local; the values are the system's. */
  .gi-int {
    --ink: var(--gi-text-on-light);
    --body: var(--gi-bg-slate);
    --muted: var(--gi-text-muted-slate);
    --green: var(--gi-green);
    --green-deep: var(--gi-green-deep);
    --line: var(--gi-line);
    font-family: Epilogue, system-ui, sans-serif;
    background: var(--gi-bg-light);
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(3.5rem, 7vw, 6rem);
  }
  .gi-int-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* intro */
  .gi-int-intro {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(3rem, 6vw, 4.5rem);
  }
  /* The count is the page's headline fact, so it has to be readable, not just
     bright: #27ea93 on white measures 1.58:1, under the 3:1 large-text floor.
     DESIGN.md's own rule — green on light is always the deep green — applies. */
  .gi-int-num {
    font-size: clamp(3rem, 7vw, 4.25rem);
    font-weight: 800;
    color: var(--green-deep);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .gi-int-sub {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--body);
    margin: 1rem 0 0;
  }
  .gi-int-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.75rem;
  }
  .gi-int-badge {
    background: rgba(39, 234, 147, 0.1);
    color: var(--green-deep);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
  }

  /* category */
  .gi-int-cat {
    margin-top: clamp(2.75rem, 5vw, 4rem);
  }
  .gi-int-cat-head {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.85rem;
    margin-bottom: 1.1rem;
  }
  .gi-int-cat-head h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .gi-int-count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  /* `max-width: 780px` was a one-off implementation of the measure concept:
     a pixel width picked by eye, frozen against a font size it doesn't know.
     At this component's 15.68px Epilogue it resolves to 88ch — thirteen
     category descriptions, every one of them past the point where the eye
     starts losing the line it is returning to. The token is the same idea
     said properly, and `ch` means it stays correct if the type size moves. */
  .gi-int-desc {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: var(--gi-measure);
    margin: 0 0 1.5rem;
  }

  /* tiles — same bordered-cell grid as the homepage clients wall */
  .gi-int-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .gi-int-tile {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    min-height: 92px;
    padding: 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    text-align: center;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .gi-int-tile:hover {
    background: rgba(39, 234, 147, 0.06);
  }
  .gi-int-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
    transition: color 0.2s ease;
  }
  .gi-int-tile:hover .gi-int-name {
    color: var(--green-deep);
  }
  .gi-int-tag {
    font-size: 0.72rem;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .gi-int-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gi-int-tile {
      min-height: 84px;
      padding: 0.9rem 0.6rem;
    }
  }
</style>
