---
/* /integracje/ and /en/integrations/ — the directory.

   The page exists so a buyer can find their own system by name. So: the
   count first, as the system's stat card (ink, the mint mass, the number at
   display size with its "+" in mint); then the thirteen categories as chips
   that jump straight to the category; then each category as the house
   bordered-cell grid, the name in Epilogue and the vendor in mono. */
import { getCollection } from 'astro:content';
import { localeOf, t } from '../i18n/ui';
const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const categories = (await getCollection('integrationCategories'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((c) => ({
    id: c.id,
    items: c.data.items.map((it) => ({
      name: it.name,
      sub: lang === 'en' ? (it.sub_en ?? it.sub) : it.sub,
    })),
    /* The *_en fields fall back to Polish so an untranslated category is
       visibly Polish rather than invisibly missing. */
    title: lang === 'en' ? (c.data.title_en ?? c.data.title) : c.data.title,
    description: lang === 'en' ? (c.data.description_en ?? c.data.description) : c.data.description,
  }));
const total = categories.reduce((n, c) => n + c.items.length, 0);
const badges = ['REST API', 'SOAP', 'GraphQL', 'FTP/SFTP', 'ODBC', 'Webhooks', 'Kafka', 'MQTT', 'EDI'];
---

<section class="int section surface-white">
  <div class="container">
    <div class="int-intro">
      <div class="int-stat surface-ink" data-reveal>
        <span class="mass int-mass" style="--mass-color: var(--mint-500)" aria-hidden="true"></span>
        <p class="int-num">139<span>+</span></p>
        <p class="int-sub" set:html={s('int.subHtml')} />
      </div>
      <div class="int-side" data-reveal>
        <ul class="int-badges" role="list">
          {badges.map((b) => <li class="badge badge--dot">{b}</li>)}
        </ul>
        <nav class="int-jump" aria-label={s('int.jumpAria')}>
          <ul role="list">
            {
              categories.map((cat) => (
                <li>
                  <a href={`#${cat.id}`}>
                    {cat.title}
                    <span class="int-jump-n">{cat.items.length}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    {
      categories.map((cat) => (
        <div class="int-cat" data-reveal>
          <div class="int-cat-head" id={cat.id}>
            <h2>{cat.title}</h2>
            <span class="badge">{String(cat.items.length).padStart(2, '0')}</span>
          </div>
          <p class="int-desc" set:html={cat.description} />
          <ul class="int-grid" role="list">
            {cat.items.map((item) => (
              <li class="int-tile">
                <span class="int-name">{item.name}</span>
                {item.sub && <span class="int-tag">{item.sub}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

{total !== 139 && <p style="display:none" data-count-warning>integration count {total} ≠ 139</p>}

<style>
  .int-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  @media (min-width: 960px) {
    .int-intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: stretch;
    }
  }

  .int-stat {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    align-content: space-between;
    gap: 40px;
    min-height: 320px;
    padding: 32px;
    border-radius: var(--radius-xl);
  }
  /* bottom-right and small, so the sentence beside it stays on the ink */
  .int-mass {
    z-index: -1;
    width: 220px;
    right: -90px;
    bottom: -110px;
  }
  .int-num {
    font: 800 clamp(96px, 12vw, 152px) / 0.8 var(--font-sans);
    letter-spacing: -0.07em;
    color: var(--on-ink);
  }
  .int-num span {
    color: var(--mint-500);
  }
  .int-sub {
    max-width: min(18rem, calc(100% - 110px));
    font: 400 var(--fs-body-lg) / 1.55 var(--font-sans);
    color: var(--on-ink-soft);
  }
  /* On a phone the sentence can't share its row with the mass, so it takes
     the full width and the mass drops below it. */
  @media (max-width: 479.98px) {
    .int-stat {
      padding-bottom: 124px;
    }
    .int-sub {
      max-width: none;
    }
  }

  .int-side {
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .int-badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .int-jump ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .int-jump a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 8px 0 16px;
    border: 1.5px solid var(--ink-900);
    border-radius: var(--radius-pill);
    font: 600 14px / 1.2 var(--font-sans);
    color: var(--ink-900);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }
  .int-jump a:hover {
    background: var(--ink-900);
    color: var(--on-ink);
  }
  .int-jump-n {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--mist-100);
    color: var(--ink-900);
    font: 500 11px / 1 var(--font-mono);
  }

  /* ---- a category ---- */
  .int-cat {
    padding-top: clamp(40px, 5vw, 64px);
  }
  .int-cat-head {
    display: flex;
    align-items: center;
    gap: 14px;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .int-cat-head h2 {
    font: 800 var(--fs-h2) / 1 var(--font-sans);
    letter-spacing: -0.045em;
  }
  .int-desc {
    max-width: 44rem;
    margin: 12px 0 24px;
    font: 400 16px / 1.6 var(--font-sans);
    color: var(--slate-600);
  }
  .int-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(50%, 200px), 1fr));
    border-top: 1px solid var(--mist-200);
    border-left: 1px solid var(--mist-200);
  }
  .int-tile {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-height: 84px;
    padding: 16px 20px;
    border-right: 1px solid var(--mist-200);
    border-bottom: 1px solid var(--mist-200);
  }
  @media (max-width: 599.98px) {
    .int-tile {
      min-height: 72px;
      padding: 12px 14px;
    }
  }
  .int-name {
    font: 600 15px / 1.25 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink-900);
  }
  .int-tag {
    font: 400 11px / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--muted);
  }
</style>
