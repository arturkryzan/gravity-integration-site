---
/* Newsletter section (theme newsletter.php + CF7 form 48), on pages with the
   content's `newsletter` flag. Posts straight to MailerLite — form
   "gravity.integration — Newsletter (www)", group GRAVITY. With JS off the
   form posts natively; src/scripts/ml-forms.ts only improves it.

   v2: the system's CTA card — mint field, the ink mass cropped into the
   corner away from the form. */
import { mlAction } from '../lib/mailerlite';
import Icon from './ui/Icon.astro';
import { localeOf, t } from '../i18n/ui';
import { typeset, escapeHtml } from '../lib/html';
const action = mlAction('newsletter');
const s = t(localeOf(Astro.currentLocale));
---

<section class="nl section surface-white" id="newsletter">
  <div class="container">
    <div class="nl-card surface-mint" data-reveal>
      <span class="mass nl-mass" aria-hidden="true"></span>
      <span class="satellite nl-sat" aria-hidden="true"></span>
      <div class="nl-copy">
        <h2 class="nl-h" set:html={typeset(escapeHtml(s('nl.h2')))} />
        <p class="nl-p">{s('nl.p')}</p>
      </div>
      <form
        action={action}
        data-form="newsletter"
        method="post"
        target="_blank"
        class="sform nl-form"
        aria-label={s('nl.form.aria')}
        data-status="init"
      >
        <div class="field">
          <label class="field-label" for="nl-email">{s('form.emailLabel')}</label>
          <div class="form-control">
            <input
              class="input"
              id="nl-email"
              type="email"
              name="fields[email]"
              required
              aria-required="true"
              aria-invalid="false"
              autocomplete="email"
              inputmode="email"
              maxlength="400"
            />
          </div>
        </div>
        <label class="check">
          <input type="checkbox" name="acceptance-513" value="1" required data-ml-consent aria-invalid="false" />
          <span class="check-box" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false"><path d="M4.5 10.4 8.3 14.1 15.5 6.5"></path></svg>
          </span>
          <span>{s('nl.consent')}</span>
        </label>
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <div class="sform-actions">
          <button type="submit" class="btn btn--primary btn--lg form-submit">
            <span class="form-submit-label">{s('nl.submit')}</span>
            <Icon name="mail" size={16} />
          </button>
        </div>
        <div class="form-output" role="status" aria-live="polite" hidden></div>
      </form>
    </div>
  </div>
</section>

<script>
  import { mlAction } from '../lib/mailerlite';
  import { initMlSimpleForm } from '../scripts/ml-forms';
  import { pick } from '../i18n/client';
  document.querySelectorAll<HTMLFormElement>('form[data-form="newsletter"]').forEach((form) =>
    initMlSimpleForm(form, {
      action: mlAction('newsletter'),
      success: pick({
        pl: 'Jesteś na liście. Do zobaczenia w skrzynce raz w miesiącu.',
        en: "You're on the list. See you in your inbox once a month.",
      }),
      event: 'newsletter_subscribed',
    }),
  );
</script>

<style>
  .nl-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--radius-xl);
  }
  @media (min-width: 900px) {
    .nl-card {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      padding-bottom: clamp(160px, 16vw, 220px);
    }
  }
  /* bottom-left, under the copy; the form keeps the field */
  .nl-mass {
    z-index: -1;
    width: clamp(380px, 40vw, 600px);
    left: clamp(-180px, -8vw, -80px);
    bottom: clamp(-460px, -30vw, -300px);
  }
  /* the satellite sits opposite the crop: top-right */
  .nl-sat {
    z-index: -1;
    width: 32px;
    right: 28px;
    top: 28px;
  }
  .nl-copy {
    display: grid;
    gap: 16px;
    align-content: start;
    max-width: 34rem;
  }
  .nl-h {
    font: 800 var(--fs-h2) / 1 var(--font-sans);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .nl-p {
    font: 400 var(--fs-body-lg) / 1.6 var(--font-sans);
    color: var(--ink-900);
  }
  .nl-form .check {
    color: var(--ink-900);
    font-size: 12px;
  }
  @media (max-width: 899.98px) {
    .nl-card {
      padding-bottom: 170px;
    }
    .nl-mass {
      width: 360px;
      left: -120px;
      bottom: -260px;
    }
    .nl-sat {
      width: 24px;
      right: 20px;
      top: 20px;
    }
  }
</style>
