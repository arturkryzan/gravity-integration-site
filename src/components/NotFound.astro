---
/* The 404 body, shared by both locales.
   Apache serves it via ErrorDocument (see public/.htaccess): / and everything
   Polish gets dist/404.html, anything under /en/ gets dist/en/404.html. The two
   page files are thin wrappers so that this markup — and the styles under it —
   exist once.

   The recovery links resolve through linkUrl(), so an English visitor who
   mistyped a URL is offered English pages rather than being dropped back into
   Polish. */
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';

const lang = localeOf(Astro.currentLocale);
const s = t(lang);

const [download, home, cases, contact] = await Promise.all([
  linkUrl('pobieranie', lang),
  linkUrl('home', lang),
  linkUrl('case-studies', lang),
  linkUrl('kontakt', lang),
]);
---

<div class="nf-page">
<section class="nf surface-mint">
  <span class="nf-mass" aria-hidden="true"></span>
  <span class="nf-sat" aria-hidden="true"></span>
  <p class="nf-code" aria-hidden="true">404</p>
  <div class="nf-in">
    <h1 class="nf-h">{s('nf.h')}</h1>
    <p class="nf-p" set:html={s('nf.pHtml')} />
    <nav class="nf-links" aria-label={s('nf.nav.aria')}>
      <a class="btn btn--primary btn--lg" href={download}>{s('nf.download')}<span class="btn-dot" aria-hidden="true"></span></a>
      <a class="btn btn--secondary btn--lg" href={home}>{s('nav.home')}</a>
      <a class="btn btn--secondary btn--lg" href={cases}>{s('nf.cases')}</a>
      <a class="btn btn--secondary btn--lg" href={contact}>{s('nav.contact')}</a>
    </nav>
  </div>
</section>
</div>

<style>
  /* "A · Corner fall" — the page that lost its way falls into the mass.
     The number sits on the mass in mint; the way out sits on the field. */
  /* The frame is a panel on the white page, so the mass is cropped by the
     panel — and the page ends on white before the ink footer, like every
     other page. */
  .nf-page {
    padding: 8px var(--gutter) clamp(64px, 8vw, 96px);
  }
  .nf {
    --d: max(560px, 54vw);
    --edge: clamp(28px, 6vw, 88px);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    max-width: calc(var(--container) + 2 * var(--gutter) + 96px);
    margin-inline: auto;
    min-height: clamp(560px, 72vh, 780px);
    display: flex;
    align-items: center;
    padding: clamp(40px, 6vw, 80px) var(--edge);
    border-radius: var(--radius-xl);
  }
  .nf-mass {
    position: absolute;
    z-index: -1;
    width: var(--d);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink-900);
    left: 50%;
    top: 16%;
  }
  .nf-sat {
    position: absolute;
    z-index: -1;
    width: calc(var(--d) * 0.07);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink-900);
    left: 44%;
    top: 9%;
  }
  /* The number is centred on the mass and sized from it, so it stays well
     inside the circle (the system asks for 8% in from its edge) at every
     width — set independently, its corner crossed the edge onto the field,
     mint on mint. */
  .nf-code {
    position: absolute;
    z-index: 0;
    left: calc(50% + var(--d) / 2);
    top: calc(16% + var(--d) / 2);
    translate: -50% -50%;
    font: 800 calc(var(--d) * 0.3) / 0.8 var(--font-sans);
    letter-spacing: -0.07em;
    color: var(--mint-500);
    white-space: nowrap;
  }
  .nf-in {
    position: relative;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  /* 38vw keeps the copy's longest lines clear of the mass's left edge from
     900px up (42vw let the paragraph touch it at 900–1000). */
  @media (min-width: 900px) {
    .nf-in > * {
      max-width: min(520px, 38vw);
    }
  }
  .nf-h {
    max-width: 11em;
    font: 800 var(--fs-h1) / 0.92 var(--font-sans);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .nf-p {
    max-width: 30rem;
    font: 400 var(--fs-body-lg) / 1.6 var(--font-sans);
    color: var(--ink-900);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 34rem;
    margin-top: 8px;
  }
  /* One column: the mass rises from the panel's bottom edge, centred, and
     the number sits in the middle of its cap. */
  @media (max-width: 899.98px) {
    .nf {
      display: block;
      padding-bottom: 300px;
    }
    .nf-mass {
      left: 50%;
      translate: -50% 0;
      top: auto;
      bottom: calc(var(--d) * -0.55);
    }
    .nf-sat {
      display: none;
    }
    .nf-code {
      left: 50%;
      top: auto;
      bottom: 40px;
      translate: -50% 0;
      font-size: calc(var(--d) * 0.22);
    }
  }
</style>
