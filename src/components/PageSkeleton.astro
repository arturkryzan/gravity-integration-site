---
/**
 * Phase-1 placeholder renderer.
 * Proves the content pipeline end-to-end (URL parity + verbatim SEO meta +
 * real section data). Replaced by real components in Phase 2.
 */
interface Props {
  page: {
    url: string;
    h1: string;
    sections: Array<Record<string, any>>;
  };
}
const { page } = Astro.props;
const stripTags = (s: string) => (s || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
---

<main>
  <p class="badge">Phase 1 skeleton — sekcje z migracji, komponenty w Phase 2</p>
  <h1 set:html={page.h1 || page.url} />
  <ol>
    {
      page.sections.map((s) => (
        <li>
          <strong>{s.acf_fc_layout}</strong>
          {s.nav_li && <em> · {s.nav_li}</em>}
          <p>{stripTags(s.text ?? s.repeater?.[0]?.text ?? '').slice(0, 160)}…</p>
        </li>
      ))
    }
  </ol>
</main>

<style>
  main {
    max-width: var(--gi-container);
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }
  .badge {
    display: inline-block;
    background: var(--gi-green);
    color: #fff;
    font-family: var(--gi-font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
  }
  li {
    margin-bottom: 0.75rem;
  }
</style>
