---
/* ROI calculator (was snippet 19) — HTML/CSS/JS ported verbatim.

   Phase 3 moved the interface strings into ui.ts. The inline script gets its
   strings through define:vars (`R`), resolved server-side per locale — it is
   `is:inline`, embedded per page, so there is no shared bundle to language-
   switch at runtime. That includes the number-format locale: 2 999 in Polish,
   2,999 in English. */
import site from '../data/site.json';
import { linkUrl } from '../i18n/routes';
import { localeOf, t } from '../i18n/ui';

const lang = localeOf(Astro.currentLocale);
const s = t(lang);

/* The CTA was ported as an absolute URL; keep that shape, localise the path. */
const ctaHref = new URL(await linkUrl('pobieranie', lang), site.siteUrl).href;

/* Everything the inline script says. `GI`, not `R` — the ported script's
   calc() declares `var …,R=+sl.r.value,…` (the day rate), which would shadow
   a define:vars `R` and break every lookup inside it. */
/* The sliders' starting positions. These were inline literals in the ported
   markup, in two places each: the <input value> and the number rendered beside
   it. The rendered one was hard-coded "1 500" with a non-breaking space, which
   was wrong twice over.

   On the English page it was Polish grouping, corrected on the first script
   tick and never corrected at all with JS off.

   On the Polish page it disagreed with the calculator's own output. CLDR gives
   Polish minimumGroupingDigits 2, so four-digit numbers are not grouped at all:
   (1500).toLocaleString('pl-PL') is "1500", and "12 000" only starts grouping
   at five digits. The static markup said 1 500; the moment you touched the
   slider the same span said 1500. Formatting both defaults through the same
   locale the script uses settles it, and naming them once stops the <input>
   value and its label drifting apart later. */
const RATE_DEFAULT = 1500;
const TOOLS_DEFAULT = 0;
const nf = new Intl.NumberFormat(s('roi.numberLocale'));

const GI = {
  locale: s('roi.numberLocale'),
  days: s('roi.days.unit'),
  thCurrent: s('roi.th.current'),
  thGravity: s('roi.th.gravity'),
  thSavings: s('roi.th.savings'),
  rows: [s('roi.row.dev'), s('roi.row.test'), s('roi.row.deploy'), s('roi.row.maint')],
  rowTools: s('roi.row.tools'),
  rowTotal: s('roi.row.total'),
  pln: s('roi.pln.unit'),
};
---

<section id="scroll-calc" class="roi-band section surface-white">
  <div class="container">

<!-- is:global is required, not incidental: the breakdown rows are injected by the
     inline script below, so they never carry Astro's scoping attribute. Scoped,
     every `.gi-breakdown tr/td` rule silently missed the generated rows. Every
     selector here is namespaced under #gi-roi-calculator / .gi-*. -->
<style is:global>
/* v2: the calculator is the system's heavy frame — an ink panel with the
   mint mass cropped into its corner. Inputs are ink-700 cards; results are
   metrics, so they are set like the system's stat: large, mint on ink.
   The "today" bar is slate, not red — tone is a dot, never a fill — and the
   gravity bar is a mint field.

   Still is:global: the breakdown rows are injected by the inline script
   and never carry Astro's scoping attribute. Every selector is namespaced
   under #gi-roi-calculator / .gi-*. */
#gi-roi-calculator{position:relative;overflow:hidden;isolation:isolate;padding:clamp(28px,5vw,64px);border-radius:var(--radius-xl);background:var(--ink-900);color:var(--on-ink-soft);font-family:var(--font-sans)}
#gi-roi-calculator .gi-roi-mass{position:absolute;z-index:-1;width:clamp(300px,34vw,480px);aspect-ratio:1;border-radius:50%;background:var(--mint-500);right:clamp(-220px,-12vw,-120px);top:clamp(-300px,-17vw,-170px);pointer-events:none}
#gi-roi-calculator h2{max-width:18em;margin:0 0 16px;color:var(--on-ink);font:800 clamp(30px,3.6vw,46px)/1 var(--font-sans);letter-spacing:-.05em;text-wrap:balance}
/* "gravity.integration" is one 263px word at 30px — wider than the panel on
   a 320px phone. Below 600px the heading scales with the viewport. */
@media (max-width:599.98px){#gi-roi-calculator h2{font-size:clamp(22px,7.4vw,30px)}}
/* One column: the heading would run under the mass, so the mass shrinks
   and the panel opens room above the heading for it. */
@media (max-width:899.98px){
  #gi-roi-calculator{padding-top:140px}
  #gi-roi-calculator .gi-roi-mass{width:280px;right:-110px;top:-170px}
}
#gi-roi-calculator .gi-roi-disclaimer{max-width:var(--measure);margin:0 0 clamp(32px,4vw,48px);font:400 14px/1.6 var(--font-sans);color:var(--on-ink-soft)}
.gi-calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
@media(max-width:768px){.gi-calc-grid{grid-template-columns:1fr}}
.gi-calc-card{padding:24px;border-radius:var(--radius-lg);background:var(--ink-700)}
.gi-calc-card h3{margin:0 0 20px;font:500 12px/1.3 var(--font-mono);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--mint-500)}
.gi-slider-group{margin-bottom:18px}
.gi-slider-group:last-child{margin-bottom:0}
.gi-slider-label{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:6px;font:400 14px/1.4 var(--font-sans);color:var(--on-ink-soft)}
.gi-slider-label label{cursor:pointer;margin:0}
.gi-slider-value{min-width:80px;text-align:right;font:500 15px/1 var(--font-mono);color:var(--on-ink)}
/* 32px tall input = the real touch target; the visible 4px track is drawn by
   the pseudo-elements, filled to the thumb by --pct (set by the script). */
.gi-range{-webkit-appearance:none;appearance:none;width:100%;height:32px;margin:0;background:transparent;outline:none;cursor:pointer;--pct:50%}
.gi-range::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:linear-gradient(to right,var(--mint-500) var(--pct),var(--ink-900) var(--pct))}
.gi-range::-moz-range-track{height:4px;border-radius:2px;background:var(--ink-900)}
.gi-range::-moz-range-progress{height:4px;border-radius:2px;background:var(--mint-500)}
.gi-range::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:20px;height:20px;margin-top:-8px;border-radius:50%;background:var(--mint-500);border:3px solid var(--ink-700);cursor:pointer;transition:box-shadow var(--dur-fast) ease}
.gi-range::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:var(--mint-500);border:3px solid var(--ink-700);cursor:pointer;transition:box-shadow var(--dur-fast) ease}
@media (hover:hover){
  .gi-range:hover::-webkit-slider-thumb{box-shadow:0 0 0 4px var(--ink-900)}
  .gi-range:hover::-moz-range-thumb{box-shadow:0 0 0 4px var(--ink-900)}
}
/* The focus ring is drawn on the thumb — the system's white gap + mint ring. */
.gi-range:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 2px var(--white),0 0 0 5px var(--mint-500)}
.gi-range:focus-visible::-moz-range-thumb{box-shadow:0 0 0 2px var(--white),0 0 0 5px var(--mint-500)}
.gi-range:focus-visible{box-shadow:none;outline:none}
@media (prefers-reduced-motion:reduce){
  .gi-range::-webkit-slider-thumb{transition:none}
  .gi-range::-moz-range-thumb{transition:none}
}
.gi-kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px}
@media(max-width:768px){.gi-kpi-row{grid-template-columns:1fr}}
.gi-kpi{padding:24px;border-radius:var(--radius-lg);background:var(--ink-700)}
.gi-kpi-value{font:800 clamp(34px,3.6vw,48px)/.9 var(--font-sans);letter-spacing:-.05em;color:var(--mint-500)}
.gi-kpi-label{margin-top:12px;font:500 11px/1.4 var(--font-mono);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--on-ink-soft)}
.gi-chart-container{margin-bottom:28px;padding:24px;border-radius:var(--radius-lg);background:var(--ink-700)}
.gi-chart-container h3{margin:0 0 20px;font:500 12px/1.3 var(--font-mono);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--mint-500)}
.gi-bar-wrap{display:flex;align-items:center;gap:16px;margin-bottom:12px}
.gi-bar-wrap:last-child{margin-bottom:0}
.gi-bar-label{width:88px;flex-shrink:0;text-align:right;font:500 12px/1.2 var(--font-mono);color:var(--on-ink-soft)}
.gi-bar-track{position:relative;flex:1;height:36px;overflow:hidden;border-radius:var(--radius-pill);background:var(--ink-900)}
.gi-bar-fill{position:absolute;inset:0;display:flex;align-items:center;justify-content:flex-end;padding-right:14px;border-radius:var(--radius-pill);font:500 12px/1 var(--font-mono);color:var(--ink-900);transform:translateX(-100%);transition:transform var(--dur-slow) var(--ease-fall)}
.gi-bar-fill.current{background:var(--slate-400)}
.gi-bar-fill.gravity{background:var(--mint-500)}
@media(prefers-reduced-motion:reduce){.gi-bar-fill{transition:none}}
/* Narrow phones: the value sits inside the fill, right-aligned, and a fill at
   half of a 120px track is too short to show "15 dni" whole. The label moves
   above the bar and the track takes the full width. */
@media(max-width:419.98px){
  .gi-bar-wrap{flex-wrap:wrap;gap:6px 16px}
  .gi-bar-label{width:100%;text-align:left}
}
.gi-breakdown{width:100%;margin-bottom:8px;border-collapse:collapse}
.gi-breakdown th,.gi-breakdown td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--ink-700)}
.gi-breakdown th{font:500 11px/1.3 var(--font-mono);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--on-ink-soft)}
.gi-breakdown td{font:400 14px/1.4 var(--font-sans);color:var(--on-ink);font-variant-numeric:tabular-nums}
.gi-breakdown .gi-savings{color:var(--mint-500);font-weight:600}
.gi-cta-box{display:flex;justify-content:flex-start;padding-top:24px}
@media(max-width:600px){
  .gi-breakdown,.gi-breakdown thead,.gi-breakdown tbody,.gi-breakdown tr,.gi-breakdown th,.gi-breakdown td{display:block}
  .gi-breakdown{border-collapse:separate}
  .gi-breakdown thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .gi-breakdown tr{margin-bottom:10px;padding:4px 16px 10px;border-radius:var(--radius-md);background:var(--ink-700)}
  .gi-breakdown td{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:6px 0;border-bottom:none;text-align:right}
  .gi-breakdown td:first-child{margin-bottom:4px;padding-bottom:8px;border-bottom:1px solid var(--ink-900);font-weight:600;text-align:left}
  .gi-breakdown td[data-label]::before{content:attr(data-label);font:500 11px/1.3 var(--font-mono);letter-spacing:.04em;text-transform:uppercase;color:var(--on-ink-soft);text-align:left}
}
</style>

<div id="gi-roi-calculator">
  <span class="gi-roi-mass" aria-hidden="true"></span>
  <h2>{s('roi.h2')}</h2>
  {/* `max-width:640px` was a pixel width picked by eye and frozen against a
      font size it doesn't know: at this paragraph's 14.4px it resolves to
      78ch. It is centred with `margin: 0 auto`, so the token just makes the
      centred block narrower — there is no panel to re-lay-out, which is why
      the earlier note calling this an unavoidable exception was wrong. */}
  <p class="gi-roi-disclaimer">{s('roi.disclaimer')}</p>

  <div class="gi-calc-grid">
    <div class="gi-calc-card">
      <h3>{s('roi.params.h3')}</h3>
      <div class="gi-slider-group">
        <div class="gi-slider-label"><label for="s-projects">{s('roi.slider.projects')}</label><span class="gi-slider-value" id="v-projects">3</span></div>
        <input type="range" class="gi-range" id="s-projects" min="1" max="20" value="3">
      </div>
      <div class="gi-slider-group">
        <div class="gi-slider-label"><label for="s-days">{s('roi.slider.days')}</label><span class="gi-slider-value" id="v-days">30</span></div>
        <input type="range" class="gi-range" id="s-days" min="5" max="120" value="30">
      </div>
      <div class="gi-slider-group">
        <div class="gi-slider-label"><label for="s-team">{s('roi.slider.team')}</label><span class="gi-slider-value" id="v-team">2</span></div>
        <input type="range" class="gi-range" id="s-team" min="1" max="10" value="2">
      </div>
    </div>
    <div class="gi-calc-card">
      <h3>{s('roi.costs.h3')}</h3>
      <div class="gi-slider-group">
        <div class="gi-slider-label"><label for="s-rate">{s('roi.slider.rate')}</label><span class="gi-slider-value" id="v-rate">{nf.format(RATE_DEFAULT)}</span></div>
        <input type="range" class="gi-range" id="s-rate" min="500" max="4000" step="100" value={RATE_DEFAULT} aria-valuetext={nf.format(RATE_DEFAULT) + s('roi.pln.unit')}>
      </div>
      <div class="gi-slider-group">
        <div class="gi-slider-label"><label for="s-tool">{s('roi.slider.tools')}</label><span class="gi-slider-value" id="v-tool">{nf.format(TOOLS_DEFAULT)}</span></div>
        <input type="range" class="gi-range" id="s-tool" min="0" max="200000" step="1000" value={TOOLS_DEFAULT} aria-valuetext={nf.format(TOOLS_DEFAULT) + s('roi.pln.unit')}>
      </div>
    </div>
  </div>

  <div class="gi-kpi-row">
    <div class="gi-kpi"><div class="gi-kpi-value" id="kpi-save">—</div><div class="gi-kpi-label">{s('roi.kpi.save')}</div></div>
    <div class="gi-kpi"><div class="gi-kpi-value" id="kpi-extra">—</div><div class="gi-kpi-label">{s('roi.kpi.extra')}</div></div>
    <div class="gi-kpi"><div class="gi-kpi-value" id="kpi-roi">—</div><div class="gi-kpi-label">{s('roi.kpi.roi')}</div></div>
  </div>

  <div class="gi-chart-container">
    <h3>{s('roi.chart.h3')}</h3>
    <div class="gi-bar-wrap">
      <div class="gi-bar-label">{s('roi.bar.current')}</div>
      <div class="gi-bar-track"><div class="gi-bar-fill current" id="bar-current"></div></div>
    </div>
    <div class="gi-bar-wrap">
      <div class="gi-bar-label">{s('roi.bar.gravity')}</div>
      <div class="gi-bar-track"><div class="gi-bar-fill gravity" id="bar-gravity"></div></div>
    </div>
  </div>

  <table class="gi-breakdown" role="table">
    <thead role="rowgroup"><tr role="row"><th role="columnheader">{s('roi.th.phase')}</th><th role="columnheader">{s('roi.th.current')}</th><th role="columnheader">{s('roi.th.gravity')}</th><th role="columnheader">{s('roi.th.savings')}</th></tr></thead>
    <tbody id="gi-tbody" role="rowgroup"></tbody>
  </table>

  <div class="gi-cta-box">
    <a class="btn btn--accent btn--lg" href={ctaHref}>{s('roi.cta')}<span class="btn-dot" aria-hidden="true"></span></a>
  </div>
</div>

<script is:inline define:vars={{ GI }}>
(function(){
  var LIC1=2999,LICM=7999,DR=.60,TR=.40,MR=.70,DS=.50,TS=.25,DPS=.10,MS=.15;
  var fmt=function(n){return n.toLocaleString(GI.locale)};
  var sl={p:document.getElementById("s-projects"),d:document.getElementById("s-days"),t:document.getElementById("s-team"),r:document.getElementById("s-rate"),tl:document.getElementById("s-tool")};
  function calc(){
    var P=+sl.p.value,D=+sl.d.value,T=+sl.t.value,R=+sl.r.value,TL=+sl.tl.value;
    document.getElementById("v-projects").textContent=P;
    document.getElementById("v-days").textContent=D;
    document.getElementById("v-team").textContent=T;
    document.getElementById("v-rate").textContent=fmt(R);
    document.getElementById("v-tool").textContent=fmt(TL);
    /* A range input announces its raw `value` — "2999", no grouping, no
       currency. These two are money, so say so; the three counts above are
       already unambiguous from their labels and get no valuetext. */
    sl.r.setAttribute("aria-valuetext",fmt(R)+GI.pln);
    sl.tl.setAttribute("aria-valuetext",fmt(TL)+GI.pln);
    /* fill the track up to the thumb */
    Object.values(sl).forEach(function(r){var p=(r.value-r.min)/(r.max-r.min)*100;r.style.setProperty("--pct",p+"%")});
    var dd=D*DS,td=D*TS,dpd=D*DPS,md=D*MS;
    var cDev=dd*T*R,cTest=td*T*R,cDep=dpd*T*R,cMnt=md*T*R;
    var cTot=(cDev+cTest+cDep+cMnt)*P+TL;
    var gDev=dd*(1-DR)*T*R,gTest=td*(1-TR)*T*R,gDep=dpd*(1-.66)*T*R,gMnt=md*(1-MR)*T*R;
    var gLic=P<=1?LIC1:LICM,setup=(1+3)*T*R;
    var gTot=(gDev+gTest+gDep+gMnt)*P+gLic+setup;
    var sav=cTot-gTot;
    var gDaysP=Math.round(dd*(1-DR)+td*(1-TR)+dpd+md*(1-MR));
    var extra=D>0?Math.floor((D-gDaysP)*P/D):0;
    var roi=gTot>0?((sav/gTot)*100):0;
    document.getElementById("kpi-save").textContent=fmt(Math.round(sav))+" PLN";
    document.getElementById("kpi-extra").textContent="+"+extra;
    document.getElementById("kpi-roi").textContent=Math.round(roi)+"%";
    var mx=Math.max(D,gDaysP,1);
    document.getElementById("bar-current").style.transform="translateX("+(D/mx*100-100)+"%)";
    document.getElementById("bar-current").textContent=D+GI.days;
    document.getElementById("bar-gravity").style.transform="translateX("+(gDaysP/mx*100-100)+"%)";
    document.getElementById("bar-gravity").textContent=gDaysP+GI.days;
    var rows=[[GI.rows[0],cDev*P,gDev*P],[GI.rows[1],cTest*P,gTest*P],[GI.rows[2],cDep*P,gDep*P],[GI.rows[3],cMnt*P,gMnt*P],[GI.rowTools,TL,gLic]];
    // data-label feeds the phone card layout (::before pulls it in); role=cell/row
    // keeps the table readable to AT once the mobile CSS flattens display to block.
    function row(label, cur, grv, extra){
      var s = cur - grv;
      return "<tr role=\"row\"" + (extra || "") + ">"
        + "<td role=\"cell\">" + label + "</td>"
        + "<td role=\"cell\" data-label=\"" + GI.thCurrent + "\">" + fmt(Math.round(cur)) + " PLN</td>"
        + "<td role=\"cell\" data-label=\"" + GI.thGravity + "\">" + fmt(Math.round(grv)) + " PLN</td>"
        + "<td role=\"cell\" class=\"gi-savings\" data-label=\"" + GI.thSavings + "\">" + (s > 0 ? "-" : "") + fmt(Math.round(Math.abs(s))) + " PLN</td>"
        + "</tr>";
    }
    var h="";
    rows.forEach(function(r){h+=row(r[0], r[1], r[2])});
    h+=row(GI.rowTotal, cTot, gTot, " style=\"border-top:2px solid var(--mint-500);font-weight:600\"");
    document.getElementById("gi-tbody").innerHTML=h;
  }
  Object.values(sl).forEach(function(s){s.addEventListener("input",calc)});
  calc();
})();
</script>

  </div>
</section>
