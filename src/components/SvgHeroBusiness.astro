---
import { localeOf, t } from '../i18n/ui';
const s = t(localeOf(Astro.currentLocale));
/* Animated hero SVG — business section (extracted from snippet 30, self-contained). */
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" style="width:100%;height:100%;background:#0a0a12;border-radius:12px;overflow:hidden">
  <defs>
    <radialGradient id="bg2" cx="50%" cy="46%" r="50%">
      <stop offset="0%" stop-color="#27EA93" stop-opacity="0.25"/>
      <stop offset="40%" stop-color="#1a3a5c" stop-opacity="0.08"/>
      <stop offset="100%" stop-color="#0a0a12" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="bs" cx="38%" cy="34%" r="55%">
      <stop offset="0%" stop-color="#5dffc0" stop-opacity="0.9"/>
      <stop offset="30%" stop-color="#27EA93" stop-opacity="0.7"/>
      <stop offset="70%" stop-color="#0d6b47" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#041f15" stop-opacity="0.8"/>
    </radialGradient>
    <radialGradient id="bsp" cx="30%" cy="25%" r="40%">
      <stop offset="0%" stop-color="#fff" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="bn" cx="38%" cy="34%" r="55%">
      <stop offset="0%" stop-color="#fff" stop-opacity="0.95"/>
      <stop offset="30%" stop-color="#aaffdd" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#27EA93" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="bn2" cx="38%" cy="34%" r="55%">
      <stop offset="0%" stop-color="#27EA93" stop-opacity="1"/>
      <stop offset="40%" stop-color="#27EA93" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#27EA93" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="bvg" cx="50%" cy="0%" r="100%">
      <stop offset="0%" stop-color="#0a0a12" stop-opacity="0"/>
      <stop offset="60%" stop-color="#0a0a12" stop-opacity="0"/>
      <stop offset="100%" stop-color="#0a0a12" stop-opacity="0.8"/>
    </radialGradient>
    <filter id="bb" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.5"/></filter>
    <filter id="bgw" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="bts" x="-10%" y="-10%" width="120%" height="120%"><feDropShadow dx="0" dy="2" stdDeviation="8" flood-color="#000" flood-opacity="0.7"/></filter>
    <linearGradient id="bgp" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#111119" stop-opacity="0.85"/>
      <stop offset="100%" stop-color="#0a0a12" stop-opacity="0.65"/>
    </linearGradient>
  </defs>
  <style>
    @keyframes bf1{0%,100%{opacity:.3;transform:scale(.9)}50%{opacity:1;transform:scale(1.15)}}
    @keyframes bf2{0%{stroke-dashoffset:40}100%{stroke-dashoffset:0}}
    @keyframes bg1{0%,100%{opacity:.15;transform:scale(1)}50%{opacity:.28;transform:scale(1.08)}}
    @keyframes bfl{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
    @keyframes btw{0%,100%{opacity:.15}50%{opacity:.65}}
    @keyframes bsp1{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
    @keyframes bsp2{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
    .bc{stroke:#27EA93;fill:none;stroke-dasharray:5 5;animation:bf2 3s linear infinite}
    .bc2{stroke:#27EA93;fill:none;stroke-dasharray:3 7;animation:bf2 4.5s linear infinite reverse}
    .bg1{animation:bg1 5s ease-in-out infinite;transform-origin:400px 260px}
    .btf{animation:bfl 7s ease-in-out infinite}
    .bst{animation:btw 3s ease-in-out infinite}
    .bnd{animation:bf1 3s ease-in-out infinite}
    .bhx{animation:bsp1 70s linear infinite;transform-origin:400px 260px}
    .bsph{animation:bsp2 6s ease-in-out infinite;transform-origin:400px 260px}
  </style>
  <rect width="800" height="520" fill="#0a0a12"/>
  <rect width="800" height="520" fill="url(#bvg)" opacity=".5"/>
  <!-- stars -->
  <circle cx="95" cy="60" r="1.3" fill="#fff" class="bst" opacity=".45" style="animation-delay:0s"/>
  <circle cx="710" cy="45" r=".6" fill="#bbb" class="bst" style="animation-delay:1.4s"/>
  <circle cx="55" cy="430" r="1" fill="#ddd" class="bst" style="animation-delay:.7s"/>
  <circle cx="745" cy="455" r=".5" fill="#999" class="bst" style="animation-delay:2.1s"/>
  <circle cx="370" cy="22" r="1.1" fill="#fff" class="bst" opacity=".5" style="animation-delay:.3s"/>
  <circle cx="615" cy="490" r=".7" fill="#bbb" class="bst" style="animation-delay:1.6s"/>
  <circle cx="165" cy="485" r=".9" fill="#ddd" class="bst" style="animation-delay:1s"/>
  <circle cx="750" cy="175" r="1.2" fill="#fff" class="bst" opacity=".35" style="animation-delay:1.9s"/>
  <circle cx="290" cy="470" r=".5" fill="#aaa" class="bst" style="animation-delay:2.3s"/>
  <!-- ambient glow -->
  <circle cx="400" cy="260" r="200" fill="url(#bg2)" class="bg1"/>
  <circle cx="400" cy="260" r="120" fill="url(#bg2)" opacity=".35" class="bg1" style="animation-delay:1.5s"/>
  <!-- 3D tilted hexagonal wireframe -->
  <g class="bhx" opacity=".05">
    <polygon points="400,160 469,200 469,280 400,320 331,280 331,200" fill="none" stroke="#27EA93" stroke-width="1.2" transform="rotate(0,400,260)"/>
    <polygon points="400,110 520,175 520,345 400,410 280,345 280,175" fill="none" stroke="#27EA93" stroke-width=".7"/>
  </g>
  <!-- 3D perspective connection lines (thicker near center, thinner at edges) -->
  <path d="M400,260 Q300,200 165,125" class="bc" stroke-width="1.2" opacity=".2"/>
  <path d="M400,260 Q500,200 635,125" class="bc" stroke-width="1.2" opacity=".2" style="animation-delay:.5s"/>
  <path d="M400,260 Q300,320 165,405" class="bc" stroke-width="1" opacity=".15" style="animation-delay:1s"/>
  <path d="M400,260 Q500,320 635,405" class="bc" stroke-width="1" opacity=".15" style="animation-delay:1.5s"/>
  <path d="M400,260 Q350,260 110,260" class="bc2" stroke-width=".8" opacity=".12"/>
  <path d="M400,260 Q450,260 690,260" class="bc2" stroke-width=".8" opacity=".12" style="animation-delay:.8s"/>
  <path d="M400,260 Q400,200 400,70" class="bc2" stroke-width=".7" opacity=".1"/>
  <path d="M400,260 Q400,320 400,450" class="bc2" stroke-width=".7" opacity=".1" style="animation-delay:1.2s"/>
  <!-- 3D sphere nodes with specular highlights -->
  <circle cx="165" cy="125" r="10" fill="url(#bn)" class="bnd" filter="url(#bb)"/><circle cx="161" cy="121" r="2.5" fill="#fff" opacity=".3"/>
  <circle cx="635" cy="125" r="10" fill="url(#bn2)" class="bnd" filter="url(#bb)" style="animation-delay:.4s"/><circle cx="631" cy="121" r="2.5" fill="#fff" opacity=".2"/>
  <circle cx="165" cy="405" r="8" fill="url(#bn2)" class="bnd" filter="url(#bb)" style="animation-delay:.8s"/><circle cx="162" cy="401" r="2" fill="#fff" opacity=".2"/>
  <circle cx="635" cy="405" r="8" fill="url(#bn)" class="bnd" filter="url(#bb)" style="animation-delay:1.2s"/><circle cx="632" cy="401" r="2" fill="#fff" opacity=".25"/>
  <circle cx="110" cy="260" r="7" fill="url(#bn2)" class="bnd" filter="url(#bb)" style="animation-delay:.6s"/><circle cx="107" cy="257" r="1.8" fill="#fff" opacity=".2"/>
  <circle cx="690" cy="260" r="7" fill="url(#bn)" class="bnd" filter="url(#bb)" style="animation-delay:1s"/><circle cx="687" cy="257" r="1.8" fill="#fff" opacity=".25"/>
  <circle cx="400" cy="70" r="6" fill="url(#bn2)" class="bnd" filter="url(#bb)" style="animation-delay:1.4s"/><circle cx="397" cy="67" r="1.5" fill="#fff" opacity=".2"/>
  <circle cx="400" cy="450" r="6" fill="url(#bn)" class="bnd" filter="url(#bb)" style="animation-delay:1.8s"/><circle cx="397" cy="447" r="1.5" fill="#fff" opacity=".25"/>
  <!-- central 3D sphere -->
  <g class="bsph">
    <circle cx="400" cy="260" r="30" fill="url(#bs)"/>
    <circle cx="400" cy="260" r="30" fill="url(#bsp)"/>
    <circle cx="400" cy="260" r="30" fill="none" stroke="#27EA93" stroke-width=".8" opacity=".3"/>
    <circle cx="391" cy="248" r="7" fill="#fff" opacity=".2"/>
  </g>
  <!-- frosted glass text panel -->
  <rect x="130" y="155" width="540" height="245" rx="16" fill="url(#bgp)" opacity=".78"/>
  <rect x="130" y="155" width="540" height="245" rx="16" fill="none" stroke="#27EA93" stroke-width=".4" opacity=".12"/>
  <!-- text with drop shadow -->
  <g class="btf" filter="url(#bts)">
    <text x="400" y="215" text-anchor="middle" fill="#fff" font-family="Inter,Segoe UI,system-ui,-apple-system,sans-serif" font-size="48" font-weight="600" letter-spacing="1">{s('svg.biz.l1')}</text>
    <text x="400" y="270" text-anchor="middle" fill="#fff" font-family="Inter,Segoe UI,system-ui,-apple-system,sans-serif" font-size="44" font-weight="600" letter-spacing="1">{s('svg.biz.l2')}</text>
    <text x="400" y="325" text-anchor="middle" fill="#27EA93" font-family="Inter,Segoe UI,system-ui,-apple-system,sans-serif" font-size="44" font-weight="700" letter-spacing="1" filter="url(#bgw)">{s('svg.biz.l3')}</text>
    <text x="400" y="375" text-anchor="middle" fill="#fff" font-family="Inter,Segoe UI,system-ui,-apple-system,sans-serif" font-size="40" font-weight="400" letter-spacing=".5" opacity=".85">{s('svg.biz.l4')}</text>
  </g>
</svg>
