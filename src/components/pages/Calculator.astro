---
/* The body of /kalkulator/.
 *
 * It rendered /en/roi-calculator/ too until that page was removed: the
 * calculator quotes PLN and its sliders are scaled to Polish contractor day
 * rates, so it answered an English visitor's question in the wrong currency at
 * the wrong scale. The reasoning is written out at NOT_OFFERED in routes.ts.
 *
 * What stayed is the locale-awareness below — the English FAQ rich result, the
 * English hero alt text, `getPage` keyed on `lang`. None of it runs today,
 * because the only route pointing here is Polish. It is left wired because
 * bringing the page back is a content decision (euro defaults and ranges for
 * the two sliders, plus a euro pass over the runtime JS in RoiCalculator.astro,
 * which hard-codes " PLN"), and there is no reason to make that decision also
 * be a rewrite of this file. Adding src/content/pages/en/roi-calculator.json
 * and a two-line route under src/pages/en/, then dropping 'kalkulator' from
 * NOT_OFFERED, is the whole of the way back. */
import { getPage } from '../../i18n/routes';
import { localeOf } from '../../i18n/ui';
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import SectionRenderer from '../../components/SectionRenderer.astro';
import RoiCalculator from '../../components/RoiCalculator.astro';
import Newsletter from '../../components/Newsletter.astro';
/* One FAQ rich result per language — a page must only claim answers it
   actually shows, so each locale carries its own condensed Q&A. */
import faqJsonLdPl from '../../data/kalkulator-faq-jsonld.json?raw';
import faqJsonLdEn from '../../data/kalkulator-faq-jsonld.en.json?raw';

const lang = localeOf(Astro.currentLocale);
const entry = await getPage('kalkulator', lang);
const page = entry.data;
const faqJsonLd = lang === 'en' ? faqJsonLdEn : faqJsonLdPl;
/* calculator sits between text_columns (section0) and faq (section1) — snippet 19's insertion point */
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass={`page page-${page.slug}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqJsonLd} />
  </Fragment>
  <PageHero h1={page.h1} />
  <SectionRenderer sections={page.sections.slice(0, 1)} />
  <RoiCalculator />
  <SectionRenderer sections={page.sections.slice(1)} startIndex={1} />
  <Newsletter />
</Site>
