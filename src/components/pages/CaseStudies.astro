---
/* Shared body for /case-studies/ and /en/case-studies/.
   The generic [...slug] route renders this page's ACF payload through
   TextImgLink, which was the WordPress theme's only option: a 33%-wide text
   column zigzagging left/right beside a half-empty image column. The copy is
   unchanged — it is parsed out of the same JSON and laid out properly. */
import { getPage } from '../../i18n/routes';
import { localeOf } from '../../i18n/ui';
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import CaseStudyList from '../../components/CaseStudies.astro';
import Newsletter from '../../components/Newsletter.astro';
import DemoSection from '../../components/DemoSection.astro';
import { parseCaseStudies } from '../../lib/case-studies';

const lang = localeOf(Astro.currentLocale);
const entry = await getPage('case-studies', lang);
const page = entry.data;
const studies = parseCaseStudies(page.sections as any[]);
const crumbs = studies
  .map((s) => ({ label: s.nav, anchor: s.anchor }))
  .filter((c) => c.label);
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass={`page page-${page.slug}`}
>
  <PageHero h1={page.h1} crumbs={crumbs} />
  <CaseStudyList studies={studies} />
  {page.newsletter && <Newsletter />}
  <DemoSection />
</Site>
