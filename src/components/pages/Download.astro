---
/* Shared body for /pobieranie/ and /en/download/.
 *
 * Rebuilt as a conversion page (see DownloadPage.astro for the funnel mechanics
 * and where every claim in the copy comes from).
 *
 * Gone from the old version: the MailerLite universal.js embed and its loader
 * (the form now posts to the same endpoint through the site's own runtime, so
 * no third-party script sits on the critical path), the two decorative
 * "downloads" rows whose buttons only anchor-jumped to the form, and the
 * generic PageHero — the hero IS the form now. */
import { getPage } from '../../i18n/routes';
import { localeOf, t } from '../../i18n/ui';
import Site from '../../layouts/Site.astro';
import DownloadPage from '../../components/DownloadPage.astro';
import { softwareApplication } from '../../lib/structured-data';

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const entry = await getPage('pobieranie', lang);
const page = entry.data;

const crumbs = [
  { label: s('nav.download'), anchor: 'section0' },
  { label: s('dl.crumb.how'), anchor: 'section1' },
  { label: s('dl.crumb.what'), anchor: 'section2' },
  { label: s('nav.docs'), anchor: 'section3' },
];

/* JSON-LD: the thing on this page is downloadable software — Windows,
   version 4, free for testing — with its paid plans. One description of the
   product for every page that carries it (src/lib/structured-data.ts): the
   offers come from this locale's pricing page, so the English page quotes EUR
   and the Polish one PLN, as their pricing pages do. */
const schema = [await softwareApplication(lang)];
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass={`page page-${page.slug}`}
  schema={schema}
>
  <DownloadPage crumbs={crumbs} />
</Site>
