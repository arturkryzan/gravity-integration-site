---
/* Shared body for every page that has no route of its own: technologia, cennik,
   kontakt, polityka-prywatnosci — and their English twins.
 *
 * Unlike the other files here it takes its entry as a prop rather than fetching
 * it, because the catch-all route already resolved which page this URL is when
 * it built `getStaticPaths`. */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionRenderer from '../../components/SectionRenderer.astro';
import Newsletter from '../../components/Newsletter.astro';
import DemoSection from '../../components/DemoSection.astro';
import heroes from '../../data/page_heroes.json';

interface Props {
  page: any;
}
const { page } = Astro.props;

/* pages where snippet 13 injected the demo section on the live site.
   Keyed by slug, so it holds for both locales without a translated copy. */
const DEMO_PAGES = ['technologia', 'cennik', 'case-studies', 'czym-jest-esb'];

const hero = (heroes as Record<string, any>)[page.slug] ?? {};
const crumbs = page.sections
  .map((s: any, i: number) => ({ label: s.nav_li, anchor: `section${i}` }))
  .filter((c: any) => c.label);
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass={`page page-id-${page.wpId}`}
>
  <PageHero h1={page.h1} img={hero.local} alt={hero.alt} circle={hero.circle} />
  <Breadcrumbs items={crumbs} />
  <SectionRenderer sections={page.sections} />
  {page.newsletter && <Newsletter />}
  {DEMO_PAGES.includes(page.slug) && <DemoSection />}
</Site>
