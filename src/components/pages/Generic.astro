---
/* Shared body for every page that has no route of its own: technologia,
   cennik, kontakt, polityka-prywatnosci — and their English twins.
 *
 * Unlike the other files here it takes its entry as a prop rather than fetching
 * it, because the catch-all route already resolved which page this URL is when
 * it built `getStaticPaths`. */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import SectionRenderer from '../../components/SectionRenderer.astro';
import Newsletter from '../../components/Newsletter.astro';
import DemoSection from '../../components/DemoSection.astro';
import { localeOf } from '../../i18n/ui';
import { faqPage, softwareApplication } from '../../lib/structured-data';

interface Props {
  page: any;
}
const { page } = Astro.props;

/* pages where snippet 13 injected the demo section on the live site.
   Keyed by slug, so it holds for both locales without a translated copy. */
const DEMO_PAGES = ['technologia', 'cennik', 'case-studies', 'czym-jest-esb'];

/* Documents get the quiet hero; everything else is a brand moment. */
const QUIET = ['polityka-prywatnosci'];
const quiet = QUIET.includes(page.slug);

/* JSON-LD: the pages about the product carry it (with its offers), the
   contact page says it is one, and a page with an FAQ section states its
   questions and answers — the ones it shows, word for word. */
const PRODUCT_PAGES = ['technologia', 'cennik'];
const lang = localeOf(Astro.currentLocale);
const schema = PRODUCT_PAGES.includes(page.slug) ? [await softwareApplication(lang)] : [];
const faq = faqPage(page.sections);
const faqJsonLd = faq && JSON.stringify(faq).replace(/</g, '\\u003c');

const crumbs = page.sections
  .map((s: any, i: number) => ({ label: s.nav_li, anchor: `section${i}` }))
  .filter((c: any) => c.label);
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass={`page page-${page.slug}`}
  heroTone={quiet ? 'mist' : 'mint'}
  schema={schema}
  pageType={page.slug === 'kontakt' ? 'ContactPage' : 'WebPage'}
>
  <Fragment slot="head">
    {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
  </Fragment>
  <PageHero h1={page.h1} crumbs={crumbs} variant={quiet ? 'quiet' : 'mass'} />
  <SectionRenderer sections={page.sections} options={quiet ? { 0: { document: true } } : {}} />
  {page.newsletter && <Newsletter />}
  {DEMO_PAGES.includes(page.slug) && <DemoSection />}
</Site>
