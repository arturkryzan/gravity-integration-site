---
/* The home page body, shared by / and /en/.
 *
 * Route files under src/pages/ are now two lines each: a URL is a location, not
 * a page. Everything a page actually IS lives here, and both locales render the
 * same structure over their own content — `getPage('home', lang)` picks the
 * language off the URL, so there is nothing to keep in sync by hand. */
import { getPage, isOffered, linkUrl } from '../../i18n/routes';
import { localeOf, t } from '../../i18n/ui';
import Site from '../../layouts/Site.astro';
import HomeHero from '../../components/HomeHero.astro';
import SectionRenderer from '../../components/SectionRenderer.astro';
import DemoSection from '../../components/DemoSection.astro';
import { softwareApplication } from '../../lib/structured-data';

const lang = localeOf(Astro.currentLocale);
const s = t(lang);
const entry = await getPage('home', lang);
const page = entry.data;
/* the product, with its offers, in this page's JSON-LD graph */
const schema = [await softwareApplication(lang)];

/* The business row's second CTA points at the ROI calculator, which English
   doesn't have (NOT_OFFERED in routes.ts). Spreading an object rather than
   passing an empty `extraLinks` array: the row already renders correctly with
   no second link, and "the key isn't there" is a state SectionRenderer has
   always handled, where "the key is there and empty" is one it would have to
   learn. */
const roiCta = isOffered('kalkulator', lang)
  ? { extraLinks: [{ title: s('home.roiCta'), url: await linkUrl('kalkulator', lang) }] }
  : {};

/* live-site row overrides (was snippets 30 + 12):
   section0 row0 → developers panel, row1 → business panel + extra CTA
   section2 rows → the four animated use-case panels (UseCaseAnim.astro),
   which replaced v1's rendered films use_01, connect-systems, use_03 and
   use_04, in that order. */
const overrides = {
  0: {
    0: { media: 'svg-dev' as const },
    1: { media: 'svg-biz' as const, ...roiCta },
  },
  2: {
    0: { media: { scene: 'consolidate' as const } },
    1: { media: { scene: 'connect' as const } },
    2: { media: { scene: 'partners' as const } },
    3: { media: { scene: 'control' as const } },
  },
};
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass="home"
  heroTone="mint"
  schema={schema}
>
  <HomeHero h1={page.h1} />
  <SectionRenderer
    sections={page.sections.slice(0, 3)}
    overrides={overrides}
    options={{ 2: { numbered: true } }}
  />
  <DemoSection />
  <SectionRenderer sections={page.sections.slice(3)} startIndex={3} logoSections={[3]} />
</Site>
