---
/* Shared body for /czym-jest-esb/ and /en/what-is-esb/. */
import { getPage } from '../../i18n/routes';
import { localeOf } from '../../i18n/ui';
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import EsbArticle from '../../components/EsbArticle.astro';
import DemoSection from '../../components/DemoSection.astro';
/* The article's copy lives beside the layout, one file per language — the
   Polish page JSON still carries its legacy `sections` mirror of this text,
   but the English one doesn't: EsbArticle is the single renderer here, so a
   second translated copy in dead fields would only drift. */
import esbPl from '../../data/esb-content.json';
import esbEn from '../../data/esb-content.en.json';

const lang = localeOf(Astro.currentLocale);
const entry = await getPage('czym-jest-esb', lang);
const page = entry.data;
const esb = lang === 'en' ? esbEn : esbPl;
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass={`page page-${page.slug}`}
>
  <PageHero h1={page.h1} crumbs={esb.nav} />
  <EsbArticle />
  <DemoSection />
</Site>
