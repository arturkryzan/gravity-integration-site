---
/* Shared body for /czym-jest-esb/ and /en/what-is-esb/. */
import { getPage } from '../../i18n/routes';
import { localeOf } from '../../i18n/ui';
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EsbArticle from '../../components/EsbArticle.astro';
import DemoSection from '../../components/DemoSection.astro';
import heroes from '../../data/page_heroes.json';
import esb from '../../data/esb-content.json';

const lang = localeOf(Astro.currentLocale);
const entry = await getPage('czym-jest-esb', lang);
const page = entry.data;
/* Keyed by slug, which is language-neutral — the hero image is the same
   picture in both languages, only its alt text needs translating (Phase 4). */
const hero = (heroes as Record<string, any>)['czym-jest-esb'];
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  slug={page.slug}
  draft={page.draft}
  bodyClass={`page page-id-${page.wpId}`}
>
  <PageHero h1={page.h1} img={hero.local} alt={hero.alt} circle={hero.circle} />
  <Breadcrumbs items={esb.nav} />
  <EsbArticle />
  <DemoSection />
</Site>
