---
/* Contact form section (was CF7 form 91 on /kontakt/).
   Now posts straight to MailerLite — form "gravity.integration — Kontakt (www)",
   which feeds the GRAVITY group. There is no server in this build, so the
   `action` is the MailerLite endpoint itself and the inputs are named
   `fields[…]`: with JS off the browser posts natively and the subscription
   still lands. src/scripts/ml-forms.ts upgrades that to an in-page result.

   The radio ("Użytek komercyjny" / "Darmowa konsultacja") rides along as the
   `typ_zapytania` custom field, so the two intents stay distinguishable in
   MailerLite without splitting the group. */
import { mlAction } from '../../lib/mailerlite';
import { LOCALE_TAG, localeOf, t } from '../../i18n/ui';
const action = mlAction('contact');
const lang = localeOf(Astro.currentLocale);
const s = t(lang);
---
<section class="contact bg-green" id="section1" data-scroll data-scroll-repeat data-scroll-call="spy1">
	<div class="container-fluid pt-10 pb-10 pt-lg-100 pb-lg-100">
		<div class="row py-10 py-lg-5">
			<div class="col-lg-8 offset-lg-1 paragraph hover-underline" data-scroll data-scroll-opacity>
				<h2 class="pb-4">{s('cf.h2')}</h2>
			</div>
			<div class="col-lg-8 offset-lg-1" data-scroll data-scroll-opacity>
<div class="wpcf7" lang={LOCALE_TAG[lang]} dir="ltr" data-wpcf7-id="91">
<div class="screen-reader-response"><p role="status" aria-live="polite" aria-atomic="true"></p> <ul></ul></div>
<form action={action} data-form="contact" method="post" target="_blank" class="wpcf7-form init" aria-label={s('cf.form.aria')} data-status="init">

<div class="form-row form-row-radio form-row-checkbox mb-10"><span class="wpcf7-form-control-wrap" data-name="typ_zapytania"><span class="wpcf7-form-control wpcf7-radio"><span class="wpcf7-list-item first"><label><input type="radio" name="fields[typ_zapytania]" value="Użytek komercyjny" checked="checked" /><span class="wpcf7-list-item-label">{s('cf.radio.commercial')}</span></label></span><span class="wpcf7-list-item last"><label><input type="radio" name="fields[typ_zapytania]" value="Darmowa konsultacja" /><span class="wpcf7-list-item-label">{s('cf.radio.consult')}</span></label></span></span></span></div>
<div class="form-row mb-5"><label for="nemaiil">{s('form.emailLabel')}</label><span class="wpcf7-form-control-wrap" data-name="email"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email" id="nemaiil" required aria-required="true" aria-invalid="false" value="" type="email" autocomplete="email" inputmode="email" name="fields[email]" /></span></div>
<div class="form-row mb-5 form-row-checkbox"><span class="wpcf7-form-control-wrap" data-name="acceptance-500"><span class="wpcf7-form-control wpcf7-acceptance"><span class="wpcf7-list-item"><label><input type="checkbox" name="acceptance-500" value="1" required data-ml-consent aria-invalid="false" /><span class="wpcf7-list-item-label">{s('cf.consent')}</span></label></span></span></span></div>
<input type="hidden" name="ml-submit" value="1" />
<input type="hidden" name="anticsrf" value="true" />
<div class="form-row btn-arrow btn-arrow-submit"><input class="wpcf7-form-control wpcf7-submit has-spinner" type="submit" value={s('cf.submit')} /></div><div class="wpcf7-response-output" role="status" aria-live="polite" hidden></div>
</form>
</div>
</div>
		</div>
	</div>
</section>

<script>
  import { mlAction } from '../../lib/mailerlite';
  import { initMlSimpleForm } from '../../scripts/ml-forms';
  import { pick } from '../../i18n/client';

  document.querySelectorAll<HTMLFormElement>('form[data-form="contact"]').forEach((form) =>
    initMlSimpleForm(form, {
      action: mlAction('contact'),
      success: pick({
        pl: 'Dziękujemy — zapytanie do nas dotarło. Odezwiemy się w ciągu jednego dnia roboczego.',
        en: "Thank you — your enquiry has reached us. We'll get back to you within one business day.",
      }),
      event: 'contact_request_submitted',
    }),
  );
</script>
