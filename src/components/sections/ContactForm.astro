---
/* Contact form section (was CF7 form 91 on /kontakt/). POST endpoint lands in Phase 3. */
---
<section class="contact bg-green" id="section1" data-scroll data-scroll-repeat data-scroll-call="spy1"> 
	<div class="container-fluid pt-10 pb-10 pt-lg-100 pb-lg-100">
		<div class="row py-10 py-lg-5">
			<div class="col-lg-8 offset-lg-1 paragraph hover-underline" data-scroll data-scroll-opacity>
				<h2 class="pb-4">Wyślij zapytanie</h2>
			</div>
			<div class="col-lg-8 offset-lg-1" data-scroll data-scroll-opacity>
<div class="wpcf7" lang="pl-PL" dir="ltr" data-wpcf7-id="91">
<div class="screen-reader-response"><p role="status" aria-live="polite" aria-atomic="true"></p> <ul></ul></div>
<form action="/api/contact" data-form="contact" method="post" class="wpcf7-form init" aria-label="Formularz kontaktowy" novalidate="novalidate" data-status="init">

<div class="form-row form-row-radio form-row-checkbox mb-10"><span class="wpcf7-form-control-wrap" data-name="radio-170"><span class="wpcf7-form-control wpcf7-radio"><span class="wpcf7-list-item first"><label><input type="radio" name="radio-170" value="Użytek komercyjny" checked="checked" /><span class="wpcf7-list-item-label">Użytek komercyjny</span></label></span><span class="wpcf7-list-item last"><label><input type="radio" name="radio-170" value="Darmowa konsultacja" /><span class="wpcf7-list-item-label">Darmowa konsultacja</span></label></span></span></span></div>
<div class="form-row mb-5"><label for="nemaiil">Podaj swój adres e-mail</label><span class="wpcf7-form-control-wrap" data-name="email-300"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email" id="nemaiil" aria-required="true" aria-invalid="false" value="" type="email" name="email-300" /></span></div>
<div class="form-row mb-5 form-row-checkbox"><span class="wpcf7-form-control-wrap" data-name="acceptance-500"><span class="wpcf7-form-control wpcf7-acceptance"><span class="wpcf7-list-item"><label><input type="checkbox" name="acceptance-500" value="1" aria-invalid="false" /><span class="wpcf7-list-item-label">Zgadzam się na przekazanie adresu e-mail spółce Caffeine Minds sp. z o.o. celem kontaktu i przedstawienia indywidualnej wyceny handlowej lub umówienia konsultacji z ekspertem.</span></label></span></span></span></div>
<div class="form-row btn-arrow btn-arrow-submit"><input class="wpcf7-form-control wpcf7-submit has-spinner" type="submit" value="Zapytaj" /></div><div class="wpcf7-response-output" aria-hidden="true"></div>
</form>
</div>
</div>
		</div>
	</div>
</section>
