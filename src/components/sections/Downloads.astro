---
/* ACF layout: downloads. No page renders it any more — /pobieranie/ is built
   by DownloadPage.astro — but the layout stays mapped in SectionRenderer, so
   it keeps a v2 rendering: rows of copy with a download button beside an
   image. */
import { mediaSrc, mediaAlt, mediaDims } from '../../lib/media';
import { linkTarget, linkRel, opensNewTab } from '../../lib/links';
import { clean } from '../../lib/html';
import Icon from '../ui/Icon.astro';
import { localeOf, t } from '../../i18n/ui';
const s = t(localeOf(Astro.currentLocale));

interface Props {
  index: number;
  downloads: Array<Record<string, any>>;
}
const { index, downloads } = Astro.props;
---

<section id={`section${index}`} class="dl-rows section surface-white">
  <div class="container dl-rows-in">
    {
      downloads.map((row, i) => {
        const file = row.file && typeof row.file === 'object' ? row.file : null;
        const contact = row.contact && typeof row.contact === 'object' ? row.contact : null;
        const img = row.img && typeof row.img === 'object' ? row.img : null;
        return (
          <div class="dl-row" id={`download${i}`}>
            <div class="dl-row-copy">
              {row.cat && <span class="label">{row.cat}</span>}
              <div class="prose" set:html={clean(row.text)} />
              <div class="dl-row-actions">
                {file && (
                  <a class="btn btn--primary" href={file.url} target={file.url?.startsWith('#') ? undefined : '_blank'} rel={file.url?.startsWith('#') ? undefined : 'noopener'}>
                    {s('common.download')}
                    <Icon name="download" size={16} />
                    {!file.url?.startsWith('#') && <span class="visually-hidden">{s('a11y.newTab')}</span>}
                  </a>
                )}
                {contact && (
                  <a
                    class="btn btn--link"
                    href={contact.url}
                    target={linkTarget(contact.url, contact.target)}
                    rel={linkRel(linkTarget(contact.url, contact.target))}
                  >
                    {contact.title}
                    {opensNewTab(contact.url, contact.target) && <span class="visually-hidden">{s('a11y.newTab')}</span>}
                  </a>
                )}
              </div>
            </div>
            {img && mediaSrc(img) && (
              <figure class="dl-row-img">
                <img src={mediaSrc(img)} alt={mediaAlt(img)} loading="lazy" decoding="async" {...(mediaDims(img) ?? {})} />
              </figure>
            )}
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .dl-rows-in {
    display: grid;
    gap: 96px;
  }
  .dl-row {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .dl-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .dl-row-copy {
    display: grid;
    gap: 16px;
  }
  .dl-row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .dl-row-img {
    overflow: hidden;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-xl);
  }
</style>
