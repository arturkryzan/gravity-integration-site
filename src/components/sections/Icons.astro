---
/* ACF layout: icons.
   variant="default" → the technology band: ink (anything heavy is ink), the
                       four technologies as ink-700 cards, Lucide icons.
   variant="logos"   → the client wall: white, the house bordered-cell grid,
                       logos in grey until pointed at, case-study links.

   v1's band was green with hand-drawn blob outlines morphing behind each
   icon; the system allows no patterns or illustrations and makes mint a field
   rather than a tint, so the band turns to ink and the mass carries the
   brand. The `bg` field in the content is the old theme's colour and is
   ignored. */
import { mediaSrc, mediaAlt, mediaDims } from '../../lib/media';
import { clean } from '../../lib/html';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  index: number;
  bg?: string;
  text?: string;
  icons: Array<Record<string, any>>;
  link?: Record<string, any> | '' | null;
  variant?: 'default' | 'logos';
}
const { index, text = '', icons, variant = 'default' } = Astro.props;

/* The four technologies, each to the Lucide glyph that says what it does. */
const iconFor = (title: string): IconName => {
  const t = title.toLowerCase();
  if (t.includes('always')) return 'infinity';
  if (t.includes('signal')) return 'bell-ring';
  if (t.includes('chain')) return 'workflow';
  return 'brain-circuit';
};

/* an embedded case-study <a> inside a logo tile's text field */
const linkOf = (html: string | undefined) => {
  if (!html) return null;
  const m = html.match(/<a[^>]*href="([^"]*)"[^>]*>(.*?)<\/a>/s);
  return m ? { url: m[1], label: m[2].replace(/<[^>]+>/g, '').trim() } : null;
};
const stripTags = (s: string) => (s || '').replace(/<[^>]+>/g, '').trim();
---

{
  variant === 'logos' ? (
    <section class="logos section surface-white" id={`section${index}`}>
      <div class="container">
        <div class="logos-head prose" data-reveal set:html={clean(text)} />
        <div class="logos-wall" data-reveal>
          {icons.map((tile) => {
            const img = tile.icon && typeof tile.icon === 'object' ? tile.icon : null;
            const cs = linkOf(tile.text);
            return (
              <div class:list={['logos-cell', { 'logos-cell--case': cs }]}>
                {img && mediaSrc(img) && (
                  <img
                    class="logos-img"
                    src={mediaSrc(img)}
                    alt={mediaAlt(img) || stripTags(tile.title)}
                    title={stripTags(tile.title)}
                    loading="lazy"
                    decoding="async"
                    {...(mediaDims(img) ?? {})}
                  />
                )}
                {cs && (
                  <a class="logos-link" href={cs.url}>
                    {cs.label}
                  </a>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ) : (
    <section class="tech section surface-ink" id={`section${index}`}>
      <span class="mass tech-mass" style="--mass-color: var(--mint-500)" aria-hidden="true" />
      <div class="container tech-in">
        <div class="tech-head prose" data-reveal set:html={clean(text)} />
        <ul class="tech-grid">
          {icons.map((tile, i) => (
            <li class="tech-card" data-reveal style={`transition-delay:${i * 60}ms`}>
              <div class="tech-top">
                <span class="tech-icon">
                  <Icon name={iconFor(tile.title)} size={24} />
                </span>
                <span class="label-num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="tech-title">{tile.title}</h3>
              <div class="tech-text" set:html={clean(tile.text)} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* ---- technology band ---- */
  .tech {
    overflow: hidden;
  }
  .tech-mass {
    width: clamp(320px, 38vw, 560px);
    right: clamp(-220px, -12vw, -120px);
    top: clamp(-360px, -22vw, -180px);
  }
  /* The headline is mint; it must never cross the mint mass. On narrow
     screens the arc gets its own room above the heading. */
  @media (max-width: 899.98px) {
    .tech {
      padding-top: 150px;
    }
    .tech-mass {
      width: 300px;
      right: -110px;
      top: -180px;
    }
  }
  .tech-in {
    position: relative;
    z-index: var(--z-raised);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 6vw, 64px);
  }
  /* wide enough for "Technologie, których nie znajdziesz" (bound with
     no-break spaces in the copy) to hold one line at 56px */
  .tech-head {
    max-width: 920px;
  }
  /* Headlines on the mass are mint. */
  .tech-head :global(h2) {
    color: var(--mint-500);
    font-size: var(--fs-h1);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  /* The copy binds "których nie znajdziesz" with no-break spaces: 347px at
     34px, wider than a 320px phone's column. Below 600px the size follows
     the viewport so the bound phrase always fits on one line. */
  @media (max-width: 599.98px) {
    .tech-head :global(h2) {
      font-size: clamp(26px, 8.2vw, 34px);
    }
  }
  .tech-head :global(p) {
    font-size: 18px;
    color: var(--on-ink-soft);
  }
  /* Four technologies: one row of four, two of two, or a column — never a
     row of three with one left over. */
  .tech-grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @media (min-width: 600px) {
    .tech-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .tech-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tech-card {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--ink-700);
  }
  .tech-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .tech-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ink-900);
    color: var(--on-ink);
  }
  /* slate-400 is 3.95:1 on ink-700 — under AA for 12px — so the count
     steps up to on-ink-soft here (it keeps slate-400 on ink-900). */
  .tech-card .label-num {
    color: var(--on-ink-soft);
  }
  .tech-title {
    font: 600 20px / 1.2 var(--font-sans);
    letter-spacing: -0.025em;
    color: var(--on-ink);
  }
  .tech-text {
    font: 400 var(--fs-body) / 1.55 var(--font-sans);
    color: var(--on-ink-soft);
  }

  /* ---- client wall ---- */
  .logos-head {
    max-width: 720px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .logos-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(50%, 176px), 1fr));
    border-top: 1px solid var(--mist-200);
    border-left: 1px solid var(--mist-200);
  }
  .logos-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 136px;
    padding: 24px 16px;
    border-right: 1px solid var(--mist-200);
    border-bottom: 1px solid var(--mist-200);
  }
  @media (max-width: 599.98px) {
    .logos-cell {
      min-height: 104px;
      padding: 18px 10px;
    }
  }
  .logos-img {
    width: auto;
    max-width: 128px;
    max-height: 56px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter var(--dur-base) ease,
      opacity var(--dur-base) ease;
  }
  .logos-cell:hover .logos-img {
    filter: none;
    opacity: 1;
  }
  .logos-link {
    font: 600 13px / 1.2 var(--font-sans);
    color: var(--ink-900);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .logos-link:hover {
    color: var(--mint-800);
  }

  @media (prefers-reduced-motion: reduce) {
    .logos-img {
      transition: none;
    }
  }
</style>
