---
/* ACF layout: links — the useful-links grid on /kontakt/. Each link is one of
   the system's default cards: title, the address in mono, and the arrow; it
   lifts 3px under the pointer. */
import { linkTarget, linkRel, opensNewTab } from '../../lib/links';
import { clean } from '../../lib/html';
import Icon from '../ui/Icon.astro';
import { localeOf, t } from '../../i18n/ui';
const s = t(localeOf(Astro.currentLocale));

interface Props {
  index: number;
  text?: string;
  links: Array<Record<string, any>>;
}
const { index, text = '', links } = Astro.props;
---

<section id={`section${index}`} class="lk section surface-white">
  <div class="container lk-in">
    <div class="prose lk-head" data-reveal set:html={clean(text)} />
    <ul class="lk-grid">
      {
        links.map((l) => {
          const link = l.link && typeof l.link === 'object' ? l.link : null;
          if (!link) return null;
          const external = opensNewTab(link.url, link.target);
          return (
            <li data-reveal>
              <a
                class="card lk-card"
                href={link.url}
                target={linkTarget(link.url, link.target)}
                rel={linkRel(linkTarget(link.url, link.target))}
                hreflang={link.url === '/polityka-prywatnosci/' ? 'pl' : undefined}
              >
                <span class="lk-title" set:html={clean(l.title)} />
                <span class="lk-url">{link.title || link.url}</span>
                <span class="lk-arrow">
                  <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={18} />
                </span>
                {external && <span class="visually-hidden">{s('a11y.newTab')}</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .lk-in {
    display: grid;
    gap: clamp(32px, 5vw, 48px);
  }
  .lk-head {
    max-width: 640px;
  }
  /* Five links: three and two on a desktop — four across left one alone on
     its row. */
  .lk-grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @media (min-width: 600px) {
    .lk-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .lk-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .lk-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    gap: 8px 16px;
    height: 100%;
    padding: 24px;
  }
  .lk-title {
    font: 600 20px / 1.2 var(--font-sans);
    letter-spacing: -0.025em;
  }
  .lk-url {
    grid-row: 2;
    font: 400 12px / 1.4 var(--font-mono);
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .lk-arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink-900);
    color: var(--mint-500);
    transition: background-color var(--dur-fast) ease;
  }
  .lk-card:hover .lk-arrow {
    background: var(--ink-700);
  }
</style>
