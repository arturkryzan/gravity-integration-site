---
/* ACF layout: text_img (theme inc/sections/text_img.php). Also used as spacer sections. */
import { mediaSrc, mediaAlt, mediaRatio } from '../../lib/media';

interface Props {
  index: number;
  text?: string;
  img?: Record<string, any> | '' | null;
  img_placement?: string;
}
const { index, text = '', img, img_placement = '' } = Astro.props;
const image = img && typeof img === 'object' ? img : null;
const imgClass = img_placement !== 'left' ? ' offset-lg-1' : ' ms-lg-auto me-lg-auto';
const textClass = img_placement !== 'left' ? ' order-2 mt-5 mt-lg-0' : '';
---

<section id={`section${index}`} data-scroll data-scroll-repeat data-scroll-offset="100%, 0">
  <div class="container-fluid pt-10 mb-lg-5">
    <div class="row align-items-center pt-5">
      <div class={`col-lg-5 offset-lg-1${textClass}`}>
        {text && (
          <div class="paragraph" data-scroll data-scroll-opacity>
            <Fragment set:html={text} />
          </div>
        )}
      </div>

      {image && mediaSrc(image) && (
        <div class={`col-8 col-sm-6 col-lg-4 mt-10 mt-lg-0${imgClass}`}>
          <div
            class="ratio bg-gray"
            style={`--bs-aspect-ratio: ${mediaRatio(image)}`}
            data-scroll
            data-scroll-delay=".1"
            data-scroll-speed="1"
          >
            <img src={mediaSrc(image)} alt={mediaAlt(image)} loading="lazy" class="lazyload" />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
