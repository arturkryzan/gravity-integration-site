---
/* ACF layout: text_img_link (theme inc/sections/text_img_link.php).
   `overrides` lets a page replace a row's media (SVG hero / video) and add extra links,
   replicating what snippets 12/30 did on the live site. */
import { mediaSrc, mediaAlt, mediaRatio, mediaDims } from '../../lib/media';
import { linkTarget, linkRel, opensNewTab } from '../../lib/links';
import SvgHeroDevelopers from '../SvgHeroDevelopers.astro';
import SvgHeroBusiness from '../SvgHeroBusiness.astro';

interface RowOverride {
  media?: 'svg-dev' | 'svg-biz' | { video: string };
  extraLinks?: Array<{ title: string; url: string }>;
}
import { localeOf, t } from '../../i18n/ui';
const s = t(localeOf(Astro.currentLocale));

interface Props {
  index: number;
  rows: Array<Record<string, any>>;
  overrides?: Record<number, RowOverride>;
}
const { index, rows, overrides = {} } = Astro.props;
---

<section id={`section${index}`} data-scroll data-scroll-repeat class="py-10 bg-light">
  {index !== 0 && (
    <img
      src="/theme/static/linesdownload.svg"
      alt=""
      width="295"
      height="823"
      loading="lazy"
      decoding="async"
      class="download-img"
      data-scroll
      data-scroll-delay=".1"
      data-scroll-speed="-1"
    />
  )}

  {rows.map((row, i) => {
    const ov = overrides[i] ?? {};
    const link = row.link && typeof row.link === 'object' ? row.link : null;
    const img = row.img && typeof row.img === 'object' ? row.img : null;
    return (
      <div class="container-fluid py-10">
        <div class="row">
          <div
            class={`col-lg-4 offset-lg-1 pe-xl-0 order-2${i % 2 !== 0 ? ' order-lg-2' : ' order-lg-0'}`}
            data-scroll
            data-scroll-opacity
          >
            <div class="paragraph hover-underline">
              <Fragment set:html={row.text ?? ''} />
            </div>
            {link && (
              <a
                class="btn btn-arrow btn-arrow-white mt-6 me-10"
                href={link.url}
                target={linkTarget(link.url, link.target)}
                rel={linkRel(linkTarget(link.url, link.target))}
              >
                <span>{link.title} </span>
                {opensNewTab(link.url, link.target) && (
                  <span class="visually-hidden">{s('a11y.newTab')}</span>
                )}
              </a>
            )}
            {ov.extraLinks?.map((l) => (
              <a
                class="btn btn-arrow btn-arrow-white mt-6"
                href={l.url}
                target={linkTarget(l.url)}
                rel={linkRel(linkTarget(l.url))}
              >
                <span>{l.title} </span>
                {opensNewTab(l.url) && (
                  <span class="visually-hidden">{s('a11y.newTab')}</span>
                )}
              </a>
            ))}
          </div>

          <div class={`col-md-6 mb-5 mb-lg-0${i % 2 === 0 ? ' offset-lg-1' : ''}`}>
            {ov.media === 'svg-dev' ? (
              <SvgHeroDevelopers />
            ) : ov.media === 'svg-biz' ? (
              <SvgHeroBusiness />
            ) : ov.media && typeof ov.media === 'object' ? (
              <div class="ratio" style="--bs-aspect-ratio: 55.82%">
                {/* No `autoplay` attribute — deliberately. Chrome starts
                    fetching an autoplaying video as soon as it is eligible to
                    play, and that overrides `preload="none"`: measured on the
                    homepage, all four of these files downloaded in full on
                    every cold load (1.1 MB, none of it above the fold) while
                    the IntersectionObserver below never once reported them as
                    intersecting. The observer was not lazy-loading anything;
                    it was arriving after the fetch it meant to gate. Playback
                    is now started from that observer instead, which is what
                    makes `preload="none"` mean what it says. */}
                <video
                  loop
                  muted
                  playsinline
                  preload="none"
                  poster={`/video/${ov.media.video}-poster.jpg`}
                  style="width:100%;height:100%;object-fit:cover;border-radius:0.5rem;"
                >
                  <source src={`/video/${ov.media.video}.webm`} type="video/webm" />
                  <source src={`/video/${ov.media.video}.mp4`} type="video/mp4" />
                </video>
              </div>
            ) : img && mediaSrc(img) ? (
              <div class="ratio" style={` --bs-aspect-ratio: ${mediaRatio(img)}`}>
                <img src={mediaSrc(img)} alt={mediaAlt(img)} loading="lazy" class="lazyload" {...(mediaDims(img) ?? {})} />
              </div>
            ) : null}
          </div>
        </div>
      </div>
    );
  })}
</section>

<script>
  /* These videos have no `autoplay` attribute (see the markup above), so this
     script is now the only thing that ever starts them — which is the point:
     with the attribute present the browser fetched all of them at load and
     `preload="none"` did nothing. `load()` is what begins the download, so it
     must not run until the element is actually near the viewport. */
  const vids = document.querySelectorAll<HTMLVideoElement>('section video[preload="none"]');

  const start = (v: HTMLVideoElement) => {
    v.load();
    /* muted + playsinline are already on the element, so this satisfies the
       autoplay policy; a rejected promise (a user agent that blocks it anyway,
       or Save-Data) leaves the poster showing, which is a fine resting state. */
    v.play().catch(() => {});
  };

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          start(e.target as HTMLVideoElement);
          io.unobserve(e.target);
        }),
      { rootMargin: '200px' },
    );
    vids.forEach((v) => io.observe(v));
  } else {
    /* Without IntersectionObserver there is nothing to defer against, and a
       silent poster on every row would look broken. Start them all — the old
       eager behaviour, but only for the browsers that leave no alternative. */
    vids.forEach(start);
  }
</script>
