---
/* ACF layout: text_img_link — rows of copy beside a piece of media,
   alternating sides. On the home page it renders two sections:

     • the audience pair ("Pobierz, zainstaluj, integruj" / "Zastąp
       konsultantów…"), whose media are the two AudiencePanel frames;
     • the four use cases, whose media are the animated panels
       (UseCaseAnim.astro) that replaced v1's four rendered films.

   `overrides` lets a page swap a row's media and add links, replicating what
   snippets 12/30 did on the live site. */
import { mediaSrc, mediaAlt, mediaRatio, mediaDims } from '../../lib/media';
import { linkTarget, linkRel, opensNewTab } from '../../lib/links';
import { clean } from '../../lib/html';
import AudiencePanel from '../AudiencePanel.astro';
import UseCaseAnim from '../UseCaseAnim.astro';
import Icon from '../ui/Icon.astro';
import { localeOf, t } from '../../i18n/ui';

interface RowOverride {
  media?: 'svg-dev' | 'svg-biz' | { scene: 'consolidate' | 'connect' | 'partners' | 'control' };
  extraLinks?: Array<{ title: string; url: string }>;
}

interface Props {
  index: number;
  rows: Array<Record<string, any>>;
  overrides?: Record<number, RowOverride>;
  /** Number the rows (01, 02 …) with a mono label. */
  numbered?: boolean;
  surface?: 'white' | 'mist';
}
const { index, rows, overrides = {}, numbered = false, surface = 'white' } = Astro.props;
const s = t(localeOf(Astro.currentLocale));
---

<section id={`section${index}`} class:list={['til section', `surface-${surface}`]}>
  <div class="container til-rows">
    {
      rows.map((row, i) => {
        const ov = overrides[i] ?? {};
        const link = row.link && typeof row.link === 'object' ? row.link : null;
        const img = row.img && typeof row.img === 'object' ? row.img : null;
        const flip = i % 2 === 1;
        const external = link ? opensNewTab(link.url, link.target) : false;
        /* An animated panel's stop button is described by its row's heading. */
        const scene = ov.media && typeof ov.media === 'object' ? ov.media.scene : null;
        const headingId = scene ? `til-${index}-h${i}` : null;
        const text = headingId ? clean(row.text).replace(/<h2(?=[\s>])/, `<h2 id="${headingId}"`) : clean(row.text);
        return (
          <div class:list={['til-row', { 'til-row--flip': flip }]}>
            <div class="til-copy" data-reveal>
              {numbered && <span class="label-num til-num">{String(i + 1).padStart(2, '0')}</span>}
              <div class="prose til-prose" set:html={text} />
              {(link || ov.extraLinks?.length) && (
                <div class="til-actions">
                  {link && (
                    <a
                      class:list={['btn', external ? 'btn--secondary' : 'btn--primary']}
                      href={link.url}
                      target={linkTarget(link.url, link.target)}
                      rel={linkRel(linkTarget(link.url, link.target))}
                    >
                      {link.title.trim()}
                      {external ? (
                        <Icon name="arrow-up-right" size={16} />
                      ) : (
                        <Icon name="arrow-right" size={16} class="btn-arrow" />
                      )}
                      {external && <span class="visually-hidden">{s('a11y.newTab')}</span>}
                    </a>
                  )}
                  {ov.extraLinks?.map((l) => (
                    <a
                      class="btn btn--secondary"
                      href={l.url}
                      target={linkTarget(l.url)}
                      rel={linkRel(linkTarget(l.url))}
                    >
                      {l.title}
                      <Icon name="arrow-right" size={16} class="btn-arrow" />
                      {opensNewTab(l.url) && <span class="visually-hidden">{s('a11y.newTab')}</span>}
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div class="til-media">
              {ov.media === 'svg-dev' ? (
                <AudiencePanel variant="dev" />
              ) : ov.media === 'svg-biz' ? (
                <AudiencePanel variant="biz" />
              ) : scene ? (
                <UseCaseAnim scene={scene} describedBy={headingId ?? undefined} />
              ) : img && mediaSrc(img) ? (
                <div class="til-frame til-frame--img" style={`--ratio: ${mediaRatio(img)}`} data-reveal>
                  <img src={mediaSrc(img)} alt={mediaAlt(img)} loading="lazy" decoding="async" {...(mediaDims(img) ?? {})} />
                </div>
              ) : null}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .til-rows {
    display: grid;
    gap: clamp(72px, 10vw, 128px);
  }
  .til-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .til-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(48px, 6vw, 96px);
    }
    .til-row--flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .til-row--flip .til-copy {
      order: 2;
    }
  }
  @media (max-width: 899.98px) {
    .til-media {
      order: -1;
    }
  }

  .til-copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .til-num {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .til-num::after {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--mist-200);
  }
  .til-prose :global(h2) {
    font-size: var(--fs-h2);
  }
  .til-prose :global(p) {
    font-size: var(--fs-body-lg);
  }
  .til-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  /* A row whose media is an ordinary image. */
  .til-frame {
    overflow: hidden;
    border: 1px solid var(--mist-200);
    border-radius: var(--radius-xl);
    background: var(--mist-100);
  }
  .til-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
