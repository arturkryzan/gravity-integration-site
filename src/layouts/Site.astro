---
/* Full site shell: head + announcement bar + header/nav + main + footer.
   Mirrors the live WP body structure (theme head.php/header.php/footer.php). */
import '@fontsource/epilogue/400.css';
import '@fontsource/epilogue/600.css';
import '../styles/tokens.css';
import '../styles/legacy.css';
import '../styles/site.css';
import site from '../data/site.json';
import { localeOf, t, LOCALE_TAG, OG_LOCALE, DEFAULT_LOCALE } from '../i18n/ui';
import { alternates } from '../i18n/routes';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  path: string;
  /** The page's language-neutral key. Supplying it turns on hreflang and the
   *  language switcher; the 404, which belongs to no page, leaves it unset. */
  slug?: string;
  /** Scaffolded but not yet translated. Indexing one of these would put Polish
   *  prose on an English URL in Google's results. */
  draft?: boolean;
  bodyClass?: string;
  ogImage?: string;
  /** override for special pages — the 404 sets `noindex,follow` */
  robots?: string;
}
const {
  title,
  description = '',
  path,
  slug,
  draft = false,
  bodyClass = '',
  ogImage = '/og-homehero.png',
  robots = draft ? 'noindex,follow' : 'index,follow',
} = Astro.props;
const canonical = new URL(path, site.siteUrl).href;

/* hreflang. `alternates` returns nothing unless the page genuinely exists,
   published, in every locale — a draft fails its own check, so a scaffolded
   English page neither claims nor is claimed. See src/i18n/routes.ts for why a
   partial set is worse than none.

   The tags are bare language subtags, not the pl-PL / en-US regional pairs used
   for og:locale and JSON-LD. `en-US` would tell Google this page is for readers
   in the United States specifically; it is for anyone who reads English. */
const alts = slug ? await alternates(slug) : [];
const xDefault = alts.find((a) => a.lang === DEFAULT_LOCALE);

/* `Astro.currentLocale` reads the locale off the URL — /en/… is English, every
   other path is the unprefixed default. Nothing needs a `lang` prop threaded
   down to it, and the 404 (which belongs to no locale) falls back to Polish. */
const lang = localeOf(Astro.currentLocale);
const s = t(lang);
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {
      alts.map((a) => (
        <link rel="alternate" hreflang={a.lang} href={new URL(a.url, site.siteUrl).href} />
      ))
    }
    {
      xDefault && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(xDefault.url, site.siteUrl).href}
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.siteUrl).href} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />

    {/* The body font is declared inside legacy.css, so the browser cannot even
        learn it exists until that sheet has been fetched and parsed — and on
        five routes the measured LCP element is text set in it. Preloading the
        one face that every page uses moves the request to the start of the
        waterfall instead of the end of it. Only the Regular is preloaded:
        UltraLight is used by exactly one element (the homepage h1), and
        preloading a font 17 routes do not paint would trade one problem for a
        smaller copy of itself. `crossorigin` is required even same-origin —
        fonts are fetched in CORS mode, and a preload without it downloads the
        file twice. */}
    <link
      rel="preload"
      href="/fonts/Telegraf-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicons/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon-152x152.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.company.name,
        url: site.siteUrl,
        logo: new URL('/favicons/favicon-196x196.png', site.siteUrl).href,
        sameAs: [site.linkedin],
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        description,
        url: canonical,
        inLanguage: LOCALE_TAG[lang],
        isPartOf: { '@type': 'WebSite', name: site.siteName, url: site.siteUrl },
      })}
    />

    <!-- GA4 + Google Ads — the same two properties the WP site ran
         (G-EWVWPJGYVM from Code Snippets, AW-11029031415 from the Head & Footer
         plugin), but consent-gated instead of unconditional.

         The tag is deliberately NOT a <script src> here: until someone accepts,
         no request to googletagmanager.com is made at all. CookieConsent.astro
         calls giEnableAnalytics() on accept; on a return visit the stored
         `gi_consent=granted` cookie calls it below, before first paint, so
         nothing is lost for people who already said yes.

         One library, two configs. gtag.js is fetched once with the GA4 id and
         both properties are then `config`-ed against it — that is how Google
         intends multiple ids to share a page, and it keeps the "exactly one
         network request after consent" property the harness asserts.

         The function names stay analytics-flavoured because the choice they
         serve is still binary: one bar, one answer, both tags. Splitting them
         would imply a granularity the UI doesn't offer. -->
    <script
      is:inline
      define:vars={{
        ga4: site.ga4,
        ads: site.googleAds,
        adsDl: site.adsDownloadConversion,
        pageLang: lang,
      }}
    >
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      /* Read by the form handlers so `generate_lead` can be addressed at the
         GA4 property explicitly rather than fanning out to every configured id. */
      window.giGa4Id = ga4;
      /* The Google Ads conversion action for the gated software download —
         a full `send_to` value, "AW-11029031415/<label>", pasted verbatim from
         Ads → Goals → Conversions into site.json. Empty until that action
         exists, and the download handler no-ops on empty rather than firing an
         unlabelled conversion at the whole Ads account. */
      window.giAdsDownloadTo = adsDl || '';

      /* Which language the visitor is actually reading, as opposed to the
         `language` GA4 collects on its own — that one is the browser's setting,
         which says nothing about whether someone landed on /en/ or /. Set
         before any config so it rides along with every event, page_view
         included. To use it as a breakdown you register a custom dimension in
         GA4 Admin → Custom definitions with the event parameter `page_language`;
         nothing here needs to change when you do. */
      gtag('set', { page_language: pageLang });

      /* Consent Mode v2 defaults. These must be queued before the tag loads —
         belt and braces behind the fact that we don't load it at all yet. */
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
      });

      var giGaLoaded = false;
      window.giEnableAnalytics = function () {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
        if (giGaLoaded) return;
        giGaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', ga4, { anonymize_ip: true });
        if (ads) gtag('config', ads);
      };

      window.giDisableAnalytics = function () {
        gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
        /* Consent Mode stops new writes; it doesn't clear what a previous
           "accept" already stored. Withdrawal that leaves `_ga` or `_gcl` on the
           device isn't withdrawal — `_gcl*` is the Ads click-id family, so it
           goes the same way as the analytics pair. */
        document.cookie.split(';').forEach(function (c) {
          var name = c.split('=')[0].trim();
          if (name.indexOf('_ga') !== 0 && name.indexOf('_gcl') !== 0) return;
          var host = location.hostname;
          document.cookie = name + '=;path=/;max-age=0';
          document.cookie = name + '=;path=/;domain=' + host + ';max-age=0';
          document.cookie = name + '=;path=/;domain=.' + host + ';max-age=0';
        });
      };

      if (/(?:^|;\s*)gi_consent=granted/.test(document.cookie)) window.giEnableAnalytics();
    </script>

    <!-- MailerLite Universal — the pop-up only, and only in Polish.

         The four forms on this site post to MailerLite over plain HTTPS from
         our own handler (src/scripts/ml-forms.ts); not one of them needs this
         tag. What needs it is the pop-up configured in account 1115638: ten
         seconds' delay, re-shown after a day, scoped inside MailerLite to
         gravity-integration.com and docs.gravity-integration.com. That scoping
         is by hostname, so it matches /en/ as well — which is why the language
         gate has to be here rather than there. The pop-up's copy is Polish, and
         an English visitor gets no pop-up rather than one they can't read.

         It loads on consent for the same reason gtag does. universal.js is a
         third party that stores state on the device, and the bar at the bottom
         of this document promises nothing of that kind runs before an answer.
         A banner that is untrue about one tag is worth less on all of them.
         The cost is real and was accepted: whoever picks "Tylko niezbędne"
         never sees the pop-up.

         Same shape as the analytics loader above — a named enable function, an
         idempotence flag, and a return-visit check that fires before paint. The
         script is emitted on every page and does nothing on the English ones;
         `mlEnabled` is what decides, because a conditional element here would
         have to survive JSX parsing of a body full of braces. -->
    <script
      is:inline
      define:vars={{
        mlAccount: site.mailerliteAccount,
        mlEnabled: lang === DEFAULT_LOCALE && Boolean(site.mailerliteAccount),
      }}
    >
      var giMlLoaded = false;

      window.giEnableMailerLite = function () {
        if (!mlEnabled || giMlLoaded) return;
        giMlLoaded = true;
        /* MailerLite's own snippet, unchanged apart from the account id, which
           comes from site.json. Their loader queues calls on window.ml before
           the script lands, so 'account' can be set in the same breath. */
        (function (w, d, e, u, f, l, n) {
          w[f] =
            w[f] ||
            function () {
              (w[f].q = w[f].q || []).push(arguments);
            };
          l = d.createElement(e);
          l.async = 1;
          l.src = u;
          n = d.getElementsByTagName(e)[0];
          n.parentNode.insertBefore(l, n);
        })(window, document, 'script', 'https://assets.mailerlite.com/js/universal.js', 'ml');
        window.ml('account', mlAccount);
      };

      /* A script that has loaded cannot be unloaded, so withdrawal does what it
         can: clear what MailerLite stored, so the next visit starts clean and
         the pop-up's "not for another day" memory doesn't outlive the consent
         that allowed it. The same bargain giDisableAnalytics strikes. */
      window.giDisableMailerLite = function () {
        document.cookie.split(';').forEach(function (c) {
          var name = c.split('=')[0].trim();
          if (name.indexOf('ml_') !== 0) return;
          var host = location.hostname;
          document.cookie = name + '=;path=/;max-age=0';
          document.cookie = name + '=;path=/;domain=' + host + ';max-age=0';
          document.cookie = name + '=;path=/;domain=.' + host + ';max-age=0';
        });
        try {
          Object.keys(window.localStorage).forEach(function (k) {
            if (/^ml[_-]|^mailerlite/i.test(k)) window.localStorage.removeItem(k);
          });
        } catch (e) {
          /* storage is unavailable in some private modes; nothing to clear */
        }
      };

      if (/(?:^|;\s*)gi_consent=granted/.test(document.cookie)) window.giEnableMailerLite();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {/* Before the announcement bar, not after it: the skip link only helps if
        it is the FIRST thing Tab reaches, and the bar carries a link of its
        own. Everything between here and <main> is one dismissible bar, the
        logo, the menu button and — once opened — a ten-item nav. */}
    <a class="skip-link" href="#main">{s('nav.skipToContent')}</a>
    {/* `tabindex="-1"` on the target is supposed to be enough — the UA is meant
        to focus a focusable fragment target. Measured here, it is not: the hash
        updates and the page scrolls, but document.activeElement stays on the
        link, so the very next Tab walks back into the nav the reader just asked
        to skip. Safari has never done it at all. So move focus explicitly
        rather than trusting the UA. Inline and tiny so it is live before the
        first Tab can happen; without JS the anchor still scrolls, which is the
        pre-existing behaviour, not a regression. */}
    <script is:inline>
      document.querySelector('.skip-link')?.addEventListener('click', function () {
        var m = document.getElementById('main');
        if (m) requestAnimationFrame(function () { m.focus(); });
      });
    </script>
    <AnnouncementBar />
    <div class="page-container">
      <Header slug={slug} />
      {/* tabindex="-1" makes <main> a legal focus target for the skip link;
          the script above is what actually moves the caret to it. */}
      <main id="main" tabindex="-1" data-scroll-section>
        <slot />
      </main>
      <Footer slug={slug} />
    </div>
    <CookieConsent />
    <script src="../scripts/main.js"></script>
  </body>
</html>
