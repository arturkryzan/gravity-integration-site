---
/* 404 — served by Apache via `ErrorDocument 404 /404.html` (see public/.htaccess).
   Astro's static build emits this page as dist/404.html automatically.
   noindex: the page returns a real 404 status at the server level, but the
   meta keeps any mirror/proxy serving it with a 200 out of the index too.

   The body lives in NotFound.astro, shared with the English 404 at
   src/pages/en/404.astro. */
import Site from '../layouts/Site.astro';
import NotFound from '../components/NotFound.astro';
import { localeOf, t } from '../i18n/ui';
const s = t(localeOf(Astro.currentLocale));
---

<Site
  title={s('nf.title')}
  description={s('nf.desc')}
  path="/404.html"
  bodyClass="page page-404"
  heroTone="white"
  robots="noindex,follow"
>
  <NotFound />
</Site>
