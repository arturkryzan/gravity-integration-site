---
/* Polish pages with no route of their own: technologia, cennik, kontakt,
   polityka-prywatnosci. `pagesIn('pl')` is what keeps English content out of
   the unprefixed tree — /en/[...slug]/ is its exact mirror. */
import { pagesIn, OWN_ROUTE, pathParam } from '../../i18n/routes';
import Generic from '../../components/pages/Generic.astro';

export async function getStaticPaths() {
  const pages = await pagesIn('pl');
  return pages
    .filter((p) => !OWN_ROUTE.has(p.data.slug))
    .map((p) => ({
      params: { slug: pathParam(p.data.url, 'pl') },
      props: { page: p.data },
    }));
}
const { page } = Astro.props;
---

<Generic page={page} />
