---
/* Dedicated route for /case-studies/.
   The generic [...slug] route renders this page's ACF payload through
   TextImgLink, which was the WordPress theme's only option: a 33%-wide text
   column zigzagging left/right beside a half-empty image column. The copy is
   unchanged — it is parsed out of the same JSON and laid out properly. */
import { getPage } from '../../i18n/routes';
import { localeOf } from '../../i18n/ui';
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseStudies from '../../components/CaseStudies.astro';
import Newsletter from '../../components/Newsletter.astro';
import DemoSection from '../../components/DemoSection.astro';
import heroes from '../../data/page_heroes.json';
import { parseCaseStudies } from '../../lib/case-studies';

const lang = localeOf(Astro.currentLocale);
const entry = await getPage('case-studies', lang);
const page = entry.data;
const hero = (heroes as Record<string, any>)['case-studies'] ?? {};
const studies = parseCaseStudies(page.sections as any[]);
const crumbs = studies
  .map((s) => ({ label: s.nav, anchor: s.anchor }))
  .filter((c) => c.label);
---

<Site
  title={page.seo.title}
  description={page.seo.description}
  path={page.url}
  bodyClass={`page page-id-${page.wpId}`}
>
  <PageHero h1={page.h1} img={hero.local} alt={hero.alt} circle={hero.circle} />
  <Breadcrumbs items={crumbs} />
  <CaseStudies studies={studies} />
  {page.newsletter && <Newsletter />}
  <DemoSection />
</Site>
